/* INSERT REGULAR PRICE LEVEL 2 IF NOT PROVIDED */
INSERT INTO M@WIZGET(SOURCE)@WIZGET(BATCH) (F126,F902,F1964,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),PRICE_TAB,,,,'F126,F902,F1964'))
SELECT 2 AS F126,'@WIZGET(BATCH)' AS F902,BAT.F1964,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),PRICE_TAB,LVL.,,,'F126,F902,F1964')
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT JOIN
PRICE_TAB LVL ON BAT.F01=LVL.F01 AND BAT.F126=1 AND LVL.F126=2
WHERE BAT.F01 NOT IN (SELECT F01 FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F126=2);

/* COPY NEW REGULAR PRICE FROM LEVEL 1 */
UPDATE BAT SET BAT.F30=LVL.F30,BAT.F31=LVL.F31
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT JOIN 
M@WIZGET(SOURCE)@WIZGET(BATCH) LVL ON BAT.F01=LVL.F01 AND BAT.F126=2 AND LVL.F126=1;


@FMT(CMP,@DBCOL('FIELDS=F1964',M@WIZGET(SOURCE)@WIZGET(BATCH))=F1964,,'®FMT(CHR,27)');

/* DEPLOY IS COMING FROM LOAD.SQM */

@FMT(CMP,@WIZGET(DEPLOY)=LOAD,®WIZRPL(TLOAD=1),®WIZRPL(TLOAD=0));

/* DELETE CHANGES WHEN YOU ARE THE OWNER */

@FMT(CMP,0@TER>@WIZGET(TLOAD)899,"DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1964='@STORE';");

/* TAKE OWNER SHIP */

@FMT(CMP,@DBHOT(INI,HOST_STORE.INI,PRICE_CHG,TAKEOWNERSHIP)=1,"UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1964='@STORE'");

