@FMT(CMP,@WIZGET(CALCULATE_TABLE)=,'®EXEC(SQI=USERB_FSPRICE_BAT)');

@WIZSET(SUBQUERY=SELECT DISTINCT F01 FROM FSPRICE_BAT WHERE F902='@WIZGET(BATCH)');
@WIZSET(CALCULATE_TABLE=PRICE_TAB);

/* APPLY LATEST PRICE CHANGES */
UPDATE BAT SET
BAT.F136=CASE 
	WHEN (BAT.F139/BAT.F136) % 1 =0 THEN PRI.F30 
	WHEN (ISNULL(BAT.F1220,0)>0 OR ISNULL(BAT.F1221,0)>0) THEN PRI.F30
	ELSE BAT.F136 END,
BAT.F139=CASE
	WHEN (BAT.F139/BAT.F136) % 1 =0 THEN (BAT.F139/BAT.F136) * PRI.F30 
	ELSE BAT.F139 END
FROM FSPRICE_BAT BAT
JOIN PRICE_TAB PRI ON BAT.F01=PRI.F01 AND BAT.F1000=PRI.F1000
WHERE PRI.F30 IS NOT NULL
AND PRI.F126=1
AND (ISNULL(BAT.F1220,0)>0 OR ISNULL(BAT.F1221,0)>0 OR ISNULL(BAT.F139,0)>0 OR ISNULL(BAT.F136,0)>0)
AND ISNULL(BAT.F136,0)<>PRI.F30
AND BAT.F902='@WIZGET(BATCH)'
AND BAT.F01 IN (@WIZGET(SUBQUERY));

/* APPLY BATCH */

@UPDATE_BATCH(JOB=ADDRPL,TAR=@WIZGET(CALCULATE_TABLE),
KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT @FMT(CMP,'@dbHot(INI,HOST_STORE.INI,FSPRICE_BAT,EXECUTE_INCLUDE)=',"®dbFld(FSPRICE_BAT,,'@dbHot(INI,HOST_STORE.INI,FSPRICE_BAT,EXECUTE_EXCLUDE)')","®dbHot(INI,HOST_STORE.INI,FSPRICE_BAT,EXECUTE_INCLUDE)") 
@FMT(CMP,'@DBHOT(INI,HOST_STORE.INI,FSPRICE_BAT,TAKEOWNERSHIP)=1',",'@STORE' AS F1964")
FROM FSPRICE_BAT WHERE 
F902='@WIZGET(BATCH)' 
@FMT(CMP,'@WIZGET(ACTIVATE.STORE)<>',"AND F1000='@WIZGET(ACTIVATE.STORE)'")
@FMT(CMP,@DBHOT(INI,HOST_STORE.INI,FSPRICE_BAT,ACTIVATEOWNEDONLY)=1,'AND F01 IN (SELECT PRI.F01 FROM PRICE_TAB PRI JOIN FSPRICE_BAT BAT ON PRI.F01=BAT.F01 AND PRI.F1000=BAT.F1000 AND PRI.F126=BAT.F126 WHERE BAT.F902='@WIZGET(BATCH)' AND PRI.F1964='@STORE')') 
AND F01 IN (@WIZGET(SUBQUERY)));

@TOOLS(CALCNEXT,SELECT * FROM @WIZGET(CALCULATE_TABLE) WHERE F902='@WIZGET(BATCH)' @FMT(CMP,'@WIZGET(ACTIVATE.STORE)<>',"AND F1000='@WIZGET(ACTIVATE.STORE)'"));
@FMT(CMP,@WIZGET(CALCULATE_TABLE)<>PRICE_TAB,'®FMT(CHR,27)');
@WIZCLR(CALCULATE_TABLE);

/* COPY PRICE REGULAR PRICE FROM LEVEL1 AND ITEM LINK*/

UPDATE PRI SET PRI.F1001=1,PRI.F30=LVL.F30,PRI.F31=LVL.F31,PRI.F164=LVL.F164
FROM PRICE_TAB PRI JOIN 
PRICE_TAB LVL ON PRI.F01=LVL.F01 AND PRI.F126=2 AND LVL.F126=1 AND PRI.F01 IN (SELECT F01 FROM FSPRICE_BAT WHERE F902='@WIZGET(BATCH)');

/* ARCHIVE */
@WIZSET(SAVE_OLD=@dbHot(INI,HOST_STORE.INI,FSPRICE_BAT,SAVE_OLD));

@UPDATE_BATCH(JOB=ADDRPL,TAR=HEADER_OLD,KEY=F902=:F902,
SRC=SELECT * FROM @WIZGET(HEADER) WHERE 
'@WIZGET(SAVE_OLD)'='1' AND 
F902='@WIZGET(BATCH)');

UPDATE HEADER_OLD SET F916='OSPRICE_BAT' WHERE F902='@WIZGET(BATCH)';

@UPDATE_BATCH(JOB=ADDRPL,TAR=OSPRICE_BAT,
KEY=F902=:F902 AND F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT * FROM FSPRICE_BAT WHERE 
'@WIZGET(SAVE_OLD)'='1' AND 
@FMT(CMP,'@WIZGET(ACTIVATE.STORE)<>',"F1000='@WIZGET(ACTIVATE.STORE)' AND")
F902='@WIZGET(BATCH)' AND F01 IN (@WIZGET(SUBQUERY)));

@EXEC(SQI=USERE_FSPRICE_BAT);

/* DELETE FUTURE BATCH */

DELETE FROM FSPRICE_BAT WHERE F902='@WIZGET(BATCH)' AND @FMT(CMP,'@WIZGET(ACTIVATE.STORE)<>',"F1000='@WIZGET(ACTIVATE.STORE)' AND") F01 IN (@WIZGET(SUBQUERY));

@FMT(CMP,@DBSELECT(SELECT SUM(BAT.F1301) AS F1301 FROM (SELECT COUNT(F01) AS F1301 FROM FOBJ_BAT WHERE F902='@WIZGET(BATCH)' UNION 
SELECT COUNT(F01) AS F1301 FROM FPOS_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FPRICE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FGPRICE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FSPRICE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FTPRICE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FINSTORE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FREDEEM_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FCOST_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM ALLOW_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM REBATE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FDISC_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FCSTBRK_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FGCOST_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FBBACK_BAT WHERE F902='@WIZGET(BATCH)' UNION 
SELECT COUNT(F01) AS F1301 FROM FECL_BAT WHERE F902='@WIZGET(BATCH)' UNION 
SELECT COUNT(F01) AS F1301 FROM FPID_BAT WHERE F902='@WIZGET(BATCH)') BAT 
)=0,"DELETE FROM @WIZGET(HEADER) WHERE F902='@WIZGET(BATCH)'","UPDATE @WIZGET(HEADER) SET F914='CLOSE' WHERE F902='@WIZGET(BATCH)'");

