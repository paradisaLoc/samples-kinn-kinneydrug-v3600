/* SAVE ALL PARAMETERS */
@DBHOT(HOT_WIZ,PARAMTOLINE,PARAMSAV);

/**** INVENTORY NOT EXISTING AT THE STORE, INITIALIZE THESE ITEMS *****/

@WIZRPL(INV_SUBQUERY=SELECT DISTINCT BAT.F01 FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT WHERE BAT.F01 NOT IN (SELECT DISTINCT F01 FROM RPT_ITM_N WHERE F1034=8501));
@WIZCLR(DATE);

@WIZRPL(FILE=XF@DBHOT(REDIRMAIL)\D@FMT(R4,@DBGEN(F1059,1))@STORE.@TER);
@EXEC(SQM=RPT_ITM_INV_START);
@EXEC(sql=@WIZGET(FILE));

@WIZRESET; 
@DBHOT(HOT_WIZ,LINETOPARAM,PARAMSAV);

/* UPDATE LAST COST */

@UPDATE_BATCH(JOB=CHANGE,TAR=RPT_ITM_N,KEY=F01=:F01 AND F1034=:F1034,
SRC=SELECT F01,8501 AS F1034,F1301 FROM M@WIZGET(SOURCE)@WIZGET(BATCH));

DROP TABLE M@WIZGET(SOURCE)@WIZGET(BATCH);
DELETE FROM @WIZGET(HEADER) WHERE F902='@WIZGET(BATCH)' AND F903='@WIZGET(SOURCE)';

/* RESTORE INITITAL PARAMETER POOL */
@WIZRESET; 
@DBHOT(HOT_WIZ,LINETOPARAM,PARAMSAV);
@DBHOT(HOT_WIZ,CLR,PARAMSAV);

