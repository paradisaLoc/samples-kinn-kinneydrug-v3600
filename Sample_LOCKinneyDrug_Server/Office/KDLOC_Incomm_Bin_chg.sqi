@UPDATE_BATCH(JOB=@WIZGET(ACTION),TAR=KDLOC_INCOMM_BIN,KEY=F1401=:F1401 AND F01=:F01 AND F1000=:F1000,
SRC=SELECT * FROM M@WIZGET(SOURCE)@WIZGET(BATCH));

DROP TABLE M@WIZGET(SOURCE)@WIZGET(BATCH);

DELETE FROM @WIZGET(HEADER) WHERE F902 = '@WIZGET(BATCH)' AND F903 = '@WIZGET(SOURCE)';

/* Deploy to lanes. */
@FMT(CMP,@TER>899,®WIZSET(TARGET=PAL)®EXEC(SQM=KDLOC_INCOMM_BIN_LOAD));