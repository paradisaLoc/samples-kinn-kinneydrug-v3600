@WIZRESET;
@WIZRPL(DIR_NAME=@DBHOT(INI,KINNEYDRUG.INI,INCOMMBIN,LINKSDIR));
@WIZSET(FILE_NAME=IncommBin.csv);

/* Exit if nothing found to import */
@FMT(CMP,@DBHOT(FINDFIRST,@WIZGET(DIR_NAME)@WIZGET(FILE_NAME))=,"®EXEC(MSG='No files found to import!')®WIZCLR(MSG)®FMT(CHR,27)");

/* Convert Files */
@WIZRPL(SAVE_DIR=@WIZGET(DIR_NAME)Archive\);
@WIZRPL(SAVE_DIR_PURGE=@DBHOT(INI,KINNEYDRUG.INI,INCOMMBIN,SAVE_DIR_PURGE));
@WIZSET(FIELD=COMA);
@WIZSET(SAVE_EXT=.@DIDF@TIME);
@WIZRPL(FILE_TYPE=IMPORT);
@WIZSET(MAP_FILE=XCH_KinneyDrugs_Incomm_Bin.SQM);
@WIZSET(DEL_FILE=1);
@WIZRPL(FILE_TYPE2=ASCII);
@WIZRPL(TARGET=941);
@EXEC(XCH=RECV);
