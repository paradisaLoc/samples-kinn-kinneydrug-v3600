@DBHOT(REC_TTL);

@FMT(CMP,@dbHot('setup.ini',[REPORT]Printer)<>,"®WIZRPL(reportPrinter=REPORT)");
@FMT(CMP,@WIZGET(reportPrinter)=,"®WIZRPL(reportPrint=@DBHOT(REG,@PROFILE\mFloor_BuyConfig\ReportPrinter))");
@FMT(CMP,@WIZGET(reportPrinter)=,"®WIZRPL(reportPrint=DEFAULT)");
@WIZRPL(PRINT_OUTPUT=@WIZGET(reportPrinter));

@WIZRPL(OUTPUT_SAVE=@WIZGET(OUTPUT));
@FMT(CMP,@WIZGET(PRINT_OUTPUT)<>,"®WIZRPL(OUTPUT=@wizget(reportPrinter))");
@FMT(CMP,@WIZGET(OUTPUT)=,"®WIZRPL(OUTPUT=PRN)");
@WIZRPL(SQR=@WIZGET(PRINT_SQR));
@FMT(CMP,@WIZGET(SQR)=,"®WIZRPL(SQR=KDLOC_BACK_ROOM_STOCK)");
@EXEC();
@WIZRPL(SQR=@WIZGET(PRINT_SQR));
@FMT(CMP,@WIZGET(SQR)=,"®WIZRPL(SQR=KDLOC_BACK_ROOM_STOCK)");
@EXEC();

@WIZRPL(OUTPUT=@WIZGET(OUTPUT_SAVE));

@EXEC(FCT=3180,CONFIRM_CLOSE=1,OUTPUT=@WIZGET(OUTPUT_SAVE));

