@RPTCLR(T1);
@WIZRPL(PRICE_TABLE=@FMT(CMP,@WIZGET(PDA)=1,PRICE_TAB,LABEL_TAB));
@WIZRPL(OBJ_TABLE=@FMT(CMP,@WIZGET(PDA)=1,OBJ_TAB,LABEL_TAB));

@FMT(CMP,@dbHot(@WIZGET(OBJ_TABLE),F22,Z#)=,'®WIZRPL(TMP_F22=1)','®WIZRPL(TMP_F22=@dbHot(@WIZGET(OBJ_TABLE),F22,Z#))');
@FMT(CMP,@dbHot(@WIZGET(OBJ_TABLE),F21,Z#)=,'®WIZRPL(TMP_F21=1)','®WIZRPL(TMP_F21=@dbHot(@WIZGET(OBJ_TABLE),F21,Z#))');
@FMT(CMP,@dbHot(@WIZGET(PRICE_TABLE),F31,Z#)=,'®WIZRPL(TMP_F31=1)','®WIZRPL(TMP_F31=@dbHot(@WIZGET(PRICE_TABLE),F31,Z#))');

@WIZRPL(TMP_F30=@RPTTTL(@dbHot(@WIZGET(PRICE_TABLE),F30,#)/@WIZGET(TMP_F31),#));
@WIZRPL(TMP_F30=@RPTTTL(@WIZGET(TMP_F30)*100,#:3,));

@WIZRPL(F1806=EACH);
@RPTTTL(@WIZGET(TMP_F30),,=T1);

@FMT(CMP,@dbHot(OBJ_TAB,F23)=CT,'®RPTTTL(@WIZGET(TMP_F30)*100/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=100CT)');

@FMT(CMP,@dbHot(OBJ_TAB,F23)=EA,'®RPTTTL(@WIZGET(TMP_F30)/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=EACH)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=FL,'®RPTTTL(@WIZGET(TMP_F30)/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=FO)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=FT,'®RPTTTL(@WIZGET(TMP_F30)/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=FOOT)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=LB,'®RPTTTL(@WIZGET(TMP_F30)/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=POUND)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=OO,'®RPTTTL(@WIZGET(TMP_F30)/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=OUNCE)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=QT,'®RPTTTL(@WIZGET(TMP_F30)/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=QUART)');

@FMT(CMP,@dbHot(OBJ_TAB,F23)=FO,'®RPTTTL(@WIZGET(TMP_F30)*32/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=QUART)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=GA,'®RPTTTL(@WIZGET(TMP_F30)*0.25/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=QUART)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=IN,'®RPTTTL(@WIZGET(TMP_F30)*12/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=FOOT)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=OZ,'®RPTTTL(@WIZGET(TMP_F30)*16/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=POUND)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=PT,'®RPTTTL(@WIZGET(TMP_F30)*2/@WIZGET(TMP_F22),,=T1)®WIZRPL(F1806=QUART)');

@FMT(CMP,@dbHot(OBJ_TAB,F23)=SF,'®RPTTTL(@WIZGET(TMP_F30)*50/@RPTTTL(@WIZGET(TMP_F22),#),,=T1)®WIZRPL(F1806=50SQ.FT.)');
@FMT(CMP,@dbHot(OBJ_TAB,F23)=YD,'®RPTTTL(@WIZGET(TMP_F30)/@RPTTTL(@WIZGET(TMP_F22)*3,#),,=T1)®WIZRPL(F1806=FOOT)');

@WIZRPL(PRICE=@RPTTTL(T1/100,$:2));
@WIZRPL(F1806=PER @WIZGET(F1806));