/* TRIGGER TO UPDATE THE LABEL TRIGGER FIELD */
/*v@WIZRPL(LABEL_FLD=@DBFLD(LABEL_TAB,,'F902,@DBHOT(INI,APPLICATION.INI,LABEL,EXCLUDE_LABEL_TRIGGER)'),@DBHOT(INI,APPLICATION.INI,LABEL,INCLUDE_LABEL_TRIGGER));*/
@WIZRPL(CREATE_TRIGGER_TABLE=OBJ_TAB,POS_TAB,ALT_TAB);
/****** POS ******/
@FMT(CMP,@FMT(POS,POS_TAB,'@WIZGET(CREATE_TRIGGER_TABLE)')=0,,"
IF OBJECT_ID('TRIG_POS_F2119') IS NOT NULL
 DROP TRIGGER TRIG_POS_F2119
DECLARE @FLD VARCHAR(1000)
DECLARE @PARAM VARCHAR(8000)
DECLARE @S1 VARCHAR(1000)
SET @FLD='@DBCOL(POS_TAB,'PARAM=LABEL_FLD'),'
SET @PARAM=''
SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1)
SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000)
WHILE @S1<>''
BEGIN
  IF (@PARAM='') SET @PARAM='UPDATE('+@S1+')'   
  ELSE SET @PARAM=@PARAM+' OR UPDATE('+@S1+')'
  IF LEN(@FLD)>2 
   BEGIN
     SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1) 
     SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000) 
   END
  ELSE SET @S1=''   
END
IF (@PARAM='') RETURN 
EXEC('CREATE TRIGGER TRIG_POS_F2119 '+
'ON POS_TAB '+
'AFTER UPDATE,INSERT AS '+
'IF('+@PARAM+')'+
' BEGIN '+
'  UPDATE POS SET F2119=CASE WHEN del.F01 IS NULL THEN 3 ELSE 1 END'+
'   FROM POS_TAB POS JOIN inserted ins ON POS.F01=ins.F01 AND POS.F1000=ins.F1000 '+
'   LEFT JOIN deleted del ON POS.F01=del.F01 AND POS.F1000=del.F1000 '+
'   WHERE (@DBCOL('FIELDS=@DBCOL(POS_TAB,'PARAM=LABEL_FLD')',POS_TAB,POS.,<>OR,del.))'+
'   AND ISNULL(POS.F2119,0)=0 '+
' END ');");
/****** OBJ ******/
@FMT(CMP,@FMT(POS,OBJ_TAB,'@WIZGET(CREATE_TRIGGER_TABLE)')=0,,"
IF OBJECT_ID('TRIG_OBJ_F2119') IS NOT NULL
 DROP TRIGGER TRIG_OBJ_F2119
DECLARE @FLD VARCHAR(1000)
DECLARE @PARAM VARCHAR(8000)
DECLARE @S1 VARCHAR(1000)
SET @FLD='@DBCOL(OBJ_TAB,'PARAM=LABEL_FLD'),'
SET @PARAM=''
SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1)
SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000)
WHILE @S1<>''
BEGIN
  IF (@PARAM='') SET @PARAM='UPDATE('+@S1+')'   
  ELSE SET @PARAM=@PARAM+' OR UPDATE('+@S1+')'
  IF LEN(@FLD)>2 
   BEGIN
     SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1) 
     SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000) 
   END
  ELSE SET @S1=''   
END
IF (@PARAM='') RETURN
EXEC('CREATE TRIGGER TRIG_OBJ_F2119 '+
'ON OBJ_TAB '+
'AFTER UPDATE AS '+
'IF('+@PARAM+')'+
' BEGIN '+
'  UPDATE OBJ SET F2119=1 '+
'   FROM OBJ_TAB OBJ JOIN inserted ins ON OBJ.F01=ins.F01 '+
'   LEFT JOIN deleted del ON OBJ.F01=del.F01 '+
'   WHERE (@DBCOL('FIELDS=@DBCOL(OBJ_TAB,'PARAM=LABEL_FLD')',OBJ_TAB,OBJ.,<>OR,del.))'+
'   AND ISNULL(OBJ.F2119,0)=0 '+
' END ');");
/****** ALT ******/
@FMT(CMP,@FMT(POS,ALT_TAB,'@WIZGET(CREATE_TRIGGER_TABLE)')=0,,"
IF OBJECT_ID('TRIG_ALT_F2119') IS NOT NULL
 DROP TRIGGER TRIG_ALT_F2119
DECLARE @FLD VARCHAR(1000)
DECLARE @PARAM VARCHAR(8000)
DECLARE @S1 VARCHAR(1000)
SET @FLD='@DBCOL(ALT_TAB,'PARAM=LABEL_FLD'),'
SET @PARAM=''
SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1)
SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000)
WHILE @S1<>''
BEGIN
  IF (@PARAM='') SET @PARAM='UPDATE('+@S1+')'   
  ELSE SET @PARAM=@PARAM+' OR UPDATE('+@S1+')'
  IF LEN(@FLD)>2 
   BEGIN
     SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1) 
     SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000) 
   END
  ELSE SET @S1=''   
END
IF (@PARAM='') RETURN 
EXEC('CREATE TRIGGER TRIG_ALT_F2119 '+
'ON ALT_TAB '+
'AFTER UPDATE,INSERT AS '+
'IF('+@PARAM+')'+
' BEGIN '+
'  UPDATE POS SET F2119=1 '+
'   FROM inserted ins '+
'   LEFT JOIN deleted del ON ins.F01=del.F01 AND ins.F1000=del.F1000 AND ins.F154=del.F154'+
'   JOIN POS_TAB POS ON POS.F01=ins.F01 AND POS.F1000=ins.F1000 '+
'   WHERE (@DBCOL('FIELDS=@DBCOL(ALT_TAB,'PARAM=LABEL_FLD')',ALT_TAB,ins.,<>OR,del.))'+
'   AND ISNULL(POS.F2119,0)=0 AND ISNULL(ins.F1898,1)=1'+
' END ');");
@WIZCLR(CREATE_TRIGGER_TABLE);

