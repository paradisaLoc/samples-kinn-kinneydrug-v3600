@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=KDLOC_BACK_ROOM_STOCK);
@EXEC(INI=system[SMS]);

@WIZSET(F1032=@dbHot(REC_HDR,F1032,#));

@RPT_QUERY
SELECT REG.F01, SUM(F1003) as F1003, MAX(F29) AS F29
FROM REC_REG REG LEFT OUTER JOIN OBJ_TAB OBJ ON OBJ.F01=REG.F01
WHERE F1032=@WIZGET(F1032) AND REG.F1067='ITEM'
GROUP BY REG.F01
ORDER BY F29;

UPDATE REC_HDR SET F1688=@USER WHERE F1032=@WIZGET(F1032);
