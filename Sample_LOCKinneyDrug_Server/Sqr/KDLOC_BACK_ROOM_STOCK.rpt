<?xml version="1.0" encoding="iso-8859-1"?>
<html>

  <head>
    <desc>
      <input type="hidden" class="HidParam" id="RPT_NAME" value="Back Room Stock Report" /> <input type="hidden" class="HidParam" id="RPT_FILENAME" value="KDLOC_BACK_ROOM_STOCK" /> <input type="hidden" class="HidParam" id="RPT_PARENT" value="rpt_trs_rec" /> <input type="hidden" class="HidParam" id="RPT_PRIORITY" value="10" /> <input type="hidden" class="HidParam" id="RPT_DESC" value="Receiving document. CRITERIA: Receiving document number reveived from PDA." /> <input type="hidden" class="HidParam" id="RPT_GROUP" value="5.Receiving" /> <input type="hidden" class="HidParam" id="RPT_WIZARD" value="yes" />
    </desc>
    <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
    <meta name="CurHdr" content="ScreenRpt" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="PRAGMA" content="No_Cache" />
    <link rel="stylesheet" href="../../Images/sms_form.css" type="text/css" />
    <link rel="stylesheet" href="../../Images/sms_rpt.css" type="text/css" />
<script type="text/javascript" src="../../Images/rpt.js">
        
</script>

    <title></title>
  </head>

  <body class="Main" onload="@wizset(CURPOS=0)InitRpt(document,@wizget(CURPOS),'@dbHot(DBALIAS)','@DBHOT(DBUSERNAME)','@DBHOT(DBPASSWORD)','http:/scripts/trs.exe')">
    <object id="cDialog" class="ComDialog" classid="clsid:327DC737-2BAD-48A3-9B4E-B42D5378C78A">
    </object> 

    <table class="HdrTab">
      <tbody>
        <tr>
          <th id="RptTitle" class="HdrCel">Back Room Stock Report</th>

          <th class="HdrBtnCel"><input onclick="SubmitReport('@wizget(DN)')" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="HdrBtnNew" onkeydown="ReadKeyStroke(window,this)" accesskey="Z" type="button" value="Launch" name="BtnSubmit" /></th>

          <th class="HdrBtnCel"><input onclick="PrintReport('@wizget(DN)')" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="HdrBtnNew" onkeydown="ReadKeyStroke(window,this)" type="button" value="Print" name="BtnPrint" /></th>

          <th class="HdrBtnCel"><input onclick="ReportAddTo(this,'@wizget(DN)','T')" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="HdrBtnNew" onkeydown="ReadKeyStroke(window,this)" type="button" value="Add" name="BtnTask" /></th>

          <th class="HdrBtnCel"><input onclick="document.location='http:/scripts/trs.exe?htt=sqr\\' + RPT_FILENAME.value + '.rpt&amp;CN=@CNC&amp;TN=@TER';" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="HdrBtnNew" onkeydown="ReadKeyStroke(window,this)" type="button" value="Reset" name="BtnReset" /></th>
        </tr>
      </tbody>
    </table>

    <table class="EntTab" style="POSITION: absolute; LEFT: 30px; TOP: 60px">
      <tbody>
        <tr>
          <th class="EntHdr" colspan="2">RECEIPT</th>
        </tr>

        <tr>
          <td class="EntInp"><input onchange="ValidateField(window,this,'integer')" ondblclick="ShowGrid(window,this,570,269,0,'SELECT F1032 as Trs,F254 as TrsDate,F1127 as Cashier,F334 as Vendor,F1067 as Status FROM REC_HDR ORDER BY F1032 DESC',gDBAlias,gUsername,gPassword,'50;70;140;210;70','Select a receipt')" onfocus="SaveValue(this)" datasrc="@wizset(F1032=@wizget(F1032))" onblur="LeaveField(this)" class="EntGrid" onkeydown="ReadKeyStroke(window,this)" style="WIDTH: 60px" value="@wizget(F1032)" name="F1032" /></td>

          <td class="EntVal"><input tabindex="-1" class="EntValTxt" readonly="readonly" value="@dbSELECT(SELECT F254 FROM REC_HDR WHERE F1032='@WIZGET(F1032)') @dbSELECT(SELECT ' (' + F1067 + ') ' as F1067 FROM REC_HDR WHERE F1032='@WIZGET(F1032)') @dbSELECT(SELECT F334 FROM REC_HDR WHERE F1032='@WIZGET(F1032)')" /></td>
        </tr>
      </tbody>
    </table>
    <input class="HidParam" type="hidden" value="KDLOC_BACK_ROOM_STOCK" name="SQR" /><input class="HidParam" type="hidden" value="@CNC" name="CN" />
  </body>
</html>

