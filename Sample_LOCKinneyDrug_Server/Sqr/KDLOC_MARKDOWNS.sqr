/* KDLOC_MARKDOWNS */

@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=HDR_FPRICE_BAT);
@EXEC(INI=system[SMS]);
@WIZSET(TARGET=PAL);
@WIZSET(CHK1=1);

@WIZSET(SUBQUERY=SELECT DISTINCT F01 FROM POS_TAB POS WHERE POS.F2660 LIKE '%KD.MARKDOWNDATE%' AND F01 IN (SELECT DISTINCT F01 FROM FPRICE_BAT));
@WIZSET(PRICE_CALCULATE=TMP_MD_@STORE@TER);
@CREATE(TMP_MD_@STORE@TER,PRICE)

CREATE TRIGGER TMP_MD_@STORE@TER_TRIG ON TMP_MD_@STORE@TER AFTER UPDATE 
AS 
BEGIN   
	UPDATE 	TMP	
		SET F1927=1 		
	FROM INSERTED INS 		
	JOIN DELETED DEL ON INS.F01=DEL.F01 AND INS.F1000=DEL.F1000 AND INS.F126=DEL.F126 		
	JOIN TMP_MD_@STORE@TER TMP ON INS.F01=TMP.F01 AND INS.F1000=TMP.F1000 AND INS.F126=TMP.F126 		
	WHERE ISNULL(INS.F1934,0)<>ISNULL(DEL.F1934,0) 
END

@WIZCLR(CALCULATE_TABLE);
@EXEC(SQI=PRICE_CALCULATE);

@FMT(CMP,@DBSELECT(SELECT 1 FROM TMP_MD_@STORE@TER WHERE F1927=1)=1,,'®FMT(CHR,27)');

@DBEXEC(KDLOC_Label_WASNOW '@WIZGET(PRICE_CALCULATE)');

@RPT_QUERY
SELECT '' AS F902,'' AS F913,'' AS F907,'' AS F914,'' AS F931, @DBFLD(PRICE_TAB,PRI.), 
OBJ.F155,OBJ.F29,OBJ.F21,OBJ.F22,OBJ.F23,
PRI.F1007, PRI.F1006, PRI.F113, POS.F04, POS.F82
FROM @WIZGET(PRICE_CALCULATE) PRI
LEFT OUTER JOIN OBJ_TAB OBJ ON PRI.F01=OBJ.F01 
LEFT OUTER JOIN POS_TAB POS ON PRI.F01=POS.F01 
WHERE PRI.F1927=1
ORDER BY F04,PRI.F01,PRI.F126,PRI.F1000;
