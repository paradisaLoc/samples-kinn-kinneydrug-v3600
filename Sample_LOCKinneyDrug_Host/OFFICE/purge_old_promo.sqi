/* REMOVE ALL OLD SALE FROM PRICE_TAB */

/* Raincheck */
@FMT(CMP,@WIZGET(PURGE_OLD_PROMO_RAINCHECK)=1,
"®DBEXEC(UPDATE POS_TAB SET F1236=NULL, F1001=1 
WHERE ISNULL(F88,0)=0 AND ISNULL(F104,0)=0 AND 
F01 IN (SELECT DISTINCT F01 FROM PRICE_TAB WHERE F138<'@DSSF'))");

/* ITEMS TO EXCLUDE FROM PURGE */
@MACSIL(CREATE TABLE #TMP_PURGEITEM (@DBDCT(F01)));
INSERT INTO #TMP_PURGEITEM (F01)
SELECT POS.F01
FROM POS_TAB POS JOIN PRICE_TAB PRI ON POS.F01=PRI.F01
WHERE (POS.F88='1' OR POS.F104='1') AND 
	ISNULL(POS.F110,'0') NOT IN ('0') AND (PRI.F30 IS NULL);

/* Sale price */
update PRICE_TAB set 
F136=null,
F135=null,
F137=null,
F138=null,
F144=null,
F145=null,
F139=null,
F143=null,
F148=null,
F147=null,
F1220=null,
F1221=null,
F1193=null,
F146=null,
F1192=null,
F1001=1
WHERE F138<'@DSSF' AND
F01 NOT IN (SELECT F01 FROM #TMP_PURGEITEM);

/* REMOVE ALL OLD TPR FROM PRICE_TAB */

update PRICE_TAB set 
F181=null,
F182=null,
F183=null,
F184=null,
F1186=null,
F1187=null,
F1188=null,
F1189=null,
F1218=null,
F1219=null,
F1190=null,
F221=null,
F1191=null,
F1001=1
WHERE F184<'@DSSF' AND
F01 NOT IN (SELECT F01 FROM #TMP_PURGEITEM);

/* REMOVE ALL OLD INSTORE FROM PRICE_TAB */

update PRICE_TAB set 
F1133=null,
F1134=null,
F1216=null,
F1217=null,
F59=null,
F1194=null,
F1195=null,
F1196=null,
F1197=null,
F1198=null,
F1199=null,
F1222=null,
F1223=null,
F1201=null,
F1202=null,
F1200=null,
F1001=1
WHERE F1217<'@DSSF' AND
F01 NOT IN (SELECT F01 FROM #TMP_PURGEITEM);

/* REMOVE ALL OLD PRICE METHODS */

update PRICE_TAB set 
F35=null,
F129=null,
F36=null,
F130=null,
F140=null,
F142=null,
F63=null,
F62=null,
F111=null,
F112=null,
F32=null,
F33=null,
F169=null,
F1001=1
WHERE F129<'@DSSF';

/* DELETE TMP PROMO RECORD */

@UPDATE_BATCH(JOB=REMOVE,TAR=PRICE_TAB,KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT F01,F1000,F126 FROM PRICE_TAB WHERE 
(F30 IS NULL OR F30=0.00) AND
(F136 IS NULL OR F136=0.00) AND
(F181 IS NULL OR F181=0.00) AND
(F1133 IS NULL OR F1133=0.00) AND
F126>1 AND 
F01 NOT IN (SELECT DISTINCT F01 FROM POS_TAB WHERE F1120 LIKE '%EZ%') AND
F01 NOT IN (SELECT F01 FROM #TMP_PURGEITEM));

/* UPDATE NEXT PRICE */

UPDATE * FROM PRICE_TAB WHERE F1001=1;

DROP TABLE #TMP_PURGEITEM;