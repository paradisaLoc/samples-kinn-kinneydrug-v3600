@WIZRPL(DBASE_TIMEOUT=E);

/* LIST FIELDS TO UPDATE */
@DBVIEW(Q1,
DECLARE @FLD VARCHAR(1000)
DECLARE @PARAM VARCHAR(8000)
DECLARE @S1 VARCHAR(1000)
SET @FLD='@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),PRICE_TAB,,,,'F1008,F1009,F1007,F1006,F1208,F113,F1203,F1204,F1205,F1206,F1207,F1209,F1224,F1225,F1001'),'
SET @PARAM=''
SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1)
SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000)
WHILE (@S1<>'') 
BEGIN
  SET @PARAM=@PARAM+','+@S1+'=BAT.'+@S1
  IF LEN(@FLD)>2 
   BEGIN
     SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1) 
     SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000) 
   END
  ELSE 
   SET @S1=''   
END
SELECT @PARAM AS F2755);

IF NOT EXISTS(SELECT * FROM SYS.INDEXES WHERE NAME ='M@WIZGET(SOURCE)@WIZGET(BATCH)_F902')
	CREATE CLUSTERED INDEX M@WIZGET(SOURCE)@WIZGET(BATCH)_F902 ON M@WIZGET(SOURCE)@WIZGET(BATCH) (F01,F126,F1000,F902);

/* UPDATE DATABASE BY CHUCK OF X RECORDS */
DECLARE @BatchSize INT=1000000, @ROWCNT INT
WHILE 1=1
BEGIN
   BEGIN TRAN
	UPDATE  TOP (@BatchSize) PRI
	SET PRI.F1008='@DSSF',PRI.F1009='@TIME',PRI.F1007=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F30)=F30,BAT.,PRI.)F30,PRI.F1006=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F31)=F31,BAT.,PRI.)F31,
	PRI.F1208=F33,PRI.F113='REG',
	PRI.F1203=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F140)=F140,BAT.,PRI.)F140,F1204=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F142)=F142,BAT.,PRI.)F142,PRI.F1205=F63,PRI.F1206=F62,PRI.F1207=F32,PRI.F1209=F169,
	PRI.F1224=PRI.F111,F1225=PRI.F112,F1001=0
	@DBROW(Q1,F2755)
	FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
	JOIN PRICE_TAB PRI ON PRI.F01=BAT.F01 AND PRI.F126=BAT.F126 AND PRI.F1000=BAT.F1000 
	WHERE PRI.F902 <> BAT.F902
   	SET @ROWCNT=@@ROWCOUNT
   COMMIT TRAN
   IF @ROWCNT=0 BREAK
END

/* INSERT DATABASE BY CHUCK OF X RECORDS */
DECLARE @BatchSize INT=1000000, @ROWCNT INT
WHILE 1=1
BEGIN
   BEGIN TRAN
	INSERT INTO PRICE_TAB (F1008,F1009,F1007,F1006,F1208,F113,F1203,F1204,F1205,F1206,F1207,F1209,F1224,F1225,F1001,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),PRICE_TAB,,,,'F1008,F1009,F1007,F1006,F1208,F113,F1203,F1204,F1205,F1206,F1207,F1209,F1224,F1225,F1001'))
	SELECT F1008,F1009,F1007,F1006,F1208,F113,F1203,F1204,F1205,F1206,F1207,F1209,F1224,F1225,F1001,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),PRICE_TAB,,,,'F1008,F1009,F1007,F1006,F1208,F113,F1203,F1204,F1205,F1206,F1207,F1209,F1224,F1225,F1001') 
	FROM (
		SELECT TOP (@BatchSize) F1008='@DSSF',F1009='@TIME',F1007=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F30)=F30,BAT.F30,0),F1006=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F31)=F31,BAT.F31,0),
		F1208=NULL,F113='REG',
		F1203=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F140)=F140,BAT.F140,0),
		F1204=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F142)=F142,BAT.F142,0),F1205=NULL,F1206=NULL,F1207=NULL,F1209=NULL,
		F1224=NULL,F1225=NULL,F1001=0,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),PRICE_TAB,BAT.,,,'F1008,F1009,F1007,F1006,F1208,F113,F1203,F1204,F1205,F1206,F1207,F1209,F1224,F1225,F1001') 
		,ROW_NUMBER() OVER (PARTITION BY BAT.F01,BAT.F126,BAT.F1000 ORDER BY BAT.F01) AS F1301
		FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT
		LEFT JOIN PRICE_TAB PRI ON PRI.F01=BAT.F01 AND PRI.F126=BAT.F126 AND PRI.F1000=BAT.F1000 
		WHERE PRI.F01 IS NULL 				
		) TMP WHERE TMP.F1301=1
	SET @ROWCNT=@@ROWCOUNT
    COMMIT TRAN
    IF @ROWCNT=0 BREAK
END

DROP TABLE M@WIZGET(SOURCE)@WIZGET(BATCH);

DELETE FROM @WIZGET(HEADER) WHERE F902='@WIZGET(BATCH)' AND F903='@WIZGET(SOURCE)';

@WIZCLR(DBASE_TIMEOUT);