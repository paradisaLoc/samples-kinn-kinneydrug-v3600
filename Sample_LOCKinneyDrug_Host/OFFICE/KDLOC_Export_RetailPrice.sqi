@WIZINIT;
@WIZDATE(DATE=@DSSF);
@WIZDISPLAY;

/* Export: Retail */
@WIZRPL(DBASE_TIMEOUT=E);
@WIZRPL(STYLE=TXT);
@WIZRPL(OUTPUT=DBT\HQ_Retail_Chg_@STORE@TER_S@DBHOT(CNCURRENT).TXT);
@EXEC(CGI=KDLOC_Export_RetailPrice.htm);
@WIZCLR(DBASE_TIMEOUT);

/* USE MOVEFILE TO RENAME USING LOWER CASE */
@WIZRPL(SRC_PATH=DBT\HQ_Retail_Chg_@STORE@TER_S@DBHOT(CNCURRENT).TXT);
@WIZRPL(TAR_PATH=@DBHOT(INI,KinneyDrug.INI,PRICEEXPORT,ExportDir)HQ_Retail_Chg@DIDD@NOW.TSV);
@EXEC(XCH=MOVEFILE);
