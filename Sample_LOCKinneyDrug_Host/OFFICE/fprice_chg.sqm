INSERT INTO HEADER_DCT VALUES
('HC','00000001','001901','001001',,,1997001,0000,1997001,0001,,'LOAD','CREATE DCT',,,,,,'1/1.0','V1.0',,);

CREATE TABLE ITEM_DCT(@MAP_FROM_QUERY);

INSERT INTO HEADER_DCT VALUES
('HM','00000001','001901','001001',,,1997001,0000,1997001,0001,,'@WIZGET(F912)','HO @WIZGET(F913)',,,,,,'1/1.0','V1.0','F902+F01+F1000+F126','HOF902=@WIZGET(FIL1)','@WIZGET(F930)','@WIZGET(F931)','@WIZGET(F932)');

CREATE VIEW FPRICE_CHG AS SELECT @FIELDS_FROM_QUERY FROM ITEM_DCT;

INSERT INTO FPRICE_CHG VALUES

@WIZINIT;
@WIZFIL(FIL1,,SELECT CAST(F902 as CHAR(10)) as F902,F913 FROM HEADER_BAT WHERE F916='FPRICE_BAT' ORDER BY F902);
@WIZFIL(FRM,label=SELECT A FUTURE PRICE BATCH,field=F902,default=1);
@WIZDISPLAY;

@WIZINIT;
@WIZTARGET(DEPLOYBATCH.STORE=,@FMT(CMP,"@DbHot(INI,APPLICATION.INI,DEPLOY_TARGET,HOST_OFFICE)=","
SELECT F1000,F1018 FROM STO_TAB WHERE F1181=1","
SELECT DISTINCT STO.F1000,STO.F1018 
FROM LNK_TAB LN2 JOIN LNK_TAB LNK ON LN2.F1056=LNK.F1056 AND LN2.F1057=LNK.F1057
JOIN STO_TAB STO ON STO.F1000=LNK.F1000 
WHERE STO.F1181='1' AND STO.F1000<>'XAL' AND 
LN2.F1000='@DbHot(INI,APPLICATION.INI,DEPLOY_TARGET,HOST_OFFICE)'"));
@WIZDISPLAY;

/* REPLACE V TARGET WITH STORES */
WITH TARGET_VND (F1000,F27,F1056)
AS
(
SELECT DISTINCT LNK.F1000,CASE WHEN PATINDEX('%:%',STO.F1018)>0 THEN SUBSTRING(STO.F1018,1,PATINDEX('%:%',STO.F1018)-1) END AS F27,
LNK.F1056 
FROM LNK_TAB LNK
JOIN STO_TAB STO ON LNK.F1000=STO.F1000
WHERE LNK.F1000 LIKE 'V%'
)
INSERT INTO FPRICE_BAT (F1000,@DBFLD(FPRICE_BAT,,F1000))
SELECT DISTINCT VND.F1056 AS F1000,@DBFLD(FPRICE_BAT,BAT.,F1000)
FROM FPRICE_BAT BAT 
JOIN TARGET_VND VND ON BAT.F1000=VND.F1000
JOIN KINNEY_VND_STORE_ITEM STO ON STO.F01=BAT.F01 AND STO.F27=VND.F27 AND STO.F1056=VND.F1056 
WHERE BAT.F902='@WIZGET(FIL1)'

/* DELETE ALL THE V TARGET FROM THE BATCH */
DELETE FROM FPRICE_BAT WHERE F902='@WIZGET(FIL1)' AND F1000 LIKE 'V%'

@WIZSET(STYLE=SIL);
@WIZCLR(TARGET);
@WIZRPL(TARGET_FILTER=@DbHot(INI,APPLICATION.INI,DEPLOY_TARGET,HOST_OFFICE));
@WIZRPL(FORCE_F1000=@F1056);

@DBVIEW(Q1,SELECT F902,F907,F908,F909,F910,F912,F902+': '+F913 AS F913,F914,F930,ISNULL(F931,2) AS F931,F932 FROM HEADER_BAT WHERE F902='@WIZGET(FIL1)');

@WIZRPL(F912=@DBROW(Q1,F912));
@WIZRPL(F913=@DBROW(Q1,F913));
@WIZRPL(F914=@DBROW(Q1,F914));
@WIZRPL(F930=@DBROW(Q1,F930));
@WIZRPL(F931=@DBROW(Q1,F931,#));
@WIZRPL(F932=@DBROW(Q1,F932));
@DBVIEW(Q1);

@MAP_DEPLOY
SELECT MT.F1056+MT.F1057 AS F1000,MT.F1056 AS F1056,@DBFLD(FPRICE_BAT,BAT.,F1000) 
FROM 
FPRICE_BAT BAT JOIN
 (SELECT BAT.F902,BAT.F01,LNK.F1056,LNK.F1057,BAT.F126,BAT.F1000,ROW_NUMBER() OVER (PARTITION BY F01,F126,F1056,F1057 ORDER BY F1937 DESC) AS F1301
  FROM FPRICE_BAT BAT
  JOIN STO_TAB STO ON BAT.F1000=STO.F1000 
  JOIN LNK_TAB LNK ON STO.F1000=LNK.F1000 
  WHERE BAT.F902='@WIZGET(FIL1)'
 ) MT ON BAT.F902=MT.F902 AND BAT.F01=MT.F01 AND BAT.F126=MT.F126 AND BAT.F1000=MT.F1000 AND MT.F1301=1
WHERE MT.F1056+MT.F1057 IN (SELECT F1056+F1057 FROM LNK_TAB WHERE F1000 in('@WIZGET(DEPLOYBATCH.STORE)'))
@FMT(CMP,@wizget(TARGET_FILTER)<>,and MT.F1056+MT.F1057 IN (SELECT F1056+F1057 FROM LNK_TAB WHERE F1000 in('@WIZGET(TARGET_FILTER)')))
ORDER BY F1000,F01;


@WIZCLR(FORCE_F1000);

