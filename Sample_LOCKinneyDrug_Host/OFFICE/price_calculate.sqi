@WIZSET(PRICE_CALCULATE=TMP_PRI_@STORE@TER);
@FMT(CMP,@WIZGET(PRICE_CALCULATE)=TMP_PRI_@STORE@TER,'®CREATE(TMP_PRI_@STORE@TER,PRICE)');
@WIZSET(SUBQUERY="@DBHOT(HOT_IDX,F01)");
@WIZSET(EXECUTE_SINGLEDATE=0);

@WIZINIT;
@WIZDATE(DATE=@DSSF,TIME=@TIME);
@WIZDISPLAY;
@WIZRPL(DBASE_TIMEOUT=E);

INSERT INTO @WIZGET(PRICE_CALCULATE) (@DBFLD(PRICE_TAB))
SELECT @DBFLD(PRICE_TAB,PRI.) FROM PRICE_TAB PRI 
WHERE PRI.F01 IN (@WIZGET(SUBQUERY))
AND NOT EXISTS (SELECT F01 FROM @WIZGET(PRICE_CALCULATE) TMP WHERE PRI.F01=TMP.F01 AND PRI.F126=TMP.F126 AND PRI.F1000=TMP.F1000) ;

@WIZSET(CALCULATE_TABLE=@WIZGET(PRICE_CALCULATE));

@ACTIVATE_HEADER(SELECT * FROM HEADER_BAT 
WHERE (F916='FPRICE_BAT' or F916='FTPRICE_BAT' or F916='FSPRICE_BAT' or F916='FINSTORE_BAT' or F916='REDEEM_BAT' or F916='BAT_EXE') AND 
(('@WIZGET(EXECUTE_SINGLEDATE)'='0' AND (F909<='@WIZGET(DATE)' or F909 is NULL) AND (F907>='@WIZGET(DATE)' or F907 is NULL))
or
('@WIZGET(EXECUTE_SINGLEDATE)'='1' AND F909='@WIZGET(DATE)' AND ISNULL(F910,'0000')='@FMT(L4,@WIZGET(TIME))')) AND
(F914<>'WAIT' or F914 is NULL)
ORDER BY F909,F902);

@TOOLS(CALCDATE,PRI,"SELECT * FROM @WIZGET(PRICE_CALCULATE) WHERE F01 IN (@WIZGET(SUBQUERY))");

@WIZRPL(PRICE_CALCULATED=@DBSELECT(SELECT (F1013/F1012)-(F1013/F1012*ISNULL(F1227,0)/100)-ISNULL(F1226,0) FROM @WIZGET(PRICE_CALCULATE) WHERE F01="@DBHOT(HOT_IDX,F01)"));
@FMT(CMP,@WIZGET(PRICE_CALCULATED)=,'®WIZRPL(PRICE_CALCULATED=®DBSELECT(SELECT (F1007/F1006)-(F1007/F1006*ISNULL(F1225,0)/100)-ISNULL(F1224,0) FROM ®WIZGET(PRICE_CALCULATE) WHERE F01="®DBHOT(HOT_IDX,F01)"))');

@WIZCLR(DBASE_TIMEOUT);
