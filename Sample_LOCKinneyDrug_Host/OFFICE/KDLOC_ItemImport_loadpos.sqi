@WIZRPL(DBASE_TIMEOUT=E);

/* LIST FIELDS TO UPDATE */
@DBVIEW(Q1,
DECLARE @FLD VARCHAR(1000)
DECLARE @PARAM VARCHAR(8000)
DECLARE @S1 VARCHAR(1000)
SET @FLD='@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),POS_TAB,,,,'F1001'),'
SET @PARAM=''
SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1)
SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000)
WHILE (@S1<>'') 
BEGIN
  SET @PARAM=@PARAM+','+@S1+'=TMP.'+@S1
  IF LEN(@FLD)>2 
   BEGIN
     SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1) 
     SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000) 
   END
  ELSE 
   SET @S1=''   
END
SELECT @PARAM AS F2755);

/* UPDATE DATABASE */

UPDATE POS_TAB SET F1001=0
@DBROW(Q1,F2755)
FROM (SELECT 0 AS F1001,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),POS_TAB,,,,'F1001'),F1301=ROW_NUMBER() OVER (PARTITION BY F01,F1000 ORDER BY F01,F1000) FROM
 M@WIZGET(SOURCE)@WIZGET(BATCH)) TMP 
WHERE POS_TAB.F01=TMP.F01 AND
POS_TAB.F1000=TMP.F1000 AND
TMP.F1301=1 AND
TMP.F01 IN (SELECT DISTINCT F01 FROM POS_TAB);

INSERT INTO POS_TAB (F1001,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),POS_TAB,,,,'F1001'))
SELECT F1001,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),POS_TAB,TMP.,,,'F1001') 
FROM (SELECT 0 AS F1001,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),POS_TAB,,,,'F1001'),F1301=ROW_NUMBER() OVER (PARTITION BY F01,F1000 ORDER BY F01,F1000) FROM
M@WIZGET(SOURCE)@WIZGET(BATCH)) TMP 
WHERE F1301=1 AND
TMP.F01 NOT IN (SELECT DISTINCT F01 FROM POS_TAB);

DROP TABLE M@WIZGET(SOURCE)@WIZGET(BATCH);

DELETE FROM @WIZGET(HEADER) WHERE F902='@WIZGET(BATCH)' AND F903='@WIZGET(SOURCE)';

@WIZCLR(DBASE_TIMEOUT);