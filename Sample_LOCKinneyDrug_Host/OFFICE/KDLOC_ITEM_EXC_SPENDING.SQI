/* SET F177=1 FOR ITEMS THAT ARE NOT SET WITH IL IN F1120 AND THAT ARE NOT VERMONT AND MCKESSON */
/* SET F177=0 FOR ITEMS THAT ARE SET WITH IL IN F1120 OR THAT ARE VERMONT AND MCKESSON */
@UPDATE_BATCH(JOB=ADDRPL,TAR=PRICE_TAB,
KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT PRI.F1000,PRI.F01,PRI.F126,1 AS F177,1 AS F1001
FROM POS_TAB POS
JOIN PRICE_TAB PRI ON PRI.F01=POS.F01
JOIN LNK_TAB LNK ON LNK.F1000=PRI.F1000
LEFT JOIN LNK_TAB LNK_ZVT ON LNK_ZVT.F1056=LNK.F1000 AND LNK_ZVT.F1000='ZVT'
WHERE ISNULL(PRI.F177,0)=0
AND ISNULL(POS.F1120,'') NOT LIKE '%IL%' 
AND NOT (ISNULL(LNK_ZVT.F1000,'')='ZVT' AND ISNULL(POS.F04,0) BETWEEN '8800' AND '8999')
UNION
SELECT PRI.F1000,PRI.F01,PRI.F126,0 AS F177,1 AS F1001
FROM POS_TAB POS
JOIN PRICE_TAB PRI ON PRI.F01=POS.F01
JOIN LNK_TAB LNK ON LNK.F1000=PRI.F1000
LEFT JOIN LNK_TAB LNK_ZVT ON LNK_ZVT.F1056=LNK.F1000 AND LNK_ZVT.F1000='ZVT'
WHERE ISNULL(PRI.F177,0)=1
AND (ISNULL(POS.F1120,'') LIKE '%IL%' OR (ISNULL(LNK_ZVT.F1000,'')='ZVT' AND ISNULL(POS.F04,0) BETWEEN '8800' AND '8999')));