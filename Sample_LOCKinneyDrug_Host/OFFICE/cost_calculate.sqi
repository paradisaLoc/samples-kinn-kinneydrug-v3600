@WIZSET(COST_CALCULATE=TMP_COS_@STORE@TER);
@FMT(CMP,@WIZGET(COST_CALCULATE)=TMP_COS_@STORE@TER,'®CREATE(TMP_COS_@STORE@TER,COST)');
@WIZSET(SUBQUERY="@DBHOT(HOT_IDX,F01)");
@WIZSET(EXECUTE_SINGLEDATE=0);
@WIZSET(TIME=0000);
@WIZINIT;
@WIZDATE(DATE);
@WIZDISPLAY;
@WIZRPL(DBASE_TIMEOUT=E);

INSERT INTO @WIZGET(COST_CALCULATE) (@DBFLD(COST_TAB))
SELECT @DBFLD(COST_TAB,COS.) 
FROM COST_TAB COS
LEFT JOIN @WIZGET(COST_CALCULATE) TMP ON COS.F01=TMP.F01 AND COS.F27=TMP.F27 AND COS.F1000=TMP.F1000 AND COS.F1184=TMP.F1184
WHERE COS.F01 IN (@WIZGET(SUBQUERY)) AND (COS.F90='1' or COS.F90 is NULL) AND TMP.F01 IS NULL;

@WIZSET(CALCULATE_TABLE=@WIZGET(COST_CALCULATE));

@ACTIVATE_HEADER(SELECT * FROM HEADER_BAT 
WHERE (F916='FCOST_BAT' or F916='ALLOW_BAT' or F916='REBATE_BAT' or F916='FDISC_BAT' or F916='FCSTBRK_BAT' or F916='BAT_EXE') AND 
(('@WIZGET(EXECUTE_SINGLEDATE)'='0' AND (F909<='@WIZGET(DATE)' or F909 is NULL) AND (F907>='@WIZGET(DATE)' or F907 is NULL))
or
('@WIZGET(EXECUTE_SINGLEDATE)'='1' AND F909='@WIZGET(DATE)' AND ISNULL(F910,'0000')='@FMT(L4,@WIZGET(TIME))')) AND
(F914<>'WAIT' or F914 is NULL)
ORDER BY F909,F902);

@TOOLS(CALCDATE,COS,"SELECT * FROM @WIZGET(COST_CALCULATE) WHERE F01 IN (@WIZGET(SUBQUERY))");

@WIZRPL(COST_CALCULATED=@DBSELECT(SELECT 
CASE WHEN ISNULL(F223,'1')<>'1' AND '@WIZGET(DATE)' BETWEEN F202 AND F203
THEN F1140-(ISNULL(F201,0)/ISNULL(F19,1)) ELSE F1140 END 
FROM @WIZGET(COST_CALCULATE) 
WHERE F01="@DBHOT(HOT_IDX,F01)"));

@WIZCLR(DBASE_TIMEOUT);
