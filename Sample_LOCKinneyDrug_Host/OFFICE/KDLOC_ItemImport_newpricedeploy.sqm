INSERT INTO HEADER_DCT VALUES
('HC','00000001','001901','PAL',,,1997001,0000,1997001,0001,,'LOAD','CREATE DCT',,,,,,'1/1.0','V1.0',,);

CREATE TABLE PRICE_DCT(@MAP_FROM_QUERY);

INSERT INTO HEADER_DCT VALUES
('HM','00000001','001901','PAL',,,1997001,0000,1997001,0001,,'ADDRPL','@WIZGET(F913)',,,,,,'1/1.0','V1.0','F01+F1000+F126',);

CREATE VIEW PRICE_CHG AS SELECT @FIELDS_FROM_QUERY FROM PRICE_DCT;

INSERT INTO PRICE_CHG VALUES

/* EXTRACT SECTION */

@WIZSET(STYLE=SIL);
@WIZRPL(F913=KINNEY DRUG NEW ITEM LOCATION);
@WIZSET(TARGET=901);
@WIZRPL(FORCE_F1000=@F1000);
@WIZSET(KD.DEPLOY_TABLE=TMP_TABLE);

@MAP_DEPLOY
SELECT @DBFLD(PRICE_TAB,TPRI.,F1964),NULL AS F1964 FROM
(
	SELECT TMP.F1056 AS F1000,@DBFLD(PRICE_TAB,PRI.,'F1000'),ROW_NUMBER() OVER (PARTITION BY PRI.F01,TMP.F1056 ORDER BY PRI.F01,TMP.F1056) AS F1301
	FROM @WIZGET(KD.DEPLOY_TABLE) TMP 
	JOIN PRICE_TAB PRI ON TMP.F01=PRI.F01 AND PRI.F1000 IN (SELECT F1056 FROM STD_TAB WHERE F1545=(SELECT F1545 FROM STD_TAB WHERE F1056=TMP.F1056))
) TPRI WHERE F1301=1;

