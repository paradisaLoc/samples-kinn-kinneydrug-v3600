/* PROMPT FOR DATE IF NOT COMING FROM SCHEDULER */
@WIZINIT;
@WIZDATE(DATE);
@WIZDISPLAY;

/* DETERMINE EFFECTIVE DATES OF FIRST AND LAST MARKDOWN */ 
@DBVIEW(Q1,SELECT FirstMD=CASE WHEN DATEDIFF(dd,'@WIZGET(DATE)',DATEADD(wk, DATEDIFF(wk,0,'@WIZGET(DATE)'), 10))>=7 THEN DATEADD(wk, DATEDIFF(wk,0,'@WIZGET(DATE)'), 10) ELSE DATEADD(wk, DATEDIFF(wk,0,'@WIZGET(DATE)'), 17) END,NotForSaleDate=DATEADD(YY,-2,DATEADD(DD,-42,'@WIZGET(DATE)')));

/*************************************************************/
/* ON FIRST TIME MARK DOWN FLAG IF FOUND                     */
/* ADD CURRENT DATE TO ITEM URL AND REGULAR PRICE TO SRP     */
/*************************************************************/
@UPDATE_BATCH(JOB=ADDRPL,TAR=PRICE_TAB,
KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT F1000,F126,F01,F30 AS F168,1 AS F1001
FROM PRICE_TAB WHERE F01 IN (SELECT F01 FROM POS_TAB WHERE ISNULL(F2660,'') NOT LIKE '%KD.MARKDOWNDATE%' AND CHARINDEX('MD',ISNULL(F1120,''))>0));

@UPDATE_BATCH(JOB=ADDRPL,TAR=POS_TAB,
KEY=F01=:F01 AND F1000=:F1000,
SRC=SELECT F1000,F01,F2660=ISNULL(F2660,'')+',KD.MARKDOWNDATE=@DBROW(Q1,FirstMD,DIDF)',1 AS F1001
FROM POS_TAB WHERE ISNULL(F2660,'') NOT LIKE '%KD.MARKDOWNDATE%' AND CHARINDEX('MD',ISNULL(F1120,''))>0);

/*************************************************************/
/* FIRST DAY OF THE MARK DOWN - 25% OFF CURRENT PRICE (25%)  */
/*************************************************************/
@UPDATE_BATCH(JOB=ADDRPL,TAR=PRICE_TAB,
KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT F1000,F01,F126,1 AS F31,1 AS F1001,
CASE 
 WHEN CAST(F168-F168*0.25 AS NUMERIC(12,2))<1 THEN CAST(F168-F168*0.25-.005 AS NUMERIC(12,2))
 WHEN CAST(F168-F168*0.25 AS NUMERIC(12,2))>=1 AND CAST(F168-F168*0.25 AS NUMERIC(12,2))=CAST(F168-F168*0.25 AS NUMERIC(12,1)) THEN CAST(F168-F168*0.25-.005 AS NUMERIC(12,2))-0.01
 ELSE CAST(F168-F168*0.25-.005 AS NUMERIC(12,2)) END AS F30, 
CASE 
 WHEN CAST(F168-F168*0.25 AS NUMERIC(12,2))<1 THEN CAST(F168-F168*0.25-.005 AS NUMERIC(12,2))
 WHEN CAST(F168-F168*0.25 AS NUMERIC(12,2))>=1 AND CAST(F168-F168*0.25 AS NUMERIC(12,2))=CAST(F168-F168*0.25 AS NUMERIC(12,1)) THEN CAST(F168-F168*0.25-.005 AS NUMERIC(12,2))-0.01
 ELSE CAST(F168-F168*0.25-.005 AS NUMERIC(12,2)) END AS F1934
FROM PRICE_TAB WHERE F01 IN (SELECT F01 FROM POS_TAB WHERE ISNULL(F2660,'') LIKE '%KD.MARKDOWNDATE=@DATE(@WIZGET(DATE),DIDF)%' AND CHARINDEX('MD',ISNULL(F1120,''))>0));

/*************************************************************/
/* 2 WEEKS AFTER FIRST MARKDOWN - 33% OFF CURRENT PRICE (50%)*/
/*************************************************************/
@UPDATE_BATCH(JOB=ADDRPL,TAR=PRICE_TAB,
KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT F1000,F01,F126,1 AS F31,1 AS F1001,
CASE 
 WHEN CAST(F168-F168*0.5 AS NUMERIC(12,2))<1 THEN CAST(F168-F168*0.5-.005 AS NUMERIC(12,2))
 WHEN CAST(F168-F168*0.5 AS NUMERIC(12,2))>=1 AND CAST(F168-F168*0.5 AS NUMERIC(12,2))=CAST(F168-F168*0.5 AS NUMERIC(12,1)) THEN CAST(F168-F168*0.5-.005 AS NUMERIC(12,2))-0.01
 ELSE CAST(F168-F168*0.5-.005 AS NUMERIC(12,2)) END AS F30, 
CASE 
 WHEN CAST(F168-F168*0.5 AS NUMERIC(12,2))<1 THEN CAST(F168-F168*0.5-.005 AS NUMERIC(12,2))
 WHEN CAST(F168-F168*0.5 AS NUMERIC(12,2))>=1 AND CAST(F168-F168*0.5 AS NUMERIC(12,2))=CAST(F168-F168*0.5 AS NUMERIC(12,1)) THEN CAST(F168-F168*0.5-.005 AS NUMERIC(12,2))-0.01
 ELSE CAST(F168-F168*0.5-.005 AS NUMERIC(12,2)) END AS F1934
FROM PRICE_TAB WHERE F01 IN (SELECT F01 FROM POS_TAB WHERE ISNULL(F2660,'') LIKE '%KD.MARKDOWNDATE=@DATE(@WIZGET(DATE),DID-D14F)%' AND CHARINDEX('MD',ISNULL(F1120,''))>0));

/*************************************************************/
/* 6 WEEKS AFTER FIRST MARK DOWN - 50% CURRENT PRICE  (75%)  */
/*************************************************************/
@UPDATE_BATCH(JOB=ADDRPL,TAR=PRICE_TAB,
KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT F1000,F01,F126,1 AS F31,1 AS F1001,
CASE 
 WHEN CAST(F168-F168*0.75 AS NUMERIC(12,2))<1 THEN CAST(F168-F168*0.75-.005 AS NUMERIC(12,1))
 ELSE CAST(F168-F168*0.75-.005 AS NUMERIC(12,2)) END AS F30, 
CASE 
 WHEN CAST(F168-F168*0.75 AS NUMERIC(12,2))<1 THEN CAST(F168-F168*0.75-.005 AS NUMERIC(12,1))
 ELSE CAST(F168-F168*0.75-.005 AS NUMERIC(12,2)) END AS F1934
FROM PRICE_TAB WHERE F01 IN (SELECT F01 FROM POS_TAB WHERE ISNULL(F2660,'') LIKE '%KD.MARKDOWNDATE=@DATE(@WIZGET(DATE),DID-D42F)%' AND CHARINDEX('MD',ISNULL(F1120,''))>0));


/*************************************************************/
/* 90 DAYS AFTER LAST MARKDOWN - FLAG AS DISCOUNTINUED       */
/*************************************************************/
@UPDATE_BATCH(JOB=ADDRPL,TAR=POS_TAB,
KEY=F01=:F01 AND F1000=:F1000,
SRC=SELECT F1000,F01,'1' AS F08,1 AS F1001 
FROM POS_TAB WHERE ISNULL(F2660,'') LIKE '%KD.MARKDOWNDATE=@DATE(@WIZGET(DATE),DID-D132F)%' AND CHARINDEX('MD',ISNULL(F1120,''))>0);

/*************************************************************/
/* 2 YEARS AFTER FIRST MARK DOWN - FLAG ITEM AS NOT FOR SALE */
/*************************************************************/
/*@UPDATE_BATCH(JOB=ADDRPL,TAR=POS_TAB,*/
/*KEY=F01=:F01 AND F1000=:F1000,*/
/*SRC=SELECT F1000,F01,'1' AS F86,1 AS F1001 */
/*FROM POS_TAB WHERE ISNULL(F2660,'') LIKE '%KD.MARKDOWNDATE=@DBROW(Q1,NotForSaleDate,DIDF)%' AND CHARINDEX('MD',F1120)>0);*/

/*************************************************************/
/* IF MARK DOWN FLAG HAS BEEN REMOVE                         */
/*************************************************************/
@UPDATE_BATCH(JOB=ADDRPL,TAR=PRICE_TAB,
KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT F1000,F126,F01,F168 AS F30,1 AS F31,NULL AS F168,'@WIZGET(DATE)' AS F35, 1 AS F1001, F168 AS F1934
FROM PRICE_TAB WHERE F01 IN (SELECT F01 FROM POS_TAB WHERE ISNULL(F2660,'') LIKE '%KD.MARKDOWNDATE%' AND CHARINDEX('MD',ISNULL(F1120,''))=0));

@UPDATE_BATCH(JOB=ADDRPL,TAR=POS_TAB,
KEY=F01=:F01 AND F1000=:F1000,
SRC=SELECT F1000,F01,F2660=REPLACE(F2660,SUBSTRING(F2660,CHARINDEX('KD.MARKDOWNDATE',ISNULL(F2660,'')),26),''),F08='', 1 AS F1001
FROM POS_TAB WHERE ISNULL(F2660,'') LIKE '%KD.MARKDOWNDATE%' AND CHARINDEX('MD',ISNULL(F1120,''))=0);

UPDATE POS_TAB SET F1001=1 WHERE F01 IN (SELECT DISTINCT F01 FROM PRICE_TAB WHERE F1001=1);
UPDATE * FROM PRICE_TAB WHERE F1001=1;