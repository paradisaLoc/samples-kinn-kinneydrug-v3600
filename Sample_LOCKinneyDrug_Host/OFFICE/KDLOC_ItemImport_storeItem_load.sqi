@WIZINIT;
@WIZEDIT(FILENAME=@dbHot(INI,@OFFICEKINNEYDRUG.INI,GENERAL,INBOX)KINNEY_VENDOR_STORE_ITEM_AUTH.052915164539.txt,ENTER FULL PATH TO KINNEY_VENDOR_STORE_ITEM_AUTH FILE);
@WIZDISPLAY;

@FMT(CMP,@DBHOT(FINDTABLE,M@WIZGET(SOURCE)@WIZGET(BATCH))=,,"®DBEXEC(DROP TABLE KINNEY_VND_STORE_ITEM)");

CREATE TABLE TMP_STORE (@DBDCT(F01,F154,F1056,F27,F1401));
@EXEC(SQI=CREATE_TABLE_KINNEYSTOREITEM.SQI);

BULK INSERT TMP_STORE
   FROM '@WIZGET(FILENAME)'
   WITH 
      (
         FIELDTERMINATOR ='\t',
	 ROWTERMINATOR = '\n'
      );


/* STRIP CHECK DIGIT ON EAN13 */
UPDATE TMP_STORE SET 
F154=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F154,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F154,13),12) ELSE RIGHT('0000000000000'+F154,13) END,
F01=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F01,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F01,13),12) ELSE RIGHT('0000000000000'+F01,13) END

/* IF F01 IS EMPTY THEN USE F154 */
UPDATE TMP_STORE SET F01=F154 WHERE F01='0000000000000'

/* DELETE WHERE UPC VALUE IS EMPTY */
DELETE FROM TMP_STORE WHERE F01='0000000000000';

INSERT INTO KINNEY_VND_STORE_ITEM (F01,F27,F1056)
SELECT MAX(F01),MAX(F27),RIGHT('000'+LTRIM(MAX(F1056)),3) AS F1056
FROM TMP_STORE 
GROUP BY F01,F27,F1056;

INSERT INTO LNK_TAB (F1056,F1057,F1000)
SELECT F1056,'901' AS F1057,'RAL' AS F1000
FROM (SELECT DISTINCT F1056 FROM KINNEY_VND_STORE_ITEM) TMP
WHERE F1056 NOT IN (SELECT F1056 FROM LNK_TAB WHERE F1000='RAL');

INSERT INTO LNK_TAB (F1056,F1057,F1000)
SELECT F1056,'901' AS F1057,F1056 AS F1000
FROM (SELECT DISTINCT F1056 FROM KINNEY_VND_STORE_ITEM) TMP
WHERE F1056 NOT IN (SELECT F1056 FROM LNK_TAB WHERE F1000=F1056);

INSERT INTO STO_TAB (F1000,F1018,F1182,F1937)
SELECT F1056 AS F1000,'Store '+F1056 AS F1018,'1' AS F1182,4 AS F1937
FROM (SELECT DISTINCT F1056 FROM KINNEY_VND_STORE_ITEM) TMP
WHERE F1056 NOT IN (SELECT F1000 FROM STO_TAB WHERE F1182='1');

INSERT INTO STD_TAB (F1056,F1531,F1545)
SELECT F1056,'Store '+F1056,1 as F1545
FROM (SELECT DISTINCT F1056 FROM KINNEY_VND_STORE_ITEM) TMP
WHERE F1056 NOT IN (SELECT F1056 FROM STD_TAB);

