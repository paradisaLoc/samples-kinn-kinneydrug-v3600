@EXEC(INI=KINNEYDRUG[IMPORT]);

/* Set general import parameters */
@WIZRPL(FILE_TYPE=IMPORT);
@WIZRPL(TARGET=941);
@WIZRPL(FILE_TYPE2=ASCII);
@WIZRPL(CHAR_DELIMITER=#9);
@WIZRPL(DEL_FILE=1);
@WIZRPL(DIR_NAME=@DBHOT(INI,@OFFICEKINNEYDRUG.INI,GENERAL,INBOX));

/* Set general file backup parameters */
@WIZRPL(SAVE_DIR=@DBHOT(INI,@OFFICEKINNEYDRUG.INI,GENERAL,SAVE_DIR));
@WIZSET(SAVE_DIR_PURGE=@DBHOT(INI,@OFFICEKINNEYDRUG.INI,GENERAL,SAVE_DIR_PURGE));
@WIZSET(SAVE_EXT=.@DIDF@TIME);

/* VND STORE ITEM */
@WIZRPL(HEADER_DCT[F913]=KINNEYDRUGS VND STORE ITEM);
@WIZRPL(MAP_FILE=XCH_KINNEYDRUGS_VND_STORE_ITEM.SQM);
@WIZRPL(XCH_SUBJECT=KINNEYDRUGS VND STORE ITEM);
@WIZRPL(FILE_NAME=KINNEY_VENDOR_STORE_ITEM_AUTH*.*);
@EXEC(XCH=RECV);

/* NEW ITEMS */
@WIZRPL(HEADER_DCT[F913]=KINNEYDRUGS NEW ITEMS);
@WIZRPL(MAP_FILE=XCH_KINNEYDRUGS_HQITEMS.SQM);
@WIZRPL(XCH_SUBJECT=KINNEYDRUGS NEW ITEMS);
@WIZRPL(FILE_NAME=KINNEY_ITEMS_VENDOR.*.*);
@FMT(CMP,@WIZGET(HQITEM)=1,®EXEC(XCH=RECV));

/* NEW ITEM PRICE */
@WIZRPL(HEADER_DCT[F913]=KINNEYDRUGS ITEM PRICE);
@WIZRPL(MAP_FILE=XCH_KINNEYDRUGS_NEWITEMPRICE.SQM);
@WIZRPL(XCH_SUBJECT=KINNEYDRUGS ITEM PRICE);
@WIZRPL(FILE_NAME=KINNEY_NEW_ITEM_PRICE.*.*);
@FMT(CMP,@WIZGET(ITEMPRICE)=1,®EXEC(XCH=RECV));

/* MFG COST */
@WIZRPL(HEADER_DCT[F913]=KINNEYDRUGS COST);
@WIZRPL(MAP_FILE=XCH_KINNEYDRUGS_ITEMCOST.SQM);
@WIZRPL(XCH_SUBJECT=KINNEYDRUGS COST);
@WIZRPL(FILE_NAME=KINNEY_COST.*.*);
@FMT(CMP,@WIZGET(COST)=1,®EXEC(XCH=RECV));

/* VENDOR */
@WIZRPL(HEADER_DCT[F913]=KINNEYDRUGS VENDOR);
@WIZRPL(MAP_FILE=XCH_KINNEYDRUGS_VENDOR.SQM);
@WIZRPL(XCH_SUBJECT=KINNEYDRUGS VENDOR);
@WIZRPL(FILE_NAME=KINNEY_VENDOR.*.*);
@FMT(CMP,@WIZGET(VENDOR)=1,®EXEC(XCH=RECV));

/* LAST COST */
@WIZRPL(HEADER_DCT[F913]=KINNEYDRUGS LASTCOST);
@WIZRPL(MAP_FILE=XCH_KINNEYDRUGS_LASTCOST.SQM);
@WIZRPL(XCH_SUBJECT=KINNEYDRUGS LASTCOST);
@WIZRPL(FILE_NAME=LRC_*.*);
@WIZRPL(MULTI_FILE=1);
@FMT(CMP,@WIZGET(LASTCOST)=1,®EXEC(XCH=RECV));


/* Send done message */
@EXEC(SQM=KDLOC_ItemImport_DONE_MSG);

