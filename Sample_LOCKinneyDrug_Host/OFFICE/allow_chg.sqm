INSERT INTO HEADER_DCT VALUES
('HC','00000001','001901','001001',,,1997001,0000,1997001,0001,,'LOAD','CREATE DCT',,,,,,'1/1.0','V1.0',,);

CREATE TABLE ITEM_DCT(@MAP_FROM_QUERY);

INSERT INTO HEADER_DCT VALUES
('HM','00000001','001901','001001',,,1997001,0000,1997001,0001,,'@WIZGET(F912)','HO @WIZGET(F913)',,,,,,'1/1.0','V1.0','F902+F01+F1000+F27','HOF902=@WIZGET(FIL1),HOF908=@WIZGET(F908),HOF910=@WIZGET(F910)','@WIZGET(F930)','@WIZGET(F931)','@WIZGET(F932)');

CREATE VIEW ALLOW_CHG AS SELECT @FIELDS_FROM_QUERY FROM ITEM_DCT;

INSERT INTO ALLOW_CHG VALUES

@WIZINIT;
@WIZFIL(FIL1,,SELECT CAST(F902 as CHAR(10)) as F902,F913 FROM HEADER_BAT WHERE F916='ALLOW_BAT' ORDER BY F902);
@WIZFIL(FRM,label=SELECT A FUTURE ALLOWANCE BATCH,field=F902,default=1);
@WIZDISPLAY;

@WIZINIT;
@WIZTARGET(DEPLOYBATCH.STORE=,@FMT(CMP,"@DbHot(INI,APPLICATION.INI,DEPLOY_TARGET,HOST_OFFICE)=","
SELECT F1000,F1018 FROM STO_TAB WHERE F1181=1","
SELECT DISTINCT STO.F1000,STO.F1018 
FROM LNK_TAB LN2 JOIN LNK_TAB LNK ON LN2.F1056=LNK.F1056 AND LN2.F1057=LNK.F1057
JOIN STO_TAB STO ON STO.F1000=LNK.F1000 
WHERE STO.F1181='1' AND STO.F1000<>'XAL' AND 
LN2.F1000='@DbHot(INI,APPLICATION.INI,DEPLOY_TARGET,HOST_OFFICE)'"));
@WIZDISPLAY;

@WIZSET(STYLE=SIL);
@WIZCLR(TARGET);
@WIZRPL(TARGET_FILTER=@DbHot(INI,APPLICATION.INI,DEPLOY_TARGET,HOST_OFFICE));
@WIZRPL(FORCE_F1000=@F1056);

@DBVIEW(Q1,SELECT F902,F907,F908,F909,F910,F912,F902+': '+F913 AS F913,F914,F930,ISNULL(F931,2) AS F931,F932 FROM HEADER_BAT WHERE F902='@WIZGET(FIL1)');

@WIZRPL(F908=@DBROW(Q1,F908));
@WIZRPL(F910=@DBROW(Q1,F910));
@WIZRPL(F912=@DBROW(Q1,F912));
@WIZRPL(F913=@DBROW(Q1,F913));
@WIZRPL(F914=@DBROW(Q1,F914));
@WIZRPL(F930=@DBROW(Q1,F930));
@WIZRPL(F931=@DBROW(Q1,F931,#));
@WIZRPL(F932=@DBROW(Q1,F932));
@DBVIEW(Q1);

@MAP_DEPLOY
SELECT MT.F1056+MT.F1057 AS F1000,MT.F1056 AS F1056,@DBFLD(ALLOW_BAT,BAT.,F1000) 
FROM 
ALLOW_BAT BAT JOIN 
 (SELECT BAT.F902,BAT.F01,LNK.F1056,LNK.F1057,BAT.F1000,BAT.F27,BAT.F1184,ROW_NUMBER() OVER (PARTITION BY F01,F27,F1184,F1056,F1057 ORDER BY F1937 DESC) AS F1301
  FROM ALLOW_BAT BAT
  JOIN STO_TAB STO ON BAT.F1000=STO.F1000 
  JOIN LNK_TAB LNK ON STO.F1000=LNK.F1000 
  WHERE BAT.F902='@WIZGET(FIL1)'
 ) MT ON BAT.F902=MT.F902 AND BAT.F01=MT.F01 AND BAT.F27=MT.F27 AND BAT.F1184=MT.F1184 AND BAT.F1000=MT.F1000 AND MT.F1301=1
WHERE BAT.F902='@WIZGET(FIL1)' AND
MT.F1056+MT.F1057 IN (SELECT F1056+F1057 FROM LNK_TAB WHERE F1000 in('@WIZGET(DEPLOYBATCH.STORE)'))
@FMT(CMP,@wizget(TARGET_FILTER)<>,and MT.F1056+MT.F1057 IN (SELECT F1056+F1057 FROM LNK_TAB WHERE F1000 in('@WIZGET(TARGET_FILTER)')))
ORDER BY F1000,F01;

@WIZCLR(FORCE_F1000);

