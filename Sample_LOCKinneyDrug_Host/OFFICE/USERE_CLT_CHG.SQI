/* Include import into customer alternate table */
@UPDATE_BATCH(JOB=@WIZGET(ACTION),TAR=CLL_TAB,
KEY=F1577=:F1577 AND F1578=:F1578,
SRC=SELECT @FMT(CMP,'@dbHot(INI,@WIZGET(INI_HOST_STORE),CLL_CHG,EXECUTE_INCLUDE)=',"®dbFld(M@WIZGET(SOURCE)@WIZGET(BATCH),,'@dbHot(INI,@WIZGET(INI_HOST_STORE),CLL_CHG,EXECUTE_EXCLUDE)')","®dbHot(INI,@WIZGET(INI_HOST_STORE),CLL_CHG,EXECUTE_INCLUDE)") 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH));


