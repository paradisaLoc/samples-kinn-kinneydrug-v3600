@WIZRPL(DBASE_TIMEOUT=E);

/* LIST FIELDS TO UPDATE */
@DBVIEW(Q1,
DECLARE @FLD VARCHAR(1000)
DECLARE @PARAM VARCHAR(8000)
DECLARE @S1 VARCHAR(1000)
SET @FLD='@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),COST_TAB,,,,'F1001,F196,F39,F1140'),'
SET @PARAM=''
SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1)
SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000)
WHILE (@S1<>'') 
BEGIN
  SET @PARAM=@PARAM+','+@S1+'=BAT.'+@S1
  IF LEN(@FLD)>2 
   BEGIN
     SET @S1=SUBSTRING(@FLD,1,CHARINDEX(',',@FLD)-1) 
     SET @FLD=SUBSTRING(@FLD,CHARINDEX(',',@FLD)+1,1000) 
   END
  ELSE 
   SET @S1=''   
END
SELECT @PARAM AS F2755);

IF NOT EXISTS(SELECT * FROM SYS.INDEXES WHERE NAME ='M@WIZGET(SOURCE)@WIZGET(BATCH)_F902')
	CREATE CLUSTERED INDEX M@WIZGET(SOURCE)@WIZGET(BATCH)_F902 ON M@WIZGET(SOURCE)@WIZGET(BATCH) (F902,F01,F1000,F27,F1184);

/* UPDATE DATABASE BY CHUCK OF X RECORDS */
DECLARE @BatchSize INT=1000000, @ROWCNT INT
WHILE 1=1
BEGIN
	BEGIN TRAN
	UPDATE  TOP (@BatchSize) COS
		SET F1001=0,F196=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F38)=F38,BAT.,COS.)F38,
		F1140=@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F38)=F38,BAT.,COS.)F38/@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F38)=F38,BAT.,COS.)F19,
		F39='@DSSF'
		@DBROW(Q1,F2755)
	FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT
	JOIN COST_TAB COS ON COS.F1000=BAT.F1000 AND COS.F01=BAT.F01 AND COS.F27=BAT.F27 AND COS.F1184=BAT.F1184
	WHERE COS.F902 <> BAT.F902			
	SET @ROWCNT=@@ROWCOUNT
	COMMIT TRAN
    IF @ROWCNT=0 BREAK
END

/* INSERT DATABASE BY CHUCK OF X RECORDS */
DECLARE @BatchSize INT=1000000, @ROWCNT INT
WHILE 1=1
BEGIN
	BEGIN TRAN
	INSERT INTO COST_TAB (F1001,@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F38)=F38,'F196,',)@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),'FIELDS=F19,F38')=F19F38,'F1140,')F39,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),COST_TAB,,,,'F1001,F196,F39,F1140'))
	SELECT F1001,@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F38)=F38,'F196,',)@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),'FIELDS=F19,F38')=F19F38,'F1140,')F39,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),COST_TAB,,,,'F1001,F196,F39,F1140')
	FROM (SELECT TOP (@BatchSize) 0 AS F1001,@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),FIELDS=F38)=F38,'F196=BAT.F38,')@FMT(CMP,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),'FIELDS=F19,F38')=F19F38,'F1140=BAT.F38/BAT.F19,')
		F39='@DSSF',@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),COST_TAB,BAT.,,,'F1001,F196,F39,F1140') 
		,ROW_NUMBER() OVER (PARTITION BY BAT.F01,BAT.F1000,BAT.F27,BAT.F1184 ORDER BY BAT.F01) AS F1301
		FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT
		LEFT JOIN COST_TAB COS ON COS.F1000=BAT.F1000 AND COS.F01=BAT.F01 AND COS.F27=BAT.F27 AND COS.F1184=BAT.F1184
		WHERE COS.F01 IS NULL 				
		) TMP WHERE TMP.F1301=1
	SET @ROWCNT=@@ROWCOUNT
	COMMIT TRAN
    IF @ROWCNT=0 BREAK
END

DROP TABLE M@WIZGET(SOURCE)@WIZGET(BATCH);

DELETE FROM @WIZGET(HEADER) WHERE F902='@WIZGET(BATCH)' AND F903='@WIZGET(SOURCE)';

@WIZCLR(DBASE_TIMEOUT);