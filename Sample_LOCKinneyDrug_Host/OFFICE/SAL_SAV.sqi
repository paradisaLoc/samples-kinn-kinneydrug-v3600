@DBHOT(MSSQL,STARTTRANSACTION);

@IMPORT_SIL(SAL_SAV_USR_*.SQI);

INSERT INTO SAL_HDR_SAV (F1505,@dbCol(SAL_HDR_SAV,@wizGet(SILHDR_TABLE_SAL_HDR)),F2890)
SELECT F254,@dbCol(SAL_HDR_SAV,@wizGet(SILHDR_TABLE_SAL_HDR)),GETDATE() AS F2890 FROM @wizGet(SILHDR_TABLE_SAL_HDR);

@dbView(Q1,SELECT F254,F1056,F1057,F1068 FROM @wizGet(SILHDR_TABLE_SAL_HDR));

INSERT INTO SAL_REG_SAV (F1505,@dbCol(SAL_REG_SAV,@wizGet(SILHDR_TABLE_SAL_REG),,,,F1056;F1057;F2890),F1056,F1057,F2890)
SELECT '@dbRow(Q1,F254)',@dbCol(SAL_REG_SAV,@wizGet(SILHDR_TABLE_SAL_REG),,,,F1056;F1057),'@dbRow(Q1,F1056)','@dbRow(Q1,F1057)',GETDATE() AS F2890
FROM @wizGet(SILHDR_TABLE_SAL_REG);

@FMT(CMP,@wizGet(SILHDR_TABLE_SAL_DET)=,,"
INSERT INTO SAL_DET_SAV (F1505,®dbCol(SAL_DET_SAV,®wizGet(SILHDR_TABLE_SAL_DET),,,,F1056;F1057;F2890),F1056,F1057,F2890)
SELECT '@dbRow(Q1,F254)',®dbCol(SAL_DET_SAV,@wizGet(SILHDR_TABLE_SAL_DET),,,,F1056;F1057),'@dbRow(Q1,F1056)','@dbRow(Q1,F1057)',GETDATE() AS F2890
FROM @wizGet(SILHDR_TABLE_SAL_DET);");

INSERT INTO SAL_TTL_SAV (F1505,@dbCol(SAL_TTL_SAV,@wizGet(SILHDR_TABLE_SAL_TTL),,,,F1056;F1057;F2890),F1056,F1057,F2890)
SELECT '@dbRow(Q1,F254)',@dbCol(SAL_TTL_SAV,@wizGet(SILHDR_TABLE_SAL_TTL),,,,F1056;F1057),'@dbRow(Q1,F1056)','@dbRow(Q1,F1057)',GETDATE() AS F2890
FROM @wizGet(SILHDR_TABLE_SAL_TTL);

/* FLAG REFUNDED ITEM IN ORIGINAL TRANSACTION */
DECLARE TMP_REFUND CURSOR FOR 
SELECT F1081=REPLACE(SUBSTRING(F1081,CHARINDEX('SKU=PLUGIN.REFUND',F1081)+18,255),',',':')+':',ABS(F64),ISNULL(F1070,'0') FROM @WIZGET(SILHDR_TABLE_SAL_REG) WHERE F1081 LIKE '%SKU=PLUGIN.REFUND%' AND '@DBROW(Q1,F1068)'<>'VOIDED' AND F1069<>1
OPEN TMP_REFUND DECLARE @F64 FLOAT,@NEWF64 FLOAT,@F1081 VARCHAR(255),@F1505 DATETIME,@F1056 VARCHAR(4),@F1057 VARCHAR(3),@F1032 INTEGER,@F1101 INTEGER,@F1070 VARCHAR(1)
DECLARE @LOOP INTEGER 
FETCH NEXT FROM TMP_REFUND INTO @F1081,@F64,@F1070
SET @LOOP=@@FETCH_STATUS
WHILE @LOOP = 0 
BEGIN
 SET @F1505=CONVERT(DATETIME,SUBSTRING(@F1081,1,CHARINDEX(':',@F1081)-1))
 SET @F1081=SUBSTRING(@F1081,CHARINDEX(':',@F1081)+1,255)   
 SET @F1056=SUBSTRING(@F1081,1,CHARINDEX(':',@F1081)-1)
 SET @F1081=SUBSTRING(@F1081,CHARINDEX(':',@F1081)+1,255)   
 SET @F1057=SUBSTRING(@F1081,1,CHARINDEX(':',@F1081)-1)
 SET @F1081=SUBSTRING(@F1081,CHARINDEX(':',@F1081)+1,255)   
 SET @F1032=CAST(SUBSTRING(@F1081,1,CHARINDEX(':',@F1081)-1) AS INTEGER)
 SET @F1081=SUBSTRING(@F1081,CHARINDEX(':',@F1081)+1,255)   
 SET @F1101=CAST(SUBSTRING(@F1081,1,CHARINDEX(':',@F1081)-1) AS INTEGER)
 SET @F1081=SUBSTRING(@F1081,CHARINDEX(':',@F1081)+1,255)   
/*
*/
 SELECT @NEWF64=ISNULL(dbo.Sms_tools_comaparambyname(ISNULL(F1081,''),'PLUGIN.REFUND.QTY'),0) 
 FROM SAL_REG_SAV
  WHERE F1505=@F1505 AND RIGHT('0000'+F1056,4)=RIGHT('0000'+@F1056,4) AND F1057=@F1057 AND F1032=@F1032 AND F1101=@F1101
 SELECT @F64=CASE WHEN ('@DBROW(Q1,F1068)'='REFUND' AND @F1070='0') OR ('@DBROW(Q1,F1068)'='SALE' AND @F1070<>'0') THEN @NEWF64+@F64 ELSE CASE WHEN @NEWF64=0 THEN @F64 ELSE @NEWF64-@F64 END END
 UPDATE SAL_REG_SAV SET F1081=dbo.Sms_tools_comaparamdelete(ISNULL(F1081,''),'PLUGIN.REFUND.QTY')+CASE WHEN CHARINDEX('PLUGIN.REFUND=1',F1081)=0 THEN ',PLUGIN.REFUND=1' END+',PLUGIN.REFUND.QTY='+CAST(@F64 AS VARCHAR)
  WHERE F1505=@F1505 AND RIGHT('0000'+F1056,4)=RIGHT('0000'+@F1056,4) AND F1057=@F1057 AND F1032=@F1032 AND F1101=@F1101
 FETCH NEXT FROM TMP_REFUND INTO @F1081,@F64,@F1070
 SET @LOOP=@@FETCH_STATUS
END 
CLOSE TMP_REFUND DEALLOCATE TMP_REFUND;

/* INSERT INTO KINNEY_TRS_ADD TABLE */
BEGIN
 BEGIN TRY
  BEGIN TRANSACTION
   INSERT INTO KINNEY_TRS_ADD (F1001,F254,F1056,F1057,F1032,F1101,F1036,F01,F154,F64,F65) 
   SELECT 1 AS F1001, HDR.F254,HDR.F1056,HDR.F1057,HDR.F1032,REG.F1101,HDR.F1036,REG.F01
   ,CASE WHEN CHARINDEX('ALT',REG.F1081)>0 THEN SUBSTRING(REG.F1081,CHARINDEX('ALT',REG.F1081)+4,CHARINDEX(',',REG.F1081,CHARINDEX('ALT',REG.F1081))-(CHARINDEX('ALT',REG.F1081)+4)) END AS F154
   ,CASE 
	WHEN HDR.F1068='REFUND' AND (ISNULL(F1874,0)!=2 OR ISNULL(F1204,0)=0) THEN -1*F64 
	WHEN HDR.F1068='REFUND' AND ISNULL(F1874,0)=2 AND ISNULL(F1204,0)!=0 THEN -1*F64/F1204 
	WHEN HDR.F1068!='REFUND' AND (ISNULL(F1874,0)!=2 OR ISNULL(F1204,0)=0) THEN F64 
	WHEN HDR.F1068!='REFUND' AND ISNULL(F1874,0)=2 AND ISNULL(F1204,0)!=0 THEN F64/F1204
	END
   ,CASE WHEN HDR.F1068='REFUND' THEN -1*F65 ELSE F65 END AS F65
   FROM @WIZGET(SILHDR_TABLE_SAL_HDR) HDR JOIN @WIZGET(SILHDR_TABLE_SAL_REG) REG ON REG.F1032=HDR.F1032
   WHERE (HDR.F1068='SALE' OR HDR.F1068='REFUND') AND ISNULL(REG.F1069,0)=0 AND REG.F1067='ITEM'
  COMMIT
 END TRY
 BEGIN CATCH
  IF @@TRANCOUNT > 0
   ROLLBACK
 END CATCH
END;
DROP TABLE @WIZGET(SILHDR_TABLE_SAL_HDR);;
DROP TABLE @WIZGET(SILHDR_TABLE_SAL_REG);;
@FMT(CMP,@wizGet(SILHDR_TABLE_SAL_DET)=,,"DROP TABLE @wizGet(SILHDR_TABLE_SAL_DET);");;
DROP TABLE @WIZGET(SILHDR_TABLE_SAL_TTL);;

@DBHOT(MSSQL,COMMIT);

