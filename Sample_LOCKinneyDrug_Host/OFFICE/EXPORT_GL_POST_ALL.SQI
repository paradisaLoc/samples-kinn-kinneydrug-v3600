@WIZSET(TARGET=RAL);
@WIZSET(DETAIL=D);
@WIZSET(START=@DSDF);
@WIZSET(STOP=@DSDF);

/* TEMP TABLE CONTAINING DAYS EXPORTED */

@WIZRPL(POST_TAB=TMP_@STORE@TER@fmt(R2,'@dbhot(regGen,TMPDB,1,30)'));

CREATE TABLE @WIZGET(POST_TAB) (@DBDCT(F254,F990));

INSERT INTO @WIZGET(POST_TAB) (F254,F990) 
SELECT F254,F990 FROM TRS_LOG WHERE SUBSTRING(F990,1,8)='GLEXPORT' AND
SUBSTRING(F990,10,1)='@WIZGET(DETAIL)' AND SUBSTRING(F990,12,3)='@WIZGET(TARGET)' AND '@WIZGET(INCLUDEPOSTED)'!='1';

@TOOLS(SECUREEXEC,trs_exp_gl_post_all,DBT\EXP_TMP@WIZGET(TARGET).SQI);