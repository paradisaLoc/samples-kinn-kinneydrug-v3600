INSERT INTO HEADER_DCT VALUES
('HC','00000001','001901','PAL',,,1997001,0000,1997001,0001,,'LOAD','CREATE DCT',,,,,,'1/1.0','V1.0',,);

CREATE TABLE COST_DCT(@MAP_FROM_QUERY);

INSERT INTO HEADER_DCT VALUES
('HM','00000001','001901','PAL',,,1997001,0000,1997001,0001,,'ADDRPL','@WIZGET(F913)',,,,,,'1/1.0','V1.0','F01+F1000+F27',);

CREATE VIEW COST_CHG AS SELECT @FIELDS_FROM_QUERY FROM COSCE_DCT;

INSERT INTO COST_CHG VALUES

/* EXTRACT SECTION */

@WIZSET(STYLE=SIL);
@WIZRPL(F913=KINNEY DRUG NEW ITEM LOCATION);
@WIZSET(TARGET=901);
@WIZRPL(FORCE_F1000=@F1000);
@WIZSET(KD.DEPLOY_TABLE=TMP_TABLE);

@MAP_DEPLOY
SELECT @DBFLD(COST_TAB,TCOS.,F1964),NULL AS F1964 FROM
(
	SELECT TMP.F1056 AS F1000,@DBFLD(COST_TAB,COS.,'F1000'),ROW_NUMBER() OVER (PARTITION BY COS.F01,COS.F27,TMP.F1056 ORDER BY COS.F01,COS.F27,TMP.F1056) AS F1301
	FROM @WIZGET(KD.DEPLOY_TABLE) TMP 
	JOIN COST_TAB COS ON TMP.F01=COS.F01 AND TMP.F27=COS.F27 AND COS.F1000 IN (SELECT F1056 FROM STD_TAB WHERE F1545=(SELECT F1545 FROM STD_TAB WHERE F1056=TMP.F1056))
) TCOS WHERE F1301=1;


