/* ONLY FOR COST_TAB */
@FMT(CMP,@WIZGET(CREATE_TRIGGER_TABLE)=COST_TAB,,'®FMT(CHR,27)');

/* ADD OR REMOVE 'C' TO INVENTORY FIELD IN COST_TAB WHEN F1976(COMMENT FIELD) CHANGED */

IF OBJECT_ID('TRIG_COST_F1976') IS NOT NULL
 DROP TRIGGER TRIG_COST_F1976;

CREATE TRIGGER TRIG_COST_F1976
ON COST_TAB 
AFTER UPDATE
AS
BEGIN
  IF (UPDATE(F1976)) 
   BEGIN 
     UPDATE COS 
	 SET COS.F1875 = CASE WHEN ISNULL(LTRIM(COS.F1976),'')='' THEN '' ELSE 'C' END
     FROM COST_TAB COS 
     INNER JOIN INSERTED INS ON COS.F01=INS.F01 AND COS.F27=INS.F27 AND COS.F1184=INS.F1184 AND COS.F1000=INS.F1000
     WHERE INS.F902='MANUAL'  
   END 
END;