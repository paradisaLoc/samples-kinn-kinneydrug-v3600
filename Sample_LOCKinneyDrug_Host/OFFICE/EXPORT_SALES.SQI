@WIZSET(F1057=961);

@WIZINIT;
@WIZDETAIL(DETAIL=D);
@WIZDATES(START,STOP);
@WIZTARGET(TARGET=RAL,SELECT STO.F1000,STO.F1018
FROM STO_TAB STO JOIN LNK_TAB LNK ON LNK.F1000=STO.F1000
WHERE LNK.F1057='@wizget(F1057)' ORDER BY STO.F1000);
@WIZDISPLAY;

@WIZRPL(SESSION=@STORE@TER@FMT(R2,@dbHot(regGen,TMPDB,1,30)));

CREATE VIEW TMP_@WIZGET(SESSION) AS SELECT F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302 FROM ITEM_DCT;

/* DELETE THE 2 FOLLOWING COMMANDS IF SUB DEPARTMENTS ARE NOT USED */

/* SUB DEPARTMENT DEBIT */ 

INSERT INTO TMP_@WIZGET(SESSION) 
(F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302)
SELECT ACC.F1000,TRS.F254,'SUB',CAST(MAX(TRS.F04) as CHAR(13)), TRS.F1034,
CAST(MAX(DPT.F1022+'/'+TLZ.F1039) as CHAR(40)) AS F1039,
MAX(ACC.F1130) AS F1130,MAX(ACC.F1253) AS F1253, 
SUM(TRS.F65) AS F65,0
FROM ACC_TAB ACC, RPT_SUB TRS, LNK_TAB LNK, TLZ_TAB TLZ, SDP_TAB DPT
WHERE ACC.F1000='@WIZGET(TARGET)' AND
ACC.F1033='SUB' AND ACC.F1068='GL' AND
ACC.F1253='D' AND
ACC.F1130<>'' AND
TRS.F1031='@WIZGET(DETAIL)' AND
TRS.F254>='@WIZGET(START)' AND
TRS.F254<='@WIZGET(STOP)' AND
TRS.F1034=ACC.F1034 AND
CAST(TRS.F04 as CHAR(10))=ACC.F01 AND
TRS.F1056=LNK.F1056 AND
TRS.F1057=LNK.F1057 AND
LNK.F1000='@WIZGET(TARGET)' AND
TLZ.F1034=TRS.F1034 AND
DPT.F04=TRS.F04
GROUP BY ACC.F1000,TRS.F254,TRS.F04,TRS.F1034
HAVING SUM(TRS.F65) IS NOT NULL;

/* SUB DEPARTMENT CREDIT */ 

INSERT INTO TMP_@WIZGET(SESSION) 
(F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302)
SELECT ACC.F1000,TRS.F254,'SUB', CAST(MAX(TRS.F04) as CHAR(13)), TRS.F1034,
CAST(MAX(DPT.F1022+'/'+TLZ.F1039) as CHAR(40)) AS F1039,
MAX(ACC.F1130) AS F1130,MAX(ACC.F1253) AS F1253, 
0,SUM(TRS.F65) AS F65
FROM ACC_TAB ACC, RPT_SUB TRS, LNK_TAB LNK, TLZ_TAB TLZ, SDP_TAB DPT
WHERE ACC.F1000='@WIZGET(TARGET)' AND
ACC.F1033='SUB' AND ACC.F1068='GL' AND
ACC.F1253='C' AND
ACC.F1130<>'' AND
TRS.F1031='@WIZGET(DETAIL)' AND
TRS.F254>='@WIZGET(START)' AND
TRS.F254<='@WIZGET(STOP)' AND
TRS.F1034=ACC.F1034 AND
CAST(TRS.F04 as CHAR(10))=ACC.F01 AND
TRS.F1056=LNK.F1056 AND
TRS.F1057=LNK.F1057 AND
LNK.F1000='@WIZGET(TARGET)' AND
TLZ.F1034=TRS.F1034 AND
DPT.F04=TRS.F04
GROUP BY ACC.F1000,TRS.F254,TRS.F04,TRS.F1034
HAVING SUM(TRS.F65) IS NOT NULL;

/* DELETE THE 2 FOLLOWING COMMANDS IF DEPARTMENTS ARE NOT USED */

/* DEPARTMENT DEBIT */

INSERT INTO TMP_@WIZGET(SESSION) 
(F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302)
SELECT ACC.F1000,TRS.F254,'DPT',CAST(MAX(TRS.F03) as CHAR(13)),TRS.F1034,
CAST(MAX(DPT.F238+'/'+TLZ.F1039) as CHAR(40)) AS F1039,
MAX(ACC.F1130) AS F1130,MAX(ACC.F1253) AS F1253, 
SUM(TRS.F65) AS F65,0
FROM ACC_TAB ACC, RPT_DPT TRS, LNK_TAB LNK, TLZ_TAB TLZ, DEPT_TAB DPT
WHERE ACC.F1000='@WIZGET(TARGET)' AND
ACC.F1033='DPT' AND ACC.F1068='GL' AND
ACC.F1253='D' AND
ACC.F1130<>'' AND
TRS.F1031='@WIZGET(DETAIL)' AND
TRS.F254>='@WIZGET(START)' AND
TRS.F254<='@WIZGET(STOP)' AND
TRS.F1034=ACC.F1034 AND
CAST(TRS.F03 as CHAR(10))=ACC.F01 AND
TRS.F1056=LNK.F1056 AND
TRS.F1057=LNK.F1057 AND
LNK.F1000='@WIZGET(TARGET)' AND
TLZ.F1034=TRS.F1034 AND
DPT.F03=TRS.F03
GROUP BY ACC.F1000,TRS.F254,TRS.F03,TRS.F1034
HAVING SUM(TRS.F65) IS NOT NULL;

/* DEPARTMENT CREDIT */

INSERT INTO TMP_@WIZGET(SESSION) 
(F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302)
SELECT ACC.F1000,TRS.F254,'DPT', CAST(MAX(TRS.F03) as CHAR(13)), TRS.F1034,
CAST(MAX(DPT.F238+'/'+TLZ.F1039) as CHAR(40)) AS F1039,
MAX(ACC.F1130) AS F1130,MAX(ACC.F1253) AS F1253, 
0,SUM(TRS.F65) AS F65
FROM ACC_TAB ACC, RPT_DPT TRS, LNK_TAB LNK, TLZ_TAB TLZ, DEPT_TAB DPT
WHERE ACC.F1000='@WIZGET(TARGET)' AND
ACC.F1033='DPT' AND ACC.F1068='GL' AND
ACC.F1253='C' AND
ACC.F1130<>'' AND
TRS.F1031='@WIZGET(DETAIL)' AND
TRS.F254>='@WIZGET(START)' AND
TRS.F254<='@WIZGET(STOP)' AND
TRS.F1034=ACC.F1034 AND
CAST(TRS.F03 as CHAR(10))=ACC.F01 AND
TRS.F1056=LNK.F1056 AND
TRS.F1057=LNK.F1057 AND
LNK.F1000='@WIZGET(TARGET)' AND
TLZ.F1034=TRS.F1034 AND
DPT.F03=TRS.F03
GROUP BY ACC.F1000,TRS.F254,TRS.F03,TRS.F1034
HAVING SUM(TRS.F65) IS NOT NULL;

/* GROUPE DEBIT */

INSERT INTO TMP_@WIZGET(SESSION) 
(F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302) 
SELECT ACC.F1000,TRS.F254,'GRP',CAST(MAX(DPT.F1132) as CHAR(13)) AS F01,TRS.F1034,
CAST(MAX(DPT.F1132+'/'+TLZ.F1039) as CHAR(40)) AS F1039,
MAX(ACC.F1130) AS F1130,MAX(ACC.F1253) AS F1253,SUM(TRS.F65) AS F65,
0 
FROM ACC_TAB ACC, RPT_DPT TRS, LNK_TAB LNK, TLZ_TAB TLZ, 
DEPT_TAB DPT 
WHERE ACC.F1000='@WIZGET(TARGET)' AND
ACC.F1033='GRP' AND ACC.F1068='GL' AND
ACC.F1253='D' AND
ACC.F1130<>'' AND
ACC.F01=CAST(DPT.F1132 as CHAR(13)) AND
TRS.F1031='@WIZGET(DETAIL)' AND
TRS.F254>='@WIZGET(START)' AND
TRS.F254<='@WIZGET(STOP)' AND
TRS.F1034=ACC.F1034 AND
TRS.F03=DPT.F03 AND
TRS.F1056=LNK.F1056 AND
TRS.F1057=LNK.F1057 AND
LNK.F1000='@WIZGET(TARGET)' AND
TRS.F1034=TLZ.F1034
GROUP BY ACC.F1000,TRS.F254,DPT.F1132,TRS.F1034
HAVING SUM(TRS.F65) IS NOT NULL;

/* GROUPE CREDIT */

INSERT INTO TMP_@WIZGET(SESSION) 
(F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302) 
SELECT ACC.F1000,TRS.F254,'GRP',CAST(MAX(DPT.F1132) as CHAR(13)) AS F01,TRS.F1034,
CAST(MAX(DPT.F1132+'/'+TLZ.F1039) as CHAR(40)) AS F1039,
MAX(ACC.F1130) AS F1130,MAX(ACC.F1253) AS F1253,0,SUM(TRS.F65) AS F65
FROM ACC_TAB ACC, RPT_DPT TRS, LNK_TAB LNK, TLZ_TAB TLZ, 
DEPT_TAB DPT 
WHERE ACC.F1000='@WIZGET(TARGET)' AND
ACC.F1033='GRP' AND ACC.F1068='GL' AND
ACC.F1253='C' AND
ACC.F1130<>'' AND
ACC.F01=CAST(DPT.F1132 as CHAR(13)) AND
TRS.F1031='@WIZGET(DETAIL)' AND
TRS.F254>='@WIZGET(START)' AND
TRS.F254<='@WIZGET(STOP)' AND
TRS.F1034=ACC.F1034 AND
TRS.F03=DPT.F03 AND
TRS.F1056=LNK.F1056 AND
TRS.F1057=LNK.F1057 AND
LNK.F1000='@WIZGET(TARGET)' AND
TRS.F1034=TLZ.F1034
GROUP BY ACC.F1000,TRS.F254,DPT.F1132,TRS.F1034
HAVING SUM(TRS.F65) IS NOT NULL;

/* FINANCIAL DEBIT */

INSERT INTO TMP_@WIZGET(SESSION) 
(F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302)
SELECT ACC.F1000,TRS.F254,'FIN','1',TRS.F1034,
MAX(TLZ.F1039) AS F1039,
MAX(ACC.F1130) AS F1130,MAX(ACC.F1253) AS F1253, 
SUM(TRS.F65) AS F65,0
FROM ACC_TAB ACC, RPT_FIN TRS, LNK_TAB LNK, TLZ_TAB TLZ
WHERE ACC.F1000='@WIZGET(TARGET)' AND
ACC.F1033='FIN' AND ACC.F1068='GL' AND
ACC.F1253='D' AND 
ACC.F1130<>'' AND
ACC.F01='1' AND
TRS.F1031='@WIZGET(DETAIL)' AND
TRS.F254>='@WIZGET(START)' AND
TRS.F254<='@WIZGET(STOP)' AND
TRS.F1034=ACC.F1034 AND
TRS.F1056=LNK.F1056 AND
TRS.F1057=LNK.F1057 AND
LNK.F1000='@WIZGET(TARGET)' AND
TLZ.F1034=TRS.F1034
GROUP BY ACC.F1000,TRS.F254,TRS.F1034
HAVING SUM(TRS.F65) IS NOT NULL;

/* FINANCIAL CREDIT */

INSERT INTO TMP_@WIZGET(SESSION) 
(F1000,F254,F1033,F01,F1034,F1039,F1130,F1253,F1301,F1302)
SELECT ACC.F1000,TRS.F254,'FIN','1',TRS.F1034,
MAX(TLZ.F1039) AS F1039,
MAX(ACC.F1130) AS F1130,MAX(ACC.F1253) AS F1253, 
0,SUM(TRS.F65) AS F65
FROM ACC_TAB ACC, RPT_FIN TRS, LNK_TAB LNK, TLZ_TAB TLZ
WHERE ACC.F1000='@WIZGET(TARGET)' AND
ACC.F1033='FIN' AND ACC.F1068='GL' AND
ACC.F1253='C' AND 
ACC.F1130<>'' AND
ACC.F01='1' AND
TRS.F1031='@WIZGET(DETAIL)' AND
TRS.F254>='@WIZGET(START)' AND
TRS.F254<='@WIZGET(STOP)' AND
TRS.F1034=ACC.F1034 AND
TRS.F1056=LNK.F1056 AND
TRS.F1057=LNK.F1057 AND
LNK.F1000='@WIZGET(TARGET)' AND
TLZ.F1034=TRS.F1034
GROUP BY ACC.F1000,TRS.F254,TRS.F1034
HAVING SUM(TRS.F65) IS NOT NULL;

/* CALCULATED UNGROUPED ITEM TOTAL */

@WIZRPL(TTL_DPT=@DBSELECT(SELECT SUM(F1302)-SUM(F1301)
FROM TMP_@WIZGET(SESSION) WHERE F1034=3 AND F1033<>'FIN'));

/* CLEANUP THE POSTING TABLE */

UPDATE TMP_@WIZGET(SESSION) SET F1301=-F1302,F1302=0 WHERE F1302<0;
UPDATE TMP_@WIZGET(SESSION) SET F1302=-F1301,F1301=0 WHERE F1301<0;
UPDATE TMP_@WIZGET(SESSION) SET F1302=F1302-0@WIZGET(TTL_DPT) WHERE F1034=3 AND F1033='FIN';
DELETE FROM TMP_@WIZGET(SESSION) WHERE F1301=0 and F1302=0;
