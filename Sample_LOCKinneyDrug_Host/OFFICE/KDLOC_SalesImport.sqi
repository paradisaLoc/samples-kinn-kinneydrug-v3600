@WIZRPL(TRANS_LIST=SAL_HDR_SUS@TER);
@CREATE(@WIZGET(TRANS_LIST),HDRSAL);

UPDATE HDR SET HDR.F254=T10.F254,F1067='CLOSE',F902='IMPORTED'
FROM SAL_HDR HDR
JOIN TRANS10 T10 ON T10.F1056=HDR.F1056 AND T10.F1057=HDR.F1057 AND T10.F1032=HDR.F1764
WHERE HDR.F1032>1000000 AND HDR.F902 IS NULL AND CAST(T10.F254 AS DATETIME)='@WIZGET(F254)' AND HDR.F1056='@WIZGET(F1056)';

INSERT INTO @WIZGET(TRANS_LIST) (@dbfld(sal_hdr)) 
SELECT @dbfld(sal_hdr) FROM SAL_HDR@WIZGET(TRANS_LOCAL)
WHERE F1032>1000000 AND F902='IMPORTED';

UPDATE SAL_HDR SET F902='DONE' WHERE F902='IMPORTED';