/* SAVE ALL PARAMETERS */
@DBHOT(HOT_WIZ,PARAMTOLINE,DEFAULT_PARAMSAV);

@WIZSET(DEFAULTTABLE=M@WIZGET(SOURCE)@WIZGET(BATCH));

@WIZSET(DEFAULTFLD=);
/* DEFAULTJOB=ADD,ADDRPL,CHANGE,UPDATE */
@WIZSET(DEFAULTJOB=);
@WIZSET(DROPFLD=);
@WIZSET(DEFAULTSETNULL=1);
@WIZSET(DEFAULTMATCHBATCH=0);

/* SET NULL */
@FMT(CMP,@WIZGET(DEFAULTSETNULL)=1,"DECLARE @DATATYPE VARCHAR(50)
DECLARE @NAME VARCHAR(50)
DECLARE @FLDLEN INTEGER
DECLARE FLDLIST INSENSITIVE CURSOR FOR
 SELECT COLUMN_NAME,DATA_TYPE,CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='@WIZGET(DEFAULTTABLE)'
OPEN FLDLIST
FETCH NEXT FROM FLDLIST INTO @NAME,@DATATYPE,@FLDLEN
WHILE (@@FETCH_STATUS=0)
BEGIN
  IF (CHARINDEX('CHAR',@DATATYPE)>0)
   BEGIN   
     IF (@FLDLEN>1)
      EXEC('UPDATE @WIZGET(DEFAULTTABLE) SET '+@NAME+'=NULL WHERE (ISNUMERIC('+@NAME+')=1 AND CHARINDEX(''.'','+@NAME+')=0 AND CAST('+@NAME+' AS BIGINT)=0) OR '+@NAME+'=''''')
   END
  ELSE
   EXEC('UPDATE @WIZGET(DEFAULTTABLE) SET '+@NAME+'=NULL WHERE '+@NAME+'=0')
  FETCH NEXT FROM FLDLIST INTO @NAME,@DATATYPE,@FLDLEN
END
CLOSE FLDLIST
DEALLOCATE FLDLIST;");

/* UPDATE HEADER FIELDS */
DECLARE @DEFAULTFLD VARCHAR(1000)
DECLARE @SQLCHG VARCHAR(8000)
DECLARE @S1 VARCHAR(1000)
DECLARE @S2 VARCHAR(1000)
DECLARE @FLD VARCHAR(1000)
DECLARE @VALUE VARCHAR(1000)
DECLARE @FLDLST VARCHAR(1000)
SET @DEFAULTFLD=REPLACE(REPLACE('@WIZGET(DEFAULTHDRFLD)',CHAR(13),CHAR(3)),CHAR(10),'')+CHAR(3)
SET @FLDLST='@DBFLD(HEADER_DCT),'
SET @SQLCHG=''
SET @S1=SUBSTRING(@DEFAULTFLD,1,CHARINDEX(CHAR(3),@DEFAULTFLD)-1)
SET @DEFAULTFLD=SUBSTRING(@DEFAULTFLD,CHARINDEX(CHAR(3),@DEFAULTFLD)+1,1000)
WHILE (@S1<>'') 
BEGIN
  SET @FLD=SUBSTRING(@S1,1,CHARINDEX('=',@S1)-1)
  SET @VALUE=SUBSTRING(@S1,CHARINDEX('=',@S1)+1,1000)
  IF (CHARINDEX(@FLD+',',@FLDLST)>0) AND (CHARINDEX(@FLD+'=',@SQLCHG)=0) 
   BEGIN
     SET @S2=@FLD+'='+CASE WHEN CHARINDEX(@VALUE+',',@FLDLST)>0 THEN ''''+@VALUE+'''' WHEN ISNUMERIC(@VALUE)=1 THEN ''''+@VALUE+'''' ELSE ''''+@VALUE+'''' END
     IF @SQLCHG<>''
      SET @SQLCHG=@SQLCHG+','+@S2
     ELSE
      SET @SQLCHG=@S2
   END 
  IF LEN(@DEFAULTFLD)>2 
   BEGIN
     SET @S1=SUBSTRING(@DEFAULTFLD,1,CHARINDEX(CHAR(3),@DEFAULTFLD)-1) 
     SET @DEFAULTFLD=SUBSTRING(@DEFAULTFLD,CHARINDEX(CHAR(3),@DEFAULTFLD)+1,1000) 
   END
  ELSE SET @S1=''   
END
IF @SQLCHG<>''
 EXECUTE('UPDATE HEADER_DCT SET '+@SQLCHG+' WHERE ''@WIZGET(DEFAULTTABLE)''=''M''+F903+F902');

/* ADD DEFAULT FIELDS */
DECLARE @DEFAULTFLD VARCHAR(1000)
DECLARE @SQLADD VARCHAR(8000)=''
DECLARE @SQLCHG VARCHAR(8000)=''
DECLARE @SQLHDR VARCHAR(8000)=''
DECLARE @S1 VARCHAR(1000)
DECLARE @S2 VARCHAR(1000)
DECLARE @FLD VARCHAR(1000)
DECLARE @VALUE VARCHAR(1000)
DECLARE @FLDLST VARCHAR(1000)
DECLARE @bEXIST INTEGER
DECLARE @bHEADERFLD INTEGER=0
SET @DEFAULTFLD=REPLACE(REPLACE("@WIZGET(DEFAULTFLD)",CHAR(13),CHAR(3)),CHAR(10),'')
SET @DEFAULTFLD=REPLACE(REPLACE(@DEFAULTFLD,']',')'),'[','(')+CHAR(3)
SET @DEFAULTFLD=REPLACE(@DEFAULTFLD,'&quot;','"')
SET @FLDLST=',@DBFLD(@WIZGET(DEFAULTTABLE)),'
IF LEN(@DEFAULTFLD)>2 
 BEGIN
   SET @S1=SUBSTRING(@DEFAULTFLD,1,CHARINDEX(CHAR(3),@DEFAULTFLD)-1) 
   SET @DEFAULTFLD=SUBSTRING(@DEFAULTFLD,CHARINDEX(CHAR(3),@DEFAULTFLD)+1,1000) 
 END
ELSE SET @S1=''   
WHILE (@S1<>'') AND ('@WIZGET(DEFAULTJOB)'<>'')
BEGIN
  SET @FLD=SUBSTRING(@S1,1,CHARINDEX('=',@S1)-1)
  SET @VALUE=SUBSTRING(@S1,CHARINDEX('=',@S1)+1,1000)
/* 
  AVOID ADDING HEADER FIELDS 
*/  
  IF (SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='HEADER_DCT' AND @VALUE<>'F1000' AND @VALUE IN (COLUMN_NAME))>0
   SET @bHEADERFLD=3
  IF (SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='HEADER_DCT' AND @FLD<>'F1000' AND @FLD IN (COLUMN_NAME))>0
   SET @bEXIST=2
  ELSE
  IF CHARINDEX(','+@FLD+',',@FLDLST)>0
   SET @bEXIST=1
  ELSE SET @bEXIST=0
/*
  DETECT IF VALUE IS FIELD OR STRING
*/  
  IF (@bHEADERFLD=0) AND ((SELECT SCALE FROM SYSCOLUMNS WHERE ID=OBJECT_ID('@WIZGET(DEFAULTTABLE)') AND NAME=@FLD) IS NULL)
   IF CHARINDEX('''',@VALUE)=0 
    IF CHARINDEX('"',@VALUE)=0  
     IF CHARINDEX(','+@VALUE+',',@FLDLST)=0 
      SET @VALUE='"'+@VALUE+'"'
/* 
   DETECT DATATYPE 
*/
  SET @S2='VARCHAR(255)'
  IF (SUBSTRING(@FLD,1,1)='F')
   BEGIN
     SET @S1=(SELECT TOP 1 DATA_TYPE FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='@WIZGET(DEFAULTTABLE)' AND COLUMN_NAME=@VALUE)
     IF ISNULL(@S1,'')='' SELECT TOP 1 @S1=F1458 FROM RB_FIELDS WHERE F1453=@FLD
     IF CHARINDEX('DATETIME',@S1)>0 SET @S2='DATETIME'  
   END
/*
   DETECT IF FIELD EXIST, DO UPDATE INSTEAD OF ADDING
*/  
  IF (@bEXIST=0) AND ('@WIZGET(DEFAULTJOB)' IN ('ADDRPL','ADD'))
   BEGIN
     IF @SQLADD<>''
      SET @SQLADD=@SQLADD+','+@FLD+' '+@S2 
     ELSE
      SET @SQLADD=@FLD+' '+@S2
   END
/*
   DETECT IF FIELD EXIST, ADD THE FIELD
*/  
  IF (@bHEADERFLD=0) AND (((@bEXIST=1) AND ('@WIZGET(DEFAULTJOB)' IN ('ADDRPL','CHANGE','UPDATE'))) OR ((@bEXIST=0) AND ('@WIZGET(DEFAULTJOB)' IN ('ADD','ADDRPL'))))
   BEGIN
     SET @S2=@FLD+'='+CASE WHEN '@WIZGET(DEFAULTJOB)'='UPDATE' THEN 'CASE WHEN '+@FLD+' IS NULL THEN '+@VALUE+' ELSE '+@FLD+' END' ELSE @VALUE END
     IF @SQLCHG<>''
      SET @SQLCHG=@SQLCHG+','+@S2
     ELSE
      SET @SQLCHG=@S2
   END 
/* 
  UPDATE FROM HEADER 
*/
  IF (@bHEADERFLD=3) 
   BEGIN
     SET @S2=@FLD+'=HDR.'+@VALUE
     IF @SQLHDR<>''
      SET @SQLHDR=@SQLHDR+','+@S2
     ELSE
      SET @SQLHDR=@S2
   END 
  IF LEN(@DEFAULTFLD)>2 
   BEGIN
     SET @S1=SUBSTRING(@DEFAULTFLD,1,CHARINDEX(CHAR(3),@DEFAULTFLD)-1) 
     SET @DEFAULTFLD=SUBSTRING(@DEFAULTFLD,CHARINDEX(CHAR(3),@DEFAULTFLD)+1,1000) 
   END
  ELSE SET @S1=''   
END
IF @SQLADD<>''
 EXECUTE('ALTER TABLE @WIZGET(DEFAULTTABLE) ADD '+@SQLADD)
IF @SQLCHG<>''
 EXECUTE('UPDATE @WIZGET(DEFAULTTABLE) SET '+@SQLCHG)
IF @SQLHDR<>''
 EXECUTE('UPDATE BAT SET '+@SQLHDR+' FROM @WIZGET(DEFAULTTABLE) BAT JOIN HEADER_DCT HDR ON HDR.F903=''@WIZGET(SOURCE)'' AND HDR.F902=''@WIZGET(BATCH)'';');

/* APPLY FIELD EXCLUSIONS */
DECLARE @EXCLUDE VARCHAR(1000)
DECLARE @FLDLST VARCHAR(1000)
DECLARE @FLD VARCHAR(1000)
SET @FLDLST='@DBFLD(@WIZGET(DEFAULTTABLE)),'
SET @EXCLUDE=',@WIZGET(DROPFLD),'
WHILE (@FLDLST<>'') AND ('@WIZGET(DROPFLD)'<>'')
BEGIN
  IF SUBSTRING(@FLDLST,1,1)=',' SET @FLDLST=''
  SET @FLD=SUBSTRING(@FLDLST,1,CHARINDEX(',',@FLDLST)-1)
  IF (CHARINDEX(','+@FLD+',',@EXCLUDE)>0)
   EXEC('ALTER TABLE @WIZGET(DEFAULTTABLE) DROP COLUMN '+@FLD)
  IF LEN(@FLDLST)>2 
   SET @FLDLST=SUBSTRING(@FLDLST,CHARINDEX(',',@FLDLST)+1,1000) 
  ELSE SET @FLDLST=''
END

@WIZRESET; 
@DBHOT(HOT_WIZ,LINETOPARAM,DEFAULT_PARAMSAV);
@DBHOT(HOT_WIZ,CLR,DEFAULT_PARAMSAV);
