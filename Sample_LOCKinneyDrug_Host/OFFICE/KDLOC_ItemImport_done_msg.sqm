@FMT(CMP,@DBHOT(APPLICATION)=WIN,'®FMT(CHR,27)');
@WIZSET(TARGET=901);

@WIZINIT;
@WIZTARGET(TARGET=,SELECT F1000,F1018 FROM STO_TAB WHERE F1000>'900' AND F1000<'999');
@WIZDISPLAY;
@WIZRPL(FILE=XF@DBHOT(REDIRMAIL)\Z@FMT(R4,@dbGen(F1059,1))@STORE.@TER);
@WIZSET(MESSAGE=Kinney Drugs Import done);
@FMT(CMP,@DBHOT(APPLICATION)=TRS,®WIZRPL(MESSAGE=+@WIZGET(MESSAGE)));

@CMD_DEPLOY
©WINMAIL(@FMT(CMP,@DBHOT(APPLICATION)=TRS,\\@DBHOT(COMPUTER)\MailSlot\PUBLIC,\\@DBHOT(COMPUTER)\MailSlot\@DBHOT(APPLICATION)@TER),@FMT(CHR,174)EXEC(MSG='@WIZGET(MESSAGE)',MSG_TYPE=1));

