@FMT(CMP,@WIZGET(CALCULATE_TABLE)=,'®EXEC(SQI=USERB_FPRICE_BAT)');

/* REPLACE V TARGET WITH STORES */
WITH TARGET_VND (F1000,F27,F1056)
AS
(
SELECT DISTINCT LNK.F1000,CASE WHEN PATINDEX('%:%',STO.F1018)>0 THEN SUBSTRING(STO.F1018,1,PATINDEX('%:%',STO.F1018)-1) END AS F27,
LNK.F1056 
FROM LNK_TAB LNK
JOIN STO_TAB STO ON LNK.F1000=STO.F1000
WHERE LNK.F1000 LIKE 'V%'
)
INSERT INTO FPRICE_BAT (F1000,@DBFLD(FPRICE_BAT,,F1000))
SELECT DISTINCT VND.F1056 AS F1000,@DBFLD(FPRICE_BAT,BAT.,F1000)
FROM FPRICE_BAT BAT 
JOIN TARGET_VND VND ON BAT.F1000=VND.F1000
JOIN (SELECT *,ROW_NUMBER() OVER(PARTITION BY F01,F1056 ORDER BY F01,F1056) AS ROW_NUMBER FROM KINNEY_VND_STORE_ITEM) STO ON STO.F01=BAT.F01 AND STO.F27=VND.F27 AND STO.F1056=VND.F1056 AND STO.ROW_NUMBER=1 
WHERE BAT.F902='@WIZGET(BATCH)'

/* DELETE ALL THE V TARGET FROM THE BATCH */
DELETE FROM FPRICE_BAT WHERE F902='@WIZGET(BATCH)' AND F1000 LIKE 'V%'

@WIZSET(SUBQUERY=SELECT DISTINCT F01 FROM FPRICE_BAT WHERE F902='@WIZGET(BATCH)');
@WIZSET(CALCULATE_TABLE=PRICE_TAB);

/* APPLY BATCH */

@UPDATE_BATCH(JOB=@WIZGET(ACTION),TAR=@WIZGET(CALCULATE_TABLE),
KEY=F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT LNK.F1056 AS F1000, @FMT(CMP,'@dbHot(INI,HOST_STORE.INI,FPRICE_BAT,EXECUTE_INCLUDE)=',
"®dbFld(FPRICE_BAT,FPRI.,'@dbHot(INI,HOST_STORE.INI,FPRICE_BAT,EXECUTE_EXCLUDE)')","®dbHot(INI,HOST_STORE.INI,FPRICE_BAT,EXECUTE_INCLUDE)") 
FROM FPRICE_BAT FPRI
JOIN LNK_TAB LNK ON LNK.F1000=FPRI.F1000
WHERE F902='@WIZGET(BATCH)'
@FMT(CMP,'@WIZGET(ACTIVATE.STORE)<>',"AND FPRI.F1000='@WIZGET(ACTIVATE.STORE)'")
@FMT(CMP,@DBHOT(INI,HOST_STORE.INI,FPRICE_BAT,ACTIVATEOWNEDONLY)=1,'AND F01 IN (SELECT PRI.F01 FROM PRICE_TAB PRI JOIN FPRICE_BAT BAT ON PRI.F01=BAT.F01 AND PRI.F1000=BAT.F1000 AND PRI.F126=BAT.F126 WHERE BAT.F902='@WIZGET(BATCH)' AND PRI.F1964='@STORE')') 
AND F01 IN (@WIZGET(SUBQUERY)));

@TOOLS(CALCNEXT,SELECT * FROM @WIZGET(CALCULATE_TABLE) WHERE F902='@WIZGET(BATCH)' @FMT(CMP,'@WIZGET(ACTIVATE.STORE)<>',"AND F1000='@WIZGET(ACTIVATE.STORE)'"));
@FMT(CMP,@WIZGET(CALCULATE_TABLE)<>PRICE_TAB,'®FMT(CHR,27)');
@WIZCLR(CALCULATE_TABLE);

/* ARCHIVE */
@WIZSET(SAVE_OLD=@dbHot(INI,HOST_STORE.INI,FPRICE_BAT,SAVE_OLD));

@UPDATE_BATCH(JOB=ADDRPL,TAR=HEADER_OLD,KEY=F902=:F902,
SRC=SELECT * FROM @WIZGET(HEADER) WHERE 
'@WIZGET(SAVE_OLD)'='1' AND 
F902='@WIZGET(BATCH)');

UPDATE HEADER_OLD SET F916='OPRICE_BAT' WHERE F902='@WIZGET(BATCH)';

@UPDATE_BATCH(JOB=ADDRPL,TAR=OPRICE_BAT,
KEY=F902=:F902 AND F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT * FROM FPRICE_BAT WHERE 
'@WIZGET(SAVE_OLD)'='1' AND 
@FMT(CMP,'@WIZGET(ACTIVATE.STORE)<>',"F1000='@WIZGET(ACTIVATE.STORE)' AND")
F902='@WIZGET(BATCH)' AND F01 IN (@WIZGET(SUBQUERY)));

@EXEC(SQI=USERE_FPRICE_BAT);

/* DELETE FUTURE BATCH */

DELETE FROM FPRICE_BAT WHERE F902='@WIZGET(BATCH)' AND @FMT(CMP,'@WIZGET(ACTIVATE.STORE)<>',"F1000='@WIZGET(ACTIVATE.STORE)' AND") F01 IN (@WIZGET(SUBQUERY));

@FMT(CMP,@DBSELECT(SELECT SUM(BAT.F1301) AS F1301 FROM (SELECT COUNT(F01) AS F1301 FROM FOBJ_BAT WHERE F902='@WIZGET(BATCH)' UNION 
SELECT COUNT(F01) AS F1301 FROM FPOS_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FPRICE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FGPRICE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FSPRICE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FTPRICE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FINSTORE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FREDEEM_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FCOST_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM ALLOW_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM REBATE_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FDISC_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FCSTBRK_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FGCOST_BAT WHERE F902='@WIZGET(BATCH)' UNION
SELECT COUNT(F01) AS F1301 FROM FBBACK_BAT WHERE F902='@WIZGET(BATCH)' UNION 
SELECT COUNT(F01) AS F1301 FROM FECL_BAT WHERE F902='@WIZGET(BATCH)' UNION 
SELECT COUNT(F01) AS F1301 FROM FPID_BAT WHERE F902='@WIZGET(BATCH)') BAT 
)=0,"DELETE FROM @WIZGET(HEADER) WHERE F902='@WIZGET(BATCH)'","UPDATE @WIZGET(HEADER) SET F914='CLOSE' WHERE F902='@WIZGET(BATCH)'");
