/* UPDATE TELEPHONE NUMBERS IN CLL_TAB */
@UPDATE_BATCH(JOB=ADD,TAR=CLL_TAB,KEY=F1577=:F1577 AND F1578=:F1578,
SRC=SELECT DISTINCT F1577,'TL' AS F1578,'MANUAL' AS F902,F1000,1 AS F1001,F1148,GETDATE() AS F253,'1' AS F1898,'@STORE' AS F1964 
FROM (SELECT dbo.fn_VerifyPhoneNumber(F1172) AS F1577,F1148,F1000 FROM CLT_TAB WHERE dbo.fn_VerifyPhoneNumber(F1172)!='' 
AND CHARINDEX(','+CAST(F1152 AS VARCHAR(3))+',',',@DBHOT(INI,KinneyDrug.ini,THRIVE,SHOPLEVEL),')>0 AND F1152 NOT IN (3,13)
EXCEPT SELECT F1577,F1148,F1000 FROM CLL_TAB WHERE F1578='TL') TL);

/* REMOVE EMPLOYEE TELEPHONE NUMBERS FROM CLL_TAB */
@UPDATE_BATCH(JOB=REMOVE,TAR=CLL_TAB,KEY=F1577=:F1577 AND F1578=:F1578,
SRC=SELECT CLL.F1577 AS F1577,CLL.F1578 AS F1578,'MANUAL' AS F902,CLL.F1000,1 AS F1001,CLL.F1148,GETDATE() AS F253,'1' AS F1898,'@STORE' AS F1964 
FROM CLL_TAB CLL JOIN CLT_TAB CLT ON CLT.F1148=CLL.F1148
WHERE CLL.F1578='TL' AND CLT.F1152 IN (3,13));