/* GENERATE A NEW BATCH FROM AN INVOICE NUMBER - ALLOW_BAT*/
@UPDATE_BATCH(JOB=ADDRPL,TAR=ALLOW_BAT,
KEY=F902=:F902 AND F01=:F01 AND F1000=:F1000 AND F27=:F27 AND F1184=F1184,
SRC=SELECT '@dbHot(HEADER_BAT,F902)' AS F902,BAT.F01,BAT.F1000,BAT.F27,BAT.F1184,BAT.F201,'@dbHot(HEADER_BAT,F909)' AS F202,'@dbHot(HEADER_BAT,F907)' AS F203,'@WIZGET(F222_TO)' AS F222,BAT.F223
    FROM ALLOW_BAT BAT 
    JOIN HEADER_BAT HDR ON BAT.F902=HDR.F902
    WHERE BAT.F222='@WIZGET(F222_FROM)' 
    UNION
    SELECT '@dbHot(HEADER_BAT,F902)' AS F902,BAT.F01,BAT.F1000,BAT.F27,BAT.F1184,BAT.F201,'@dbHot(HEADER_BAT,F909)' AS F202,'@dbHot(HEADER_BAT,F907)' AS F203,'@WIZGET(F222_TO)' AS F222,BAT.F223
    FROM OALLOW_BAT BAT 
    JOIN HEADER_OLD HDR ON BAT.F902=HDR.F902
    WHERE BAT.F222='@WIZGET(F222_FROM)' 
); 

/* GENERATE A NEW BATCH FROM AN INVOICE NUMBER - REBATE_BAT*/
@UPDATE_BATCH(JOB=ADDRPL,TAR=REBATE_BAT,
KEY=F902=:F902 AND F01=:F01 AND F1000=:F1000 AND F27=:F27 AND F1184=F1184,
SRC=SELECT '@dbHot(HEADER_BAT,F902)' AS F902,BAT.F01,BAT.F1000,BAT.F27,BAT.F1184,BAT.F201,'@dbHot(HEADER_BAT,F909)' AS F202,'@dbHot(HEADER_BAT,F907)' AS F203,'@WIZGET(F222_TO)' AS F222,BAT.F223
    FROM ALLOW_BAT BAT 
    JOIN HEADER_BAT HDR ON BAT.F902=HDR.F902
    WHERE BAT.F222='@WIZGET(F222_FROM)' 
    UNION
    SELECT '@dbHot(HEADER_BAT,F902)' AS F902,BAT.F01,BAT.F1000,BAT.F27,BAT.F1184,BAT.F201,'@dbHot(HEADER_BAT,F909)' AS F202,'@dbHot(HEADER_BAT,F907)' AS F203,'@WIZGET(F222_TO)' AS F222,BAT.F223
    FROM OALLOW_BAT BAT 
    JOIN HEADER_OLD HDR ON BAT.F902=HDR.F902
    WHERE BAT.F222='@WIZGET(F222_FROM)' 
); 

/* GENERATE A NEW BATCH FROM AN INVOICE NUMBER - FSPRICE_BAT*/
@UPDATE_BATCH(JOB=ADDRPL,TAR=FSPRICE_BAT,
KEY=F902=:F902 AND F01=:F01 AND F1000=:F1000 AND F126=:F126,
SRC=SELECT '@dbHot(HEADER_BAT,F902)' AS F902,BAT.F01,BAT.F1000,BAT.F126,BAT.F135,BAT.F136,'@dbHot(HEADER_BAT,F909)' AS F137,'@dbHot(HEADER_BAT,F907)' AS F138
    FROM ALLOW_BAT ALLOW 
    JOIN FSPRICE_BAT BAT ON ALLOW.F01=BAT.F01 AND ALLOW.F1000=BAT.F1000 AND ALLOW.F902=BAT.F902
    JOIN HEADER_BAT HDR ON BAT.F902=HDR.F902
    WHERE ALLOW.F222='@WIZGET(F222_FROM)' 
    UNION
    SELECT '@dbHot(HEADER_BAT,F902)' AS F902,BAT.F01,BAT.F1000,BAT.F126,BAT.F135,BAT.F136,'@dbHot(HEADER_BAT,F909)' AS F137,'@dbHot(HEADER_BAT,F907)' AS F138
    FROM OALLOW_BAT ALLOW 
    JOIN OSPRICE_BAT BAT ON ALLOW.F01=BAT.F01 AND ALLOW.F1000=BAT.F1000
    JOIN HEADER_OLD HDR ON BAT.F902=HDR.F902
    WHERE ALLOW.F222='@WIZGET(F222_FROM)' 
); 

/* GENERATE FORECAST BASED ON SALE OF PREVIOUS INVOICE */
@DBVIEW(Q1,SELECT ISNULL(HEADER_BAT.F907,GETDATE()) AS F254 FROM HEADER_BAT JOIN ALLOW_BAT ON ALLOW_BAT.F902=HEADER_BAT.F902 WHERE ALLOW_BAT.F222='@WIZGET(F222_TO)');

@UPDATE_BATCH(JOB=ADDRPL,TAR=RPT_ITM_D,
KEY=F254=:F254 AND F1034=:F1034 AND F01=:F01 AND F1056=:F1056 AND F1057=:F1057,
SRC=SELECT '@DBROW(Q1,F254,DSDF)' AS F254,3710 AS F1034,RPT.F01,'999' AS F1056,'901' AS F1057,SUM(RPT.F64) AS F64,SUM(RPT.F65) AS F65,SUM(RPT.F67) AS F67,GETDATE() AS F253,AVG(RPT.F1301) AS F1301,NULL AS F1302
FROM (
   SELECT F909,F907,F01 FROM ALLOW_BAT JOIN HEADER_BAT ON HEADER_BAT.F902=ALLOW_BAT.F902 WHERE ALLOW_BAT.F222='@WIZGET(F222_FROM)'
   UNION
   SELECT F909,F907,F01 FROM OALLOW_BAT JOIN HEADER_OLD ON HEADER_OLD.F902=OALLOW_BAT.F902 WHERE OALLOW_BAT.F222='@WIZGET(F222_FROM)'
 ) BAT 
JOIN RPT_ITM_D RPT ON BAT.F01=RPT.F01 AND RPT.F1034=3 AND RPT.F254 BETWEEN BAT.F909 AND BAT.F907
GROUP BY RPT.F01);

@UPDATE_BATCH(JOB=ADDRPL,TAR=RPT_ITM_W,
KEY=F254=:F254 AND F1034=:F1034 AND F01=:F01 AND F1056=:F1056 AND F1057=:F1057,
SRC=SELECT '@DBROW(Q1,F254,DSWF)' AS F254,3710 AS F1034,RPT.F01,'999' AS F1056,'901' AS F1057,SUM(RPT.F64) AS F64,SUM(RPT.F65) AS F65,SUM(RPT.F67) AS F67,GETDATE() AS F253,AVG(RPT.F1301) AS F1301,NULL AS F1302
FROM (
   SELECT F909,F907,F01 FROM ALLOW_BAT JOIN HEADER_BAT ON HEADER_BAT.F902=ALLOW_BAT.F902 WHERE ALLOW_BAT.F222='@WIZGET(F222_FROM)'
   UNION
   SELECT F909,F907,F01 FROM OALLOW_BAT JOIN HEADER_OLD ON HEADER_OLD.F902=OALLOW_BAT.F902 WHERE OALLOW_BAT.F222='@WIZGET(F222_FROM)'
 ) BAT 
JOIN RPT_ITM_D RPT ON BAT.F01=RPT.F01 AND RPT.F1034=3 AND RPT.F254 BETWEEN BAT.F909 AND BAT.F907
GROUP BY RPT.F01);

