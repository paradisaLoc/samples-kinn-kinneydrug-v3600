@FMT(CMP,'@DBHOT(APPLICATION)=WIN',,'®EXEC(MSG='This script can only be run from the Launchpad')®FMT(CHR,27)');
@WIZSET(DETAIL=D);

@WIZINIT;
@WIZDATE(F254);
@WIZTARGET(F1056=,SELECT F1056 AS F1000,F1531 FROM STD_TAB ORDER BY F1056);
@WIZDISPLAY;

@WIZINIT;
@WIZEDIT(CONFIRM=NO,DELETE FROM @WIZGET(START) TO @WIZGET(STOP));
@WIZDISPLAY;

@FMT(CMP,@WIZGET(CONFIRM)=YES,,'®FMT(CHR,27)');

@WIZRPL(SESSION=@STORE@TER@FMT(R2,@dbHot(regGen,TMPDB,1,30)));
@WIZRPL(F1032=@DBGEN(F1032,1));

/* CREATE RPT TABLE WITH NEGATIVE VALUE IN IT TO AFFECT NRT */
CREATE TABLE TMP_@WIZGET(SESSION)(@DBDCT(F1056,F1057,F254,F1032,F1033,F01,F1034,F64,F65,F67,F1301));

INSERT INTO TMP_@WIZGET(SESSION) (F1056,F1057,F254,F1032,F1033,F01,F1034,F64,F65,F67,F1301)
SELECT F1056,F1057,F254,@WIZGET(F1032) AS F1032,'ITM' AS F1033,F01,F1034,-F64,-F65,-F67,F1301
FROM RPT_ITM_D 
WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';

/* SWITCH WEIGHT AND QTY */

UPDATE TMP_@WIZGET(SESSION) SET F64=F67,F67=F64 WHERE F67<>0;

INSERT INTO TMP_@WIZGET(SESSION) (F1056,F254,F1032,F1033,F01,F1034,F64,F65,F67)
SELECT F1056,F254,@WIZGET(F1032) AS F1032,'CLT' AS F1033,F1148 AS F01,F1034,-F64,-F65,-F67
FROM RPT_CLT_D 
WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';

INSERT INTO TMP_@WIZGET(SESSION) (F1056,F1057,F254,F1032,F1033,F01,F1034,F64,F65,F67)
SELECT F1056,F1057,F254,@WIZGET(F1032) AS F1032,'CLK' AS F1033,CAST(F1185 AS VARCHAR) AS F01,F1034,-F64,-F65,-F67
FROM RPT_CLK_D 
WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';

INSERT INTO TMP_@WIZGET(SESSION) (F1056,F1057,F254,F1032,F1033,F01,F1034,F64,F65,F67)
SELECT F1056,F1057,F254,@WIZGET(F1032) AS F1032,'FIN' AS F1033,'1' AS F01,F1034,-F64,-F65,-F67
FROM RPT_FIN 
WHERE F1031='D' AND 
F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';

@UPDATE_REPORT(UPD_RPT=TRSFIN;TRSCLK;TRSSUB;TRSDPT;TRSVND;TRSCLT;TRSITM,TMP_@WIZGET(SESSION));

DROP TABLE TMP_@WIZGET(SESSION);;

/*************** DELETE THE REPORT RECORD ****************************/

DELETE FROM TRS_LOG WHERE F254='@WIZGET(F254)' AND (F990 LIKE '%@WIZGET(F1056).___%' OR F990='SALE IMPORT @WIZGET(F1056)' OR F990 LIKE 'TMP_%');

DELETE FROM TRS_FIN WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM TRS_DPT WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM TRS_SUB WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM TRS_CLK WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM TRS_CLT WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM TRS_VND WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM TRS_ITM WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';

DELETE FROM RPT_FIN WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)' AND F1031='D';
DELETE FROM RPT_DPT WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)' AND F1031='D';
DELETE FROM RPT_SUB WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)' AND F1031='D';
DELETE FROM RPT_HOU WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)' AND F1031='D';
DELETE FROM RPT_VND WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)' AND F1031='D';

DELETE FROM RPT_CLK_D WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM RPT_ITM_D WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM RPT_CLT_D WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';
DELETE FROM RPT_CLT_ITM_D WHERE F254='@WIZGET(F254)' AND F1056='@WIZGET(F1056)';

