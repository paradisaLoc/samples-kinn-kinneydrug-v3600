/* Future cost batch */

@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=HDR_FCOST_BAT);
@EXEC(INI=system[SMS]);
@WIZSET(TARGET=PAL);
@WIZSET(CHK1=1);

@WIZINIT;
@WIZFIL(BATCH,,SELECT CAST(F902 as char(15)) as F902,F913 FROM HEADER_BAT WHERE F916='FCOST_BAT' ORDER BY F902);
@WIZFIL(FRM,WIDTH=700,label=SELECT FUTURE COST BATCH,default=1,field=F902);
@WIZDISPLAY;

@RPT_QUERY
SELECT @DBHOT(INI,SYSTEM.INI,SMS,TARGETMULTI) AS MT, 
@DBFLD(HEADER_BAT,HDR.,F1000), @DBFLD(FCOST_BAT,BAT.), 
OBJ.F155,OBJ.F29,OBJ.F21,OBJ.F22,OBJ.F23,
COS.F26 AS CF26,COS.F38 AS CF38,COS.F19 AS CF19,COS.F1184 AS CF1184,VND.F334,POS.F04
FROM FCOST_BAT BAT 
JOIN HEADER_BAT HDR ON BAT.F902=HDR.F902
LEFT OUTER JOIN OBJ_TAB OBJ ON BAT.F01=OBJ.F01 
LEFT OUTER JOIN POS_TAB POS ON BAT.F01=POS.F01 AND POS.F1000=@FMT(CMP,'@DBHOT(INI,SYSTEM.INI,SMS,TARGETMULTI)=1','@DBHOT(INI,REPORT.INI,TARGETQRY,POS_TAB)',"'@DBHOT(INI,SYSTEM.INI,SMS,TARGETBASE)'")
LEFT OUTER JOIN COST_TAB COS ON BAT.F27=COS.F27 AND BAT.F01=COS.F01 AND BAT.F1184=COS.F1184 AND BAT.F1000=COS.F1000 
LEFT OUTER JOIN VENDOR_TAB VND ON COS.F27=VND.F27
WHERE BAT.F902='@WIZGET(BATCH)' @FMT(CMP,'@DBHOT(INI,SYSTEM.INI,SMS,TARGETMULTI)=1','AND BAT.F1000 IN 
 (SELECT DISTINCT LNK.F1000 FROM LNK_TAB LNK 
  JOIN LNK_TAB LN2 ON LNK.F1056=LN2.F1056 AND LNK.F1057=LN2.F1057)') 
ORDER BY F04,BAT.F01,BAT.F27,BAT.F1000;
