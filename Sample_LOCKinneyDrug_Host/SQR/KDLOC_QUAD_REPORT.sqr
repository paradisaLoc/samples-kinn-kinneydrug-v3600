@WIZSET(TITLE=Corporate Sales Totals by Class);
@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=KDLOC_QUAD_REPORT);
@EXEC(INI=system[SMS]);

@WIZINIT;
/*Replace start date with either first of month for MTD or first of year for YTD*/
@FMT(CMP,@WIZGET(PERIOD)=MTD,®WIZRPL(START=@DATE(@WIZGET(DATE),DSMD)),®WIZRPL(START=@DATE(@WIZGET(DATE),DSYD)));
@WIZRPL(STOP=@WIZGET(DATE));
@WIZSET(LAST_YEAR_START=@DATE(@WIZGET(START),DID-365));
@WIZSET(LAST_YEAR_STOP=@DATE(@WIZGET(STOP),DID-365));
@WIZFIL(D03,F03,SELECT F03,F238 FROM DEPT_TAB ORDER BY F03);
@WIZTARGET(TARGET=RAL,SELECT F1000,F1018 FROM STO_TAB WHERE F1180='1' ORDER BY F1000);
@WIZDISPLAY;

@RPT_DETAIL(1,SELECT
SUB.F04 AS SUB_DEPT,
MAX(SUB.F1022) AS SUB_DEPT_DESC,
CASE WHEN CAT.F1945='PRIVATE LABEL'  THEN 'NATIONL' ELSE 'PRVTLBL' END AS PV_ITEMS,
SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 0 END) AS LY_SUB_DEPT_SALES_TOTAL,
SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 0 END) AS CY_SUB_DEPT_SALES_TOTAL,
SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 0 END)-SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 0 END) AS SALES_DIFFERENCE_$,
CASE WHEN SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 1 END)=0 THEN 0 ELSE (100*((SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 0 END)-SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 0 END))/SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 1 END))) END AS SALES_DIFFERENCE_P,
ROUND(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F1301 ELSE 0 END),2) AS LY_COST_TOTAL,
ROUND(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F1301 ELSE 0 END),2) AS CY_COST_TOTAL,
ROUND(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65-SALES.F1301 ELSE 0 END),2) AS LY_GP_$,
ROUND(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65-SALES.F1301 ELSE 0 END),2) AS CY_GP_$,
CASE WHEN SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 1 END)=0 THEN 0 ELSE ROUND(100-(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F1301*100 ELSE 0 END)/SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 1 END)),2) END AS LY_GP_P,
CASE WHEN SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 1 END)=0 THEN 0 ELSE ROUND(100-(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F1301*100 ELSE 0 END)/SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 1 END)),2) END AS CY_GP_P
FROM RPT_ITM_D AS SALES
JOIN OBJ_TAB  AS ITEM ON SALES.F01=ITEM.F01
JOIN CAT_TAB AS CAT ON ITEM.F17=CAT.F17
JOIN POS_TAB AS POS ON ITEM.F01=POS.F01
JOIN SDP_TAB AS SUB ON SUB.F04=POS.F04
JOIN LNK_TAB LNK ON SALES.F1056=LNK.F1056 AND SALES.F1057=LNK.F1057 AND LNK.F1000='@WIZGET(TARGET)'
WHERE SALES.F1034=3 AND SUB.F03=:F03 AND (SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' OR SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' )
GROUP BY SUB.F04, CASE WHEN CAT.F1945='PRIVATE LABEL'  THEN 'NATIONL' ELSE 'PRVTLBL' END
HAVING  SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 0 END) <> 0
ORDER BY SUB.F04, CASE WHEN CAT.F1945='PRIVATE LABEL'  THEN 'NATIONL' ELSE 'PRVTLBL' END);


@RPT_QUERY
SELECT DEPT.F03,
MAX(DEPT.F238) AS DEPT_DESC,
MAX(SUB.F04) AS SUB_DEPT,
MAX(SUB.F1022) AS SUB_DEPT_DESC,
CASE WHEN CAT.F1945='PRIVATE LABEL'  THEN 'NATIONL' ELSE 'PRVTLBL' END AS PV_ITEMS,
CASE WHEN '@WIZGET(PERIOD)'='MTD'  THEN 'MTD' ELSE 'YTD' END AS PERIOD,
CASE WHEN '@WIZGET(PERIOD)'='MTD'  THEN '1st of '+'@DATE(@WIZGET(STOP),LTR,M)'+' To: ' ELSE 'Jan 1st To: '+'@DATE(@WIZGET(STOP),DY)' END AS PERIOD_DATE,
SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 0 END) AS LY_SUB_DEPT_SALES_TOTAL,
SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 0 END) AS CY_SUB_DEPT_SALES_TOTAL,
SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 0 END)-SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 0 END) AS SALES_DIFFERENCE_$,
CASE WHEN SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 1 END)=0 THEN 0 ELSE (100*((SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 0 END)-SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 0 END))/SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 1 END))) END AS SALES_DIFFERENCE_P,
ROUND(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F1301 ELSE 0 END),2) AS LY_COST_TOTAL,
ROUND(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F1301 ELSE 0 END),2) AS CY_COST_TOTAL,
ROUND(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65-SALES.F1301 ELSE 0 END),2) AS LY_GP_$,
ROUND(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65-SALES.F1301 ELSE 0 END),2) AS CY_GP_$,
CASE WHEN SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 1 END)=0 THEN 0 ELSE ROUND(100-(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F1301*100 ELSE 0 END)/SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' THEN SALES.F65 ELSE 1 END)),2) END AS LY_GP_P,
CASE WHEN SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 1 END)=0 THEN 0 ELSE ROUND(100-(SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F1301*100 ELSE 0 END)/SUM(CASE WHEN SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' THEN SALES.F65 ELSE 1 END)),2) END AS CY_GP_P,
'@WIZGET(D03)' AS DPTSTART, '@WIZGET(F03)' AS DPTSTOP,
CAST('@WIZGET(START)' AS DATETIME) AS START, CAST('@WIZGET(STOP)' AS DATETIME) AS STOP,
CAST('@WIZGET(LAST_YEAR_START)' AS DATETIME) AS LYSTART, CAST('@WIZGET(LAST_YEAR_STOP)' AS DATETIME) AS LYSTOP,
'@WIZGET(TARGET)' AS TARGET, '@WIZGET(TARGET_LONG)' AS TARGETDESC
FROM RPT_ITM_D AS SALES
JOIN OBJ_TAB  AS ITEM ON SALES.F01=ITEM.F01
JOIN CAT_TAB AS CAT ON ITEM.F17=CAT.F17
JOIN POS_TAB AS POS ON ITEM.F01=POS.F01
JOIN SDP_TAB AS SUB ON SUB.F04=POS.F04
JOIN DEPT_TAB AS DEPT ON DEPT.F03=SUB.F03
JOIN LNK_TAB LNK ON SALES.F1056=LNK.F1056 AND SALES.F1057=LNK.F1057 AND LNK.F1000='@WIZGET(TARGET)'
WHERE F1034=3  AND (DEPT.F03 BETWEEN @WIZGET(D03) AND @WIZGET(F03)) AND (SALES.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)' OR SALES.F254 BETWEEN '@WIZGET(LAST_YEAR_START)' AND '@WIZGET(LAST_YEAR_STOP)' )
GROUP BY DEPT.F03, CASE WHEN CAT.F1945='PRIVATE LABEL'  THEN 'NATIONL' ELSE 'PRVTLBL' END
ORDER BY DEPT.F03, CASE WHEN CAT.F1945='PRIVATE LABEL'  THEN 'NATIONL' ELSE 'PRVTLBL' END;


