/* Future price batch */

@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=HDR_FPRICE_BAT);
@EXEC(INI=system[SMS]);
@WIZSET(TARGET=PAL);
@WIZSET(CHK1=1);

@WIZINIT;
@WIZFIL(BATCH,,SELECT CAST(F902 as char(15)) as F902,F913 FROM HEADER_BAT WHERE F916='FPRICE_BAT' ORDER BY F902);
@WIZFIL(FRM,WIDTH=700,label=SELECT FUTURE PRICE BATCH,default=1,field=F902);
@WIZDISPLAY;

@RPT_QUERY
SELECT @DBHOT(INI,SYSTEM.INI,SMS,TARGETMULTI) AS MT, 
@DBFLD(HEADER_BAT,HDR.,F1000), @DBFLD(FPRICE_BAT,BAT.), 
OBJ.F155,OBJ.F29,OBJ.F21,OBJ.F22,OBJ.F23,
PRI.F1007, PRI.F1006, PRI.F113, POS.F04, POS.F82
FROM FPRICE_BAT BAT
JOIN HEADER_BAT HDR ON BAT.F902=HDR.F902
LEFT OUTER JOIN OBJ_TAB OBJ ON BAT.F01=OBJ.F01 
LEFT OUTER JOIN POS_TAB POS ON BAT.F01=POS.F01 AND POS.F1000=@FMT(CMP,'@DBHOT(INI,SYSTEM.INI,SMS,TARGETMULTI)=1','@DBHOT(INI,REPORT.INI,TARGETQRY,POS_TAB)',"'@DBHOT(INI,SYSTEM.INI,SMS,TARGETBASE)'")
LEFT OUTER JOIN PRICE_TAB PRI ON BAT.F01=PRI.F01 AND BAT.F126=PRI.F126 AND BAT.F1000=PRI.F1000
WHERE BAT.F902='@WIZGET(BATCH)' @FMT(CMP,'@DBHOT(INI,SYSTEM.INI,SMS,TARGETMULTI)=1','AND BAT.F1000 IN 
 (SELECT DISTINCT LNK.F1000 FROM LNK_TAB LNK 
  JOIN LNK_TAB LN2 ON LNK.F1056=LN2.F1056 AND LNK.F1057=LN2.F1057)') 
ORDER BY F04,BAT.F01,BAT.F126,BAT.F1000;
