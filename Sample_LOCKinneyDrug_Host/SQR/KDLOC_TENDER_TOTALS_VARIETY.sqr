@WIZSET(TITLE=Tender Totals by Variety);
@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=KDLOC_Tender_Totals_Variety);
@EXEC(INI=system[SMS]);

@WIZINIT;
@WIZDETAIL(DETAIL=D);
@WIZDATES(START,STOP);
@WIZTARGET(TARGET=RAL,SELECT F1000,F1018 FROM STO_TAB WHERE F1180='1' ORDER BY F1000);
@WIZDISPLAY;

@RPT_QUERY
SELECT SUM(F65) AS F65, MAX(TLZ.F1034) as F1034, MAX(F64) as F64, MAX(TLZ.F1039) as F1039,
SUM(CASE WHEN F65>0 THEN F64 ELSE 0 END) AS CNT,
SUM(CASE WHEN F65>0 THEN F65 ELSE 0 END) AS AMOUNT,
SUM(CASE WHEN F65<0 THEN F64 ELSE 0 END) AS REV_CNT,
SUM(CASE WHEN F65<0 THEN F65 ELSE 0 END) AS REV_AMOUNT,
SUM(CASE WHEN F65<>0 THEN F65 ELSE 0 END) AS TOTAL,
SUM(CASE WHEN F65>0 AND TLZ.F1034 NOT IN(906,915) THEN F64 ELSE 0 END) AS CNT_SUM,
SUM(CASE WHEN F65>0 AND TLZ.F1034 NOT IN(906,915) THEN F65 ELSE 0 END) AS AMOUNT_SUM,
SUM(CASE WHEN F65<0 AND TLZ.F1034 NOT IN(906,915) THEN F64 ELSE 0 END) AS REV_CNT_SUM,
SUM(CASE WHEN F65<0 AND TLZ.F1034 NOT IN(906,915) THEN F65 ELSE 0 END) AS REV_AMOUNT_SUM,
SUM(CASE WHEN TLZ.F1034 NOT IN(906,915) THEN F65 ELSE 0 END) AS TOTAL_SUM,
CASE WHEN TLZ.F1034 IN (906,915) THEN 'NOT IN OVERALL TOTAL'
     WHEN TLZ.F1034 IN (922,917,905,938) THEN ''
     ELSE '1' END AS EXT_DESC,
SECTION=CASE
     WHEN TLZ.F1034 IN(901,916) THEN '1.CASH TOTAL'
     WHEN TLZ.F1034 IN(922,938) THEN '2'
     WHEN TLZ.F1034 IN(906,915) THEN '3'
     WHEN TLZ.F1034 IN(920,921) THEN '4.EBT TOTAL'
     WHEN TLZ.F1034 IN(902,903,928,930,931,932,933) THEN '5.CREDIT AND DEBIT TOTAL'
     WHEN TLZ.F1034 IN(917,905,991) THEN '6'
     WHEN TLZ.F1034 IN(12,13) THEN '7.ELECTRONIC COUPONS TOTAL' 
     ELSE '' END,
SECTIONRPT=CASE
     WHEN TLZ.F1034 IN(901,916) THEN 'CASH TOTAL'
     WHEN TLZ.F1034 IN(922,938) THEN ''
     WHEN TLZ.F1034 IN(906,915) THEN ''
     WHEN TLZ.F1034 IN(920,921) THEN 'EBT TOTAL'
     WHEN TLZ.F1034 IN(902,903,928,930,931,932,933) THEN 'CREDIT AND DEBIT TOTAL'
     WHEN TLZ.F1034 IN(917,905,991) THEN ''
     WHEN TLZ.F1034 IN(12,13) THEN 'ELECTRONIC COUPONS TOTAL'
     ELSE '' END,
CAST('@WIZGET(START)' AS DATETIME) AS START, CAST('@WIZGET(STOP)' AS DATETIME) AS STOP,
'@WIZGET(TARGET)' AS TARGET, '@WIZGET(TARGET_LONG)' AS TARGETDESC
FROM TLZ_TAB AS TLZ
LEFT JOIN TRS_FIN TRS ON TLZ.F1034=TRS.F1034 AND TRS.F254 BETWEEN '@WIZGET(START)' AND '@WIZGET(STOP)'
JOIN (SELECT DISTINCT F1056 FROM LNK_TAB WHERE F1000='@WIZGET(TARGET)') LNK ON TRS.F1056=LNK.F1056 
WHERE TLZ.F1034 IN (12,13,901,902,903,905,906,915,916,917,920,921,922,928,930,931,932,933,938,991) 
GROUP BY TLZ.F1034
ORDER BY SECTION, TLZ.F1034;


