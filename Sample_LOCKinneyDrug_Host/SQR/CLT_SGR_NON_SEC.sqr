@WIZSET(TITLE=Customer Multi Totals);
@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=CLT_SGR_NON_SEC);
@EXEC(INI=system[SMS]);

@WIZINIT;
@WIZDETAIL(DETAIL=D);
@WIZDATES(START,STOP);
/*@WIZFIL(D1148=0,F1148=ZZZ,SELECT F1148,F1155 FROM CLT_TAB ORDER BY F1148);*/
@WIZFIL(D1148=0,F1148=ZZZ,SELECT ISNULL(CLL.F1577,CLT.F1148) as F1148, CLT.F1155 as F1155 FROM CLT_TAB CLT LEFT OUTER JOIN CLL_TAB CLL ON CLT.F1148=CLL.F1148 AND CLL.F1578='PS' AND ISNULL(CLL.F1898,'0')='1' AND LEFT(CLL.F1577,2)='46' ORDER BY F1148);
@WIZTLZ(D1179,F1179,SELECT F1179,F1183 FROM TZS_TAB ORDER BY F1179);
@WIZTARGET(TARGET=RAL,SELECT F1000,F1018 FROM STO_TAB WHERE F1180='1' ORDER BY F1000);
@WIZDISPLAY;

@WIZRPL(SESSION=@STORE@TER@FMT(R2,@dbHot(regGen,TMPDB,1,30)));
@WIZRPL(SGR1=TMP_G1@WIZGET(SESSION):GROUP0);

@RPT_DETAIL(1,SELECT RPT.F1034,TLZ.F1039,RPT.F64,RPT.F65,RPT.F1131,RPT.F1401,RPT.F1431
FROM TMP_G1@WIZGET(SESSION) RPT JOIN TLZ_TAB TLZ ON RPT.F1034=TLZ.F1034 AND @DBHOT(LEVELFIELD)>0);

@RPT_QUERY
SELECT ' ' AS GROUP0, ISNULL(CLL.F1577,CLT.F1148) as F1148, MAX(TLZ.F1131) AS F1131, 
TLZ.F1179, TRS.F1034, MIN(TLZ.F1039) AS F1039, MAX(CLT.F1155) AS F1155,
SUM(TRS.F64) AS F64, SUM(TRS.F65) AS F65, SUM(TRS.F67) AS F67,  
'@WIZGET(D1148)' AS CLTSTART, '@WIZGET(F1148)' AS CLTSTOP,
'@WIZGET(D1179)' AS SECSTART, '@WIZGET(F1179)' AS SECSTOP,
CAST('@WIZGET(START)' as DATETIME) AS START, CAST('@WIZGET(STOP)' as DATETIME) AS STOP,
'@WIZGET(TARGET)' AS TARGET, '@WIZGET(TARGET_LONG)' AS TARGETDESC 
FROM RPT_CLT_@WIZGET(DETAIL) TRS 
JOIN CLT_TAB CLT ON TRS.F1148=CLT.F1148
LEFT OUTER JOIN CLL_TAB CLL ON CLT.F1148=CLL.F1148 AND CLL.F1578='PS' AND ISNULL(CLL.F1898,'0')='1' AND LEFT(CLL.F1577,2)='46'
JOIN TLZ_TAB TLZ ON TRS.F1034=TLZ.F1034 AND @DBHOT(LEVELFIELD)>0
JOIN LNK_TAB LNK ON TRS.F1056=LNK.F1056 and LNK.F1057='901' and LNK.F1000='@WIZGET(TARGET)' 
WHERE TRS.F254 BETWEEN '@WIZGET(START)' and '@WIZGET(STOP)' and 
TRS.F1148 BETWEEN '@WIZGET(D1148)' and '@WIZGET(F1148)' and
TLZ.F1179 BETWEEN @WIZGET(D1179) and @WIZGET(F1179) 
GROUP BY ISNULL(CLL.F1577,CLT.F1148), TLZ.F1179, TRS.F1034 
ORDER BY ISNULL(CLL.F1577,CLT.F1148), TLZ.F1179, TRS.F1034;

