@WIZSET(TITLE=Billing Report);
@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=KDLOC_BILLING_REPORT);

@WIZINIT;
@WIZEDIT(DITTO,SELECT A DITTO NUMBER);
@WIZDISPLAY;

@RPT_QUERY
SELECT F222,F27,F344, F201, F64,F65,F2591,F909,F6000,
dbo.Kinney_SegmentFromString(F1779,1,'|') as F1779_1,
dbo.Kinney_SegmentFromString(F1779,2,'|') as F1779_2,
dbo.Kinney_SegmentFromString(F1779,3,'|') as F1779_3,
dbo.Kinney_SegmentFromString(F1779,4,'|') as F1779_4
FROM (
	SELECT HEADER_OLD.F902,MAX(HEADER_OLD.F909) AS F909,MAX(KINNEYINV_TAB.F6000) AS F6000,
	SUM(RPT_ITM_D.F64) AS F64, SUM(RPT_ITM_D.F65) AS F65, 
	SUM(RPT_ITM_D.F65)/SUM(RPT_ITM_D.F64) AS F201,MAX(OALLOW_BAT.F222) AS F222,ISNULL(NULLIF(MAX(OALLOW_BAT.F2591),''),0) AS F2591,
	MAX(VENDOR_TAB.F27) AS F27,MAX(VENDOR_TAB.F344) AS F344,MAX(VENDOR_TAB.F1779) AS F1779
	FROM HEADER_OLD 
	JOIN OALLOW_BAT ON OALLOW_BAT.F902=HEADER_OLD.F902
	JOIN KINNEYINV_TAB ON KINNEYINV_TAB.F222=OALLOW_BAT.F222
	JOIN VENDOR_TAB ON VENDOR_TAB.F27=OALLOW_BAT.F27
	LEFT OUTER JOIN RPT_ITM_D ON RPT_ITM_D.F01=OALLOW_BAT.F01 AND RPT_ITM_D.F1034=8223 AND RPT_ITM_D.F254 BETWEEN HEADER_OLD.F909 AND HEADER_OLD.F907
	WHERE CHARINDEX('-',HEADER_OLD.F913)>0 AND SUBSTRING(HEADER_OLD.F913,1,CHARINDEX('-',HEADER_OLD.F913)-1)='@WIZGET(DITTO)'
	GROUP BY HEADER_OLD.F902
	) SUB;


