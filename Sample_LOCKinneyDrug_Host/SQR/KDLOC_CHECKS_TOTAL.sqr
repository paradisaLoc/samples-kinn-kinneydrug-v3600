@WIZSET(TITLE=Checks Total Report);
@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=KDLOC_CHECKS_TOTAL);

@WIZINIT;
@WIZDETAIL(DETAIL=D);
@WIZDATES(START,STOP);
@WIZTARGET(TARGET=RAL,SELECT F1000,F1018 FROM STO_TAB WHERE F1180='1' ORDER BY F1000);
@WIZDISPLAY;

@RPT_QUERY
SELECT TRS.F1056, TRS.F1057, TRS.F254, TRS.F1032, TRS.F1079, TRS.F65, TRS.F1034,
CASE WHEN TRS.F1034=1202 THEN 'TELECHECK' ELSE 'PAPER' END AS TLZ_DESC
FROM TRS_FIN TRS
JOIN LNK_TAB LNK ON TRS.F1056=LNK.F1056 and TRS.F1057=LNK.F1057 and LNK.F1000='@WIZGET(TARGET)'
WHERE TRS.F254 BETWEEN '@WIZGET(START)' and '@WIZGET(STOP)' and TRS.F1034 IN (1222,1202)
ORDER BY TRS.F1056, TRS.F254, TRS.F1057, TRS.F1032


