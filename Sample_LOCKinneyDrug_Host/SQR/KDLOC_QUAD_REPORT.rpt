<?xml version="1.0" encoding="iso-8859-1"?>
<html>

  <head>
    <desc>
      <input type="hidden" class="HidParam" id="RPT_NAME" value="Quad Report by Dept MTD or YTD" /> <input type="hidden" class="HidParam" id="RPT_FILENAME" value="KDLOC_QUAD_REPORT" /> <input type="hidden" class="HidParam" id="RPT_PARENT" value="rpt_dept" /> <input type="hidden" class="HidParam" id="RPT_PRIORITY" value="30" /> <input type="hidden" class="HidParam" id="RPT_DESC" value="Print department information base on date range. If you select a period type (e.g., week) and a longer date interval (e.g., year), the report shows week by week totals for the year selected. CRITERIA: Period, Department, Totalizer and Target" /> <input type="hidden" class="HidParam" id="RPT_GROUP" value="9.Multi Stores" /> <input type="hidden" class="HidParam" id="RPT_WIZARD" value="yes" />
    </desc>
    <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
    <meta name="CurHdr" content="ScreenRpt" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="PRAGMA" content="No_Cache" />
    <link rel="stylesheet" href="../../Images/sms_form.css" type="text/css" />
    <link rel="stylesheet" href="../../Images/sms_rpt.css" type="text/css" />
<script type="text/javascript" src="../../Images/rpt.js">
        
</script>

    <title></title>
  </head>

  <body class="Main" onload="@wizset(CURPOS=0)InitRpt(document,@wizget(CURPOS),'@dbHot(DBALIAS)','@DBHOT(DBUSERNAME)','@DBHOT(DBPASSWORD)','http:/scripts/trs.exe')">
    <object id="cDialog" class="ComDialog" classid="clsid:327DC737-2BAD-48A3-9B4E-B42D5378C78A">
    </object> 

    <table class="HdrTab">
      <tbody>
        <tr>
          <th id="RptTitle" class="HdrCel">Quad Report by Dept MTD or YTD</th>

          <th class="HdrBtnCel"><input onclick="SubmitReport('@wizget(DN)')" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="HdrBtnNew" onkeydown="ReadKeyStroke(window,this)" accesskey="Z" type="button" value="Launch" name="BtnSubmit" /></th>

          <th class="HdrBtnCel"><input onclick="PrintReport('@wizget(DN)')" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="HdrBtnNew" onkeydown="ReadKeyStroke(window,this)" type="button" value="Print" name="BtnPrint" /></th>

          <th class="HdrBtnCel"><input onclick="ReportAddTo(this,'@wizget(DN)','T')" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="HdrBtnNew" onkeydown="ReadKeyStroke(window,this)" type="button" value="Add" name="BtnTask" /></th>

          <th class="HdrBtnCel"><input onclick="document.location='http:/scripts/trs.exe?htt=sqr\\' + RPT_FILENAME.value + '.rpt&amp;CN=@CNC&amp;TN=@TER';" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="HdrBtnNew" onkeydown="ReadKeyStroke(window,this)" type="button" value="Reset" name="BtnReset" /></th>
        </tr>
      </tbody>
    </table>
    <input class="HidParam" type="hidden" value="KDLOC_QUAD_REPORT" name="SQR" /><input class="HidParam" type="hidden" value="@CNC" name="CN" /><input class="HidParam" type="hidden" value="@TER" name="TN" />

    <table class="EntTab" style="POSITION: absolute; LEFT: 200px; TOP: 125px">
      <tbody>
        <tr>
          <th class="EntHdr" colspan="3">DEPARTMENT RANGE</th>
        </tr>

        <tr>
          <th class="EntCap">From</th>

          <td class="EntInp"><input onchange="@TOOLS(ValidateField,integer,F03)" ondblclick="@TOOLS(ShowGrid,F03)" onfocus="SaveValue(this)" datasrc="@wizset(D03=0)" onblur="LeaveField(this)" class="EntGrid" onkeydown="ReadKeyStroke(window,this)" style="WIDTH: 60px" value="@wizget(D03)" name="D03" /></td>

          <td class="EntVal"><input tabindex="-1" class="EntValTxt" readonly="readonly" value="@dbSELECT(SELECT F238 FROM DEPT_TAB WHERE F03='@wizget(D03)')" /></td>
        </tr>

        <tr>
          <th class="EntCap">To</th>

          <td class="EntInp"><input onchange="@TOOLS(ValidateField,integer,F03)" ondblclick="@TOOLS(ShowGrid,F03)" onfocus="SaveValue(this)" datasrc="@wizset(F03=999999)" onblur="LeaveField(this)" class="EntGrid" onkeydown="ReadKeyStroke(window,this)" style="HEIGHT: 17px; WIDTH: 60px" size="1" value="@wizget(F03)" name="F03" /></td>

          <td class="EntVal"><input tabindex="-1" class="EntValTxt" readonly="readonly" value="@dbSELECT(SELECT F238 FROM DEPT_TAB WHERE F03='@wizget(F03)')" /></td>
        </tr>
      </tbody>
    </table>

    <table class="EntTab" style="POSITION: absolute; LEFT: 50px; TOP: 70px">
      <tbody>
        <tr>
          <th class="EntHdr" colspan="2">PERIOD</th>
        </tr>

        <tr>
          <td onclick="SelectRadioButton(this)" class="EntRad"><input onfocus="ActivateField(this)" datasrc="@wizset(ORDER=0)@wizget(ORDER)" onblur="LeaveField(this)" class="EntRad" onkeydown="ReadKeyStroke(window,this)" type="radio" value="MTD" name="PERIOD" />Month to Date</td>
        </tr>

        <tr>
          <td onclick="SelectRadioButton(this)" class="EntRad"><input onfocus="ActivateField(this)" onblur="LeaveField(this)" class="EntRad" onkeydown="ReadKeyStroke(window,this)" type="radio" value="YTD" name="PERIOD" />Year to Date</td>
        </tr>

        <tr>
          <td onclick="SelectRadioButton(this)" class="EntRad">
          </td>
        </tr>

        <tr>
          <td class="EntRad">
          </td>
        </tr>
      </tbody>
    </table>

    <table class="EntTab" style="POSITION: absolute; LEFT: 200px; TOP: 70px">
      <tbody>
        <tr>
          <th id="oDateSrc" class="EntHdr" colspan="2" initdetail="DD" initdatereg="@wizset(TDATE=@DWDD)@wizget(TDATE)" initweek="@dbHOT(WEEKSTART)" initformatsql="@dbHOT(REGIONAL,SQLDATEFORMAT)" initformat="@dbHOT(REGIONAL,SHORTDATEFORMAT)" initval="@wizset(REFRESH_DATE=1)@wizget(REFRESH_DATE)">DATE</th>
        </tr>

        <tr>
          <td class="EntInp"><input onchange="ValidateField(window,this,'date')" ondblclick="ShowDate(window,this)" onfocus="SaveValue(this)" datasrc="@wizset(DATE=@DWDD)" onblur="LeaveField(this)" class="EntDat" onkeydown="ReadKeyStroke(window,this)" style="WIDTH: 90px" value="@wizget(DATE)" name="DATE" /></td>

          <td class="EntVal"><input onclick="GotoNextPreviousDate('-',DATE)" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="EntBtn" onkeydown="ReadKeyStroke(window,this)" type="button" value="Past" name="BtnDatPas" /><input onclick="GotoNextPreviousDate('+',DATE)" onfocus="ActivateField(this)" onblur="LeaveField(this)" class="EntBtn" onkeydown="ReadKeyStroke(window,this)" type="button" value="Future" name="BtnDatFut" /></td>
        </tr>
      </tbody>
    </table>

    <table class="EntTab" style="POSITION: absolute; LEFT: 200px; TOP: 200px">
      <tbody>
        <tr>
          <th class="EntHdr" colspan="2">TARGET</th>
        </tr>

        <tr>
          <td class="EntInp"><input onchange="@TOOLS(ValidateField,txt,F1000_RPT)" ondblclick="@TOOLS(SHOWGRID,F1000_RPT)" onfocus="SaveValue(this)" datasrc="@wizset(TARGET=@TOOLS(PopupDefault,F1000_RPT,FIRST,RAL))" onblur="LeaveField(this)" class="EntGrid" onkeydown="ReadKeyStroke(window,this)" style="WIDTH: 70px" value="@wizget(TARGET)" name="TARGET" /></td>

          <td class="EntVal"><input tabindex="-1" class="EntValTxt" readonly="readonly" value="@dbSELECT(SELECT F1018 FROM STO_TAB WHERE F1000='@wizget(TARGET)')" /></td>
        </tr>
      </tbody>
    </table>
  </body>
</html>

