CREATE TABLE TEMP_DCT (@dbDCT(F1401,F01,F255,F1000));

CREATE VIEW TMP_INCOMM_IMPORT AS SELECT F1401,F01,F255,F1000 FROM TEMP_DCT;

INSERT INTO TMP_INCOMM_IMPORT VALUES

@MAP_DETAIL1
IF=LINE=2
F1401=CHAR,0,1
F01=GPC,0,2
F255=CHAR,0,3
F1000=FIX,PAL

/* Create the KDLOC_INCOMM_BIN table if it does not exist */
IF OBJECT_ID('KDLOC_INCOMM_BIN', 'U') IS NULL
CREATE TABLE KDLOC_INCOMM_BIN (@DBDCT(F1401,F01,F1000,F255));

/* Insert records into the KDLOC_INCOMM_BIN table */
@UPDATE_BATCH(JOB=LOAD,TAR=KDLOC_INCOMM_BIN,
KEY=F1401=:F1401 AND F01=:F01 AND F1000=:F1000,SRC=
SELECT F1401, RIGHT('00000000000000' + F01, 13) AS F01,F1000,F255
FROM TMP_INCOMM_IMPORT
);

@FMT(CMP,@DBHOT(FINDTABLE,TMP_INCOMM_IMPORT)=,,'DROP TABLE TMP_INCOMM_IMPORT');

/* Deploy to lanes. */
@FMT(CMP,@TER>899,®WIZSET(TARGET=PAL)®EXEC(SQM=KDLOC_INCOMM_BIN_LOAD));
