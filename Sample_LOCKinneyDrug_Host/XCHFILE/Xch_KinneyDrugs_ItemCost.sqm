INSERT INTO HEADER_DCT VALUES
('HM','000001','001','001','ERRORS.SIL','',@DJDD,0001,@DJDD,0001,,'ADDRPL','KINNEY ITEM COST',,,,,0,'1/1.0','VER1','F01','LOGUPDATEBATCH=0');

CREATE TABLE TEMP_DCT (@dbDCT(F1000,F01,F154,F27,F39,F38,F19,F1964,F1184,F1401,F1402,F1302,F1976,F1875,F1310));

CREATE VIEW ITEM_CHG AS SELECT F1000,F01,F154,F27,F39,F38,F19,F1964,F1184,F1401,F1402,F1302,F1976,F1875,F1310 FROM TEMP_DCT;

INSERT INTO ITEM_CHG VALUES

@MAP_DETAIL1
F1000=FIX,PAL
F01=CHAR,0,2
F154=CHAR,0,3
F27=CHAR,0,1
F39=DATEYYMMDD,0,5
F38=NUM,0,7,,2
F19=FIX,1
F1964=FIX,@STORE
F1184=FIX,CASE
F1401=NUM,0,4
F1402=CHAR,0,6
F1302=FLAGYN,0,8
F1976=FIX
F1875=FIX
F90=FIX,1

@WIZRPL(DBASE_TIMEOUT=E);


/* STRIP CHECK DIGIT ON EAN13 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET 
F154=CASE WHEN SUBSTRING(RIGHT('0000000000000'+LTRIM(F154),13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+LTRIM(F154),13),12) ELSE RIGHT('0000000000000'+LTRIM(F154),13) END,
F01=CASE WHEN SUBSTRING(RIGHT('0000000000000'+LTRIM(F01),13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+LTRIM(F01),13),12) ELSE RIGHT('0000000000000'+LTRIM(F01),13) END

/* IF F01 IS EMPTY OR ADSKU THEN USE F154 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F01=F154 WHERE F01='0000000000000' OR F1302=1;

/* IF F01 IS EMPTY THEN USE F154 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F01=F154 WHERE F01='0000000000000'

/* DELETE WHERE UPC VALUE IS EMPTY */
DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F01='0000000000000';


/*DELETE WHERE URL VALUE EQUAL TO KD.TOBACCO*/

DELETE BAT FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT JOIN ALT_TAB ALT ON ALT.F01=BAT.F01 AND RIGHT('0000000000000'+ALT.F154,13)=BAT.F154 AND CHARINDEX('KD.TOBACCO=',ISNULL(ALT.F2660,''))>0;

/* CREATE INDEX */
CREATE INDEX IDX_M@WIZGET(SOURCE)@WIZGET(BATCH) ON M@WIZGET(SOURCE)@WIZGET(BATCH) (F01,F1000,F27,F1184,F1401)

/* LOOKUP ITEMS IN KINNEY_VND_STORE_ITEM*/
INSERT INTO M@WIZGET(SOURCE)@WIZGET(BATCH)(@DBFLD(M@WIZGET(SOURCE)@WIZGET(BATCH))) 
SELECT KIN.F1056 AS F1000,@DBFLD(M@WIZGET(SOURCE)@WIZGET(BATCH),BAT.,F1000) FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
JOIN KINNEY_VND_STORE_ITEM KIN ON KIN.F01=BAT.F01 AND KIN.F27=BAT.F27 JOIN STD_TAB STD ON STD.F1056=KIN.F1056 AND STD.F1545=BAT.F1401;

/* LOOKUP WHAREHOUSE ITEMS AGAINST PAL */
INSERT INTO M@WIZGET(SOURCE)@WIZGET(BATCH)(@DBFLD(M@WIZGET(SOURCE)@WIZGET(BATCH))) 
SELECT LNK.F1056 AS F1000,@DBFLD(M@WIZGET(SOURCE)@WIZGET(BATCH),BAT.,F1000) FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
JOIN LNK_TAB LNK ON LNK.F1000=BAT.F1000
WHERE BAT.F1401='1' AND BAT.F1402='Y' AND BAT.F1000='PAL' AND LNK.F1057='901' AND NOT EXISTS
(SELECT 1 FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1000=LNK.F1056 AND F01=BAT.F01 AND F27=BAT.F27 AND F1184=BAT.F1184);

DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1000='PAL';

/*MARGIN COST*/
UPDATE BAT SET BAT.F1976='%COST=' + CAST((100-SDEP.F49) AS VARCHAR),BAT.F1875='C'
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT
JOIN POS_TAB POS ON BAT.F01=POS.F01
JOIN SDP_TAB SDEP ON POS.F04=SDEP.F04 AND (SDEP.F49 IS NOT NULL OR SDEP.F49='' OR SDEP.F49=0) 
WHERE 
POS.F1000=(SELECT TOP 1 SUB_POS.F1000 FROM POS_TAB SUB_POS 
      JOIN LNK_TAB SUB_LNK ON SUB_POS.F1000=SUB_LNK.F1000 
      JOIN LNK_TAB SUB_LNK2 ON SUB_LNK.F1056=SUB_LNK2.F1056 AND SUB_LNK.F1057=SUB_LNK2.F1057 AND SUB_LNK2.F1000=BAT.F1000 
      JOIN STO_TAB SUB_STO ON SUB_LNK.F1000=SUB_STO.F1000 WHERE SUB_POS.F01=BAT.F01 ORDER BY SUB_STO.F1937 DESC);

/* WE KEEP THE UPC/VENDOR/TARGET FROM THIS IMPORT AND MUST DELETE ALL THE OTHERS */
@WIZRPL(BATCH_TMPNO=@DBGEN(F902,1));
@WIZRPL(BATCH_TMPTAB=@STORE@TER@WIZGET(BATCH_TMPNO));

SELECT COS.* INTO M@WIZGET(BATCH_TMPTAB) 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) TMP 
JOIN COST_TAB COS ON TMP.F01=COS.F01 AND TMP.F1000=COS.F1000 
WHERE TMP.F27<>COS.F27

IF EXISTS(SELECT * FROM M@WIZGET(BATCH_TMPTAB))
  INSERT INTO HEADER_DCT (F901,F902,F903,F913,F914,F912,F909,F916,F922) VALUES
  ('HM','@WIZGET(BATCH_TMPNO)','@STORE@TER','KINNEYDRUGS VENDORS CLEANUP','','REMOVE',CAST('@DSDF' AS DATETIME),
  'COST_CHG','LOGUPDATEBATCH=0')

/* IMPORT DEFAULT AND DROPPING UNWANTED FIELDS */
@WIZRPL(DEFAULTFLD=@DBHOT(KINNEYDRUG.INI,[DEFAULT_COST]*));
@WIZRPL(DEFAULTJOB=ADDRPL);
@EXEC(SQI=KDLOC_ItemImport_DEFAULT);

UPDATE HEADER_DCT SET F916=@FMT(CMP,@DBHOT(KINNEYDRUG.INI,[IMPORT]ITEMLOAD)=1,''KDLOC_ItemImport_loadcost'',''COST_CHG'') WHERE F903='@WIZGET(SOURCE)' AND F902='@WIZGET(BATCH)';

@ACTIVATE_HEADER(SELECT * FROM HEADER_DCT WHERE F913 LIKE 'KINNEY%' AND 0@DBHOT(INI,HOST_STORE.INI,ACTIVATE_ACCEPT,ITEM_CHG)=1);

@WIZCLR(DBASE_TIMEOUT);
