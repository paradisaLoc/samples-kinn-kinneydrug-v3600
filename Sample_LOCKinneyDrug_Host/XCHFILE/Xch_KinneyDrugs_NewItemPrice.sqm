INSERT INTO HEADER_DCT VALUES
('HM','000001','001','001','ERRORS.SIL','',@DJDD,0001,@DJDD,0001,,'ADDRPL','KINNEY NEW ITEM PRICE',,,,,0,'1/1.0','VER1','F01','LOGUPDATEBATCH=0');

CREATE TABLE TEMP_DCT (@dbDCT(F1000,F126,F27,F01,F154,F35,F31,F30,F140,F142,F1964,F1401,F1402,F1302));

CREATE VIEW ITEM_CHG AS SELECT F1000,F126,F27,F01,F154,F35,F31,F30,F140,F142,F1964,F1401,F1402,F1302 FROM TEMP_DCT;

INSERT INTO ITEM_CHG VALUES

@MAP_DETAIL1
F1000=FIX,PAL
F126=FIX,1
F27=CHAR,0,1
F01=CHAR,0,2
F154=CHAR,0,3
F35=DATEYYYYMMDD,0,5
F31=NUM,0,7,,2
F142=FIX
F30=NUM,0,8,,2
F140=FIX
F1964=FIX,@STORE
F1401=NUM,0,4
F1402=CHAR,0,6
F1302=FLAGYN,0,9


@WIZRPL(DBASE_TIMEOUT=E);

/* STRIP CHECK DIGIT ON EAN13 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET 
F154=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F154,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F154,13),12) ELSE RIGHT('0000000000000'+F154,13) END,
F01=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F01,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F01,13),12) ELSE RIGHT('0000000000000'+F01,13) END

/* IF F01 IS EMPTY OR ADSKU THEN USE F154 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F01=F154 WHERE F01='0000000000000' OR F1302=1;

/* IF F01 IS EMPTY THEN USE F154 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F01=F154 WHERE F01='0000000000000'

/* DELETE WHERE UPC VALUE IS EMPTY */
DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F01='0000000000000';

/* LOOKUP INCOMM ITEM AND SET FORCE PRICE FLAG WHEN PRICE IS 0 */
UPDATE POS SET POS.F83='1',POS.F1001='1'
,POS.F1120=ISNULL(POS.F1120,'')+CASE WHEN CHARINDEX('EZ',POS.F1120)=0 THEN 'EZ' ELSE '' END
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT
JOIN POS_TAB POS ON POS.F01=BAT.F01 
WHERE ISNULL(BAT.F30,0)=0 AND POS.F1785='INCOMM' AND (POS.F83!='1' OR CHARINDEX('EZ',POS.F1120)=0);

/* SET QUANTITY */
UPDATE BAT 
SET F142=CAST(SUBSTRING(ALT.F2660,12,2) AS INTEGER),F1001=2,F140=F30,F30=NULL,F31=NULL
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT JOIN ALT_TAB ALT ON BAT.F01=ALT.F01 AND BAT.F154=RIGHT('0000000000'+ALT.F154,13) 
WHERE ALT.F2660 LIKE '%KD.TOBACCO%';

UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F142=F31,F140=F30 WHERE ISNULL(F31,1)>1;
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F30=NULL,F31=NULL WHERE ISNULL(F31,1)>1;

/* CREATE INDEX */
CREATE INDEX IDX_M@WIZGET(SOURCE)@WIZGET(BATCH) ON M@WIZGET(SOURCE)@WIZGET(BATCH) (F01,F1000,F126,F27,F1401)

/* LOOKUP ITEMS IN KINNEY_VND_STORE_ITEM */
INSERT INTO M@WIZGET(SOURCE)@WIZGET(BATCH)(@DBFLD(M@WIZGET(SOURCE)@WIZGET(BATCH))) 
SELECT KIN.F1056 AS F1000,@DBFLD(M@WIZGET(SOURCE)@WIZGET(BATCH),BAT.,F1000) FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
JOIN KINNEY_VND_STORE_ITEM KIN ON KIN.F01=BAT.F01 AND KIN.F27=BAT.F27 JOIN STD_TAB STD ON STD.F1056=KIN.F1056 AND STD.F1545=BAT.F1401;

/* LOOKUP WHAREHOUSE ITEMS AGAINST PAL */
INSERT INTO M@WIZGET(SOURCE)@WIZGET(BATCH)(@DBFLD(M@WIZGET(SOURCE)@WIZGET(BATCH))) 
SELECT LNK.F1056 AS F1000,@DBFLD(M@WIZGET(SOURCE)@WIZGET(BATCH),BAT.,F1000) 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
JOIN LNK_TAB LNK ON LNK.F1000=BAT.F1000
WHERE BAT.F1401='1' AND BAT.F1402='Y' AND BAT.F1000='PAL' AND LNK.F1057='901' AND NOT EXISTS
(SELECT 1 FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1000=LNK.F1056 AND F01=BAT.F01 AND F126=BAT.F126);

DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1000='PAL';

/* DO 1 RECORD FOR CIGARETTE */
UPDATE PRI SET PRI.F142=BAT.F142,PRI.F140=BAT.F140
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) PRI JOIN M@WIZGET(SOURCE)@WIZGET(BATCH) BAT ON 
PRI.F01=BAT.F01 AND
PRI.F1000=BAT.F1000
WHERE PRI.F1001=1 AND
BAT.F1001=2;

DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1001=2;

/* IMPORT DEFAULT AND DROPPING UNWANTED FIELDS */
@WIZRPL(DEFAULTFLD=@DBHOT(KINNEYDRUG.INI,[DEFAULT_ITEMPRICE]*));
@WIZRPL(DEFAULTJOB=ADDRPL);
@EXEC(SQI=KDLOC_ItemImport_DEFAULT);

UPDATE HEADER_DCT SET F916=@FMT(CMP,@DBHOT(KINNEYDRUG.INI,[IMPORT]ITEMLOAD)=1,''KDLOC_ItemImport_loadprice'',''PRICE_CHG'') WHERE F903='@WIZGET(SOURCE)' AND F902='@WIZGET(BATCH)';

@ACTIVATE_HEADER(SELECT * FROM HEADER_DCT WHERE F903='@WIZGET(SOURCE)' AND F902='@WIZGET(BATCH)' AND 0@DBHOT(INI,HOST_STORE.INI,ACTIVATE_ACCEPT,ITEM_CHG)=1);

@WIZCLR(DBASE_TIMEOUT);

