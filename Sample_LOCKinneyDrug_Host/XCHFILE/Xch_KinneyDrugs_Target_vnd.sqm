CREATE TABLE TEMP_DCT (@dbDCT(F1000,F27,F1056,F1057,F1401));

CREATE VIEW TEMP_DB AS SELECT F1000,F27,F1056,F1057,F1401 FROM TEMP_DCT;

INSERT INTO TEMP_DB VALUES

@MAP_DETAIL1
F1000=FIX
F27=CHAR,0,1
F1056=NUM+1000,0,2;CHAR,2,3
F1057=FIX,901
F1401=CHAR,0,3


/* REMOVE STORE 999 FROM IMPORT */
DELETE TEMP_DB WHERE F1056='999';

/* ASSIGN TARGET TO TEMP_DB */
WITH n AS (
    SELECT 1 AS cnt
    UNION ALL
    SELECT cnt+1 FROM n WHERE cnt+1<=10000
)
UPDATE BAT SET BAT.F1000=ISNULL(STO.F1000,TMP.F1000)
FROM TEMP_DB BAT
LEFT OUTER JOIN STO_TAB STO ON BAT.F27=SUBSTRING(F1018,1,6)
LEFT OUTER JOIN (SELECT F27,ROW_NUMBER() OVER (ORDER BY F27) AS RN FROM TEMP_DB WHERE F27 NOT IN (SELECT DISTINCT SUBSTRING(F1018,1,6) FROM STO_TAB) GROUP BY F27) VND ON BAT.F27=VND.F27
LEFT OUTER JOIN
	(SELECT CNT.F1000,ROW_NUMBER() OVER (ORDER BY CNT.F1000) AS RN
	FROM (SELECT 'V'+RIGHT('0000'+CAST(cnt AS VARCHAR),4) AS F1000 FROM n ) CNT
	LEFT OUTER JOIN STO_TAB STO ON STO.F1000=CNT.F1000
	WHERE STO.F1000 IS NULL
	) TMP ON TMP.RN=VND.RN
option (maxrecursion 10000);

/* REMOVE STORE FROM TARGET IF FLAG IS SET TO DELETE */
DELETE LNK FROM LNK_TAB LNK JOIN TEMP_DB BAT ON BAT.F1000=LNK.F1000 AND BAT.F1401='D';

/* UPDATE LINK TABLE */
@UPDATE_BATCH(JOB=ADD,TAR=LNK_TAB,
KEY=F1000=:F1000 AND F1056=:F1056 AND F1057=:F1057,
SRC=SELECT F1000,F1056,F1057 FROM TEMP_DB WHERE F1401<>'D');

/* UPDATE TARGET TABLE */
@UPDATE_BATCH(JOB=ADDRPL,TAR=STO_TAB,
KEY=F1000=:F1000,
SRC=SELECT TMP.F1000,LEFT(TMP.F27,6)+':'+LEFT(VND.F334,33) AS F1018, 7 AS F1937,'1' AS F1180,'0' AS F1181,'1' AS F1182
FROM TEMP_DB TMP
JOIN VENDOR_TAB VND ON VND.F27=TMP.F27
WHERE TMP.F1401<>'D');

/* DELETE NO LONGER USED TARGET OR LINK*/
DELETE STO_TAB WHERE F1000 LIKE 'V____' AND NOT EXISTS (SELECT 1 FROM LNK_TAB WHERE F1000=STO_TAB.F1000);
DELETE LNK_TAB WHERE F1000 LIKE 'V____' AND NOT EXISTS (SELECT 1 FROM STO_TAB WHERE F1000=LNK_TAB.F1000);

DROP TABLE TEMP_DB;



