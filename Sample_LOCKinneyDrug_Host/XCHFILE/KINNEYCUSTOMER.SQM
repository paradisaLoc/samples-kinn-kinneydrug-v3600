UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1520 = 
CONVERT(DATETIME,SUBSTRING(CASE WHEN LEN(F1401)=7
THEN '0'+F1401 ELSE F1401 END,1,2)+'/'+SUBSTRING(CASE WHEN LEN(F1401)=7
THEN '0'+F1401 ELSE F1401 END,3,2)+'/'+SUBSTRING(CASE WHEN LEN(F1401)=7
THEN '0'+F1401 ELSE F1401 END,5,4))
WHERE LEN(F1401) IN (7,8);

