CREATE VIEW TMP_KDLOC_IMPORTLASTCOST AS SELECT F1000,F01,F1301 FROM TEMP_DCT;

INSERT INTO TMP_KDLOC_IMPORTLASTCOST VALUES

@MAP_DETAIL1
F1000=FILENAME,5,3
F01=CHAR,0,1
F1301=NUM,0,2,3,3

/* STRIP CHECK DIGIT ON EAN13 */
UPDATE TMP_KDLOC_IMPORTLASTCOST SET 
F01=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F01,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F01,13),12) ELSE RIGHT('0000000000000'+F01,13) END

/* DELETE WHERE UPC VALUE IS EMPTY */
DELETE FROM TMP_KDLOC_IMPORTLASTCOST WHERE F01='0000000000000';

/* DEPLOY TO STORE */
@WIZRPL(TARGET=@DBSELECT(SELECT TOP 1 F1000 FROM TMP_KDLOC_IMPORTLASTCOST));
@WIZRPL(BATCH=TMP_KDLOC_IMPORTLASTCOST);
@EXEC(SQM=KDLOC_EXPORTLASTCOST);

DROP TABLE TMP_KDLOC_IMPORTLASTCOST;
