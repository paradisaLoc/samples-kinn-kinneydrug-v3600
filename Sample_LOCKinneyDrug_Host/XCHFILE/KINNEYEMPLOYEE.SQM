CREATE TABLE TEMP_DCT (@dbDCT(F1152,F1153,F1000,F1001,F1148,F1149,F1150,F1156,F1158,F1170,F1159,F1401,F1155,F1172,F1520,F1527,F1643,F1157,F2597);

CREATE VIEW CLT_CHG AS SELECT F1152,F1153,F1000,F1001,F1148,F1149,F1150,F1156,F1158,F1170,F1159,F1401,F1155,F1172,F1520,F1527,F1643,F1157,F2597 FROM TEMP_DCT;

INSERT INTO CLT_CHG VALUES

@MAP_DETAIL1
IF=LINE=0
F1152=FIX,3
F1153=FIX,1
F1000=FIX,PAL
F1001=FIX,1
F1148=FIX,
F1149=CHAR,0,1
F1150=CHAR,0,2
F1156=CHAR,0,4
F1158=CHAR,0,5
F1170=CHAR,0,6
F1159=CHAR,0,7
F1401=CHAR,0,8
TXT1=FIX,' '
F1155=GET(F1149)+GET(TXT1)+GET(F1150);CHAR,1,35
F1172=NUM,0,8
F1527=CHAR,0,10
F1643=CHAR,0,11
F1157=CHAR,0,12
