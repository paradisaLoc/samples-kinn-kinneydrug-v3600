CREATE TABLE TEMP_DCT (@dbDCT(F1148,F64,F1034));

CREATE VIEW TEMP_DB AS SELECT F1148,F64,F1034 FROM TEMP_DCT;

INSERT INTO TEMP_DB VALUES

@MAP_DETAIL1
F1148=CHAR,0,1
F64=NUM,0,2,0,0
F1034=FIX,7902

DELETE FROM TEMP_DB WHERE F1148='' OR F1148 IS NULL;

/* CREATE TEMP TABLE TO CALCULATE MOVEMENT REQUIRED */
CREATE TABLE PTS_IMPORT_MVT@TER (@DBDCT(F1148,F1034,F64));

/* BEGIN SQL TRANSACTION */
@DBHOT(MSSQL,STARTTRANSACTION);

@UPDATE_BATCH(JOB=ADDRPL,TAR=PTS_IMPORT_MVT@TER,KEY=F1148=:F1148 AND F1034=:F1034,
SRC=SELECT 
 BAT.F1148
,CASE WHEN ISNULL(PAY.F64,0)>BAT.F64 THEN ISNULL(PAY.F64,0)-BAT.F64 ELSE BAT.F64-ISNULL(PAY.F64,0) END AS F64
,CASE WHEN ISNULL(PAY.F64,0)>BAT.F64 THEN 7802 ELSE 7702 END AS F1034
FROM TEMP_DB BAT
LEFT OUTER JOIN RPT_PAY_N PAY ON PAY.F1148=BAT.F1148 AND PAY.F1034=BAT.F1034 WHERE ISNULL(PAY.F64,0)!=BAT.F64);

/* UPDATE TRS_PAY */
@FMT(CMP,@DBSELECT(SELECT COUNT(*) FROM PTS_IMPORT_MVT@TER)=0,,"
®WIZRPL(F1032=®DBGEN(F1032,1))
®UPDATE_BATCH(JOB=ADDRPL,TAR=TRS_PAY,KEY=F254=:F254 AND F1056=:F1056 AND F1057=:F1057 AND F1148=:F1148 AND F1034=:F1034 AND F1032=:F1032 AND F1101=:F1101,
SRC=SELECT '®DSDF' AS F254,'®STORE' AS F1056,'®TER' AS F1057,F1148,®WIZGET(F1032) AS F1032,F1034,CAST(ROW_NUMBER() OVER (ORDER BY F1148) AS INT) AS F1101
,F64,0 AS F65,0 AS F67,GETDATE() AS F253, '®TIME' AS F1036,'Milk club adjustment' AS F1079,0 AS F1100,NULL AS F1765 FROM PTS_IMPORT_MVT®TER)")

/* DELETE EXISTING BALANCES */
DELETE RPT_PAY_N WHERE F1034=7902 AND F1148 IN (SELECT F1148 FROM PTS_IMPORT_MVT@TER);

/* UPDATE RPT_PAY_N */
@UPDATE_BATCH(JOB=ADDRPL,TAR=RPT_PAY_N,
KEY=F1148=:F1148 and F1034=:F1034,
SRC=SELECT F1148,7902 as F1034,F64,0 AS F65,0 AS F67,GETDATE() AS F253 FROM TEMP_DB);

/* END SQL TRANSACTION */
@DBHOT(MSSQL,COMMIT);

DROP TABLE PTS_IMPORT_MVT@TER;
DROP TABLE TEMP_DB;




