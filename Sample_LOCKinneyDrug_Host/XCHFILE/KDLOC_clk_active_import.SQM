INSERT INTO HEADER_DCT VALUES
('HM','000001','001','001','ERRORS.SIL','',@DJDD,0001,@DJDD,0001,,'ADDRPL','CLK_ACTIVATED',,,,,0,'1/1.0','VER1','F01','');

CREATE TABLE TEMP_DCT (@dbDCT(F1000,F1001,F1127,F1143,F1144,F1126,F1589,F1145,F1142,F1185,F1141,F1552,F2597));

CREATE VIEW CLK_RSP AS SELECT F1000,F1001,F1127,F1143,F1144,F1126,F1589,F1145,F1142,F1185,F1141,F1552,F2597 FROM TEMP_DCT;

INSERT INTO CLK_RSP VALUES

@MAP_DETAIL1
IF=LINE=2
F1000=FIX,PAL
F1001=FIX,1
F1127=CHAR,0,1
F1143=CHAR,0,1
F1144=CHAR,0,2
F1126=NUM,0,3
F1589=NUM,0,3
F1145=DATEMMDDYYYY,0,4,/
F1142=NUM,0,5
F1185=FIX
F1141=FIX
F1552=FIX
F2597=FIX,'Zebra1'

/* WE NEED AN RESTRICTION LEVEL, IF NULL DELETE THE LINE */
DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE NULLIF(F1142,0) IS NULL

/* TAKE MAX 8 DIGITS */
/* F1589 IS VARCHAR(15) MAX 999,999,999,999,999 AND F1126 IS INT MAX 2,147,483,647 */
/* IN THAT CASE WE WILL USE THE DATA FROM F1589 AND TAKE THE FIRST 8 DIGITS AND PUT IT */
/* IN F1126 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1589=LEFT(F1589,8), F1126=LEFT(F1589,8)

UPDATE TMP SET F1185=CLK.F1185,F1141=CLK.F1141,F1126=CLK.F1126,F1145=CLK.F1145
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) TMP 
JOIN CLK_TAB CLK ON CLK.F1126=TMP.F1126

UPDATE TMP SET F1185=(SELECT MAX(F1185) FROM CLK_TAB)+TMP2.ROW
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) TMP JOIN (SELECT ROW_NUMBER() OVER (ORDER BY F1126) AS row,* FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1185 IS NULL) TMP2 ON TMP.F1126=TMP2.F1126

UPDATE BAT SET F1141=CONCAT(RIGHT(CONCAT('0',DATEPART(MONTH,CONVERT(DATETIME2,BAT.F1145,1))),2),RIGHT(CONCAT('0',DATEPART(DAY,CONVERT(DATETIME2,BAT.F1145,1))),2))
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
LEFT JOIN CLK_TAB CLK ON BAT.F1126=CLK.F1126
WHERE CLK.F1141 IS NULL

/* DATE <=50 WILL SHOW AS 20XX, MAKE SURE WE SUPPORT EXAMPLE 1945 INSTEAD OF HAVING 2045 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1145=CASE WHEN F1145 > GETDATE() THEN DATEADD(year,-100,F1145) ELSE F1145 END

UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1000='PAL'

@FMT(CMP,@DBSELECT(SELECT COUNT(*) FROM M@WIZGET(SOURCE)@WIZGET(BATCH))=0,®DBEXEC(DELETE FROM HEADER_DCT WHERE F903=@WIZGET(SOURCE) AND F902=@WIZGET(BATCH))
®DBEXEC(DROP TABLE M@WIZGET(SOURCE)@WIZGET(BATCH)))
