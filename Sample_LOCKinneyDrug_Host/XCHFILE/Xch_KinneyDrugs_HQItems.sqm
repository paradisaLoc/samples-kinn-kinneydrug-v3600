F26=CHAR,0,55
F255=CHAR,0,58
F1964=FIX,@STORE
F18=IF,0,29,Y=894,ELSE=
F2931=IF,0,29,Y=894,ELSE=
F04=CHAR,0,9;CHAR,1,6
F1184=FIX,CASE
F1120=FIX,
F1401=CHAR,0,40
F1402=CHAR,0,22
F1403=CHAR,0,25
F1404=CHAR,0,26
F1517=CHAR,0,27
F21=CHAR,0,45
F107=FIX,1
F1236=FIX,1
F171=FIX,
F142=NUM,0,57;IF,1,2,1=
F1303=FLAGYN,0,48
F1304=NUM,0,59
F1305=NUM,0,60
F155=CHAR,0,61
F1119=CHAR,0,63;IF,1,1,Y=InstaCart,ELSE=
F2660=FIX
F1976=FIX
F1875=FIX,
F90=FIX,1
F85=FIX,
F115=FIX,

@WIZRPL(DBASE_TIMEOUT=E);

/* DELETE TIEMS HAVING DISPF SET to 1 */
DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1301=1;

/* STRIP INVALID ALTERNATE CODE */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F154='' WHERE F154 LIKE '%[^0-9]%';

/* STRIP CHECK DIGIT ON EAN13 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET 
F154=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F154,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F154,13),12) ELSE RIGHT('0000000000000'+F154,13) END,
F01=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F01,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F01,13),12) ELSE RIGHT('0000000000000'+F01,13) END,
F164=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F164,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F164,13),12) ELSE RIGHT('0000000000000'+F164,13) END

/* IF F01 IS EMPTY OR ADSKU THEN USE F154 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F01=F154 WHERE F01='0000000000000' OR F1302=1;

/* DELETE WHERE UPC VALUE IS EMPTY */
DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F01='0000000000000';

/* ONLY IMPORT ITMTYPE=0,1,102 */
DELETE FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F1401 NOT IN ('0','1','102');

/* SET F1120 */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1120=CASE WHEN F1402='Y' THEN ISNULL(F1120,'')+'MD' ELSE F1120 END;
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1120=CASE WHEN F1403='Y' THEN ISNULL(F1120,'')+'IL' ELSE F1120 END;
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1120=CASE WHEN F1404='Y' THEN ISNULL(F1120,'')+'D3' ELSE F1120 END;
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1120=CASE WHEN F1517='Y' THEN ISNULL(F1120,'')+'D5' ELSE F1120 END;
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1120=CASE WHEN RIGHT(F17,1) ='3' AND (F04<21500 OR F04>21599) THEN ISNULL(F1120,'')+'D2D4' ELSE F1120 END;

/* SET AGE REQUIRED to 21 FOR BEER AND WINE*/
/* UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F171=21 WHERE */
/* (F04>=21500 AND F04<=21599) OR */
/* (F04>=21600 AND F04<=21699);*/

/* SET AGE REQUIRED to 17 FOR OraQuick (HIV)*/
/* UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F171=17 WHERE */
/* F04=1405;*/

/* SET AGE REQUIRED to 18 FOR SMOKING CESSATION */
/* UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F171=18 WHERE */
/* F04=411;*/

/* SET AGE REQUIRED to 18 FOR COLD FLU DEX - DEPT41 CLASS 11 FOR NY ONLY */

/* SET AGE REQUIRED USING AGE IN URL FIELD FOR CIGARETTES -DEPT 2 AND ((NY and NOT class 10) or VT) */

/* SET AGEVERIFY FOR AGE 18*/
/* UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1785='AGEVERIFY' WHERE */
/* (F04 >=7700 AND F04<=7799) OR */
/* (F04>=20300 AND F04<=20399) OR*/
/* F04=3113;*/

/* SET AGE VERIFY OR F171 BASED ON IMPORT */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1785='AGEVERIFY',F2660='KD.AGE='+CAST(FLOOR(F1305) AS VARCHAR) WHERE F1304=2;
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F171=F1305 WHERE F1304=1;

/* INCOMM BEHAVIOR */
UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F1785='INCOMM' WHERE 
(F04>=4300 AND F04<=4399) OR
(F04>=4400 AND F04<=4499) OR
(F04>=8400 AND F04<=8499);

/* IMPORT DEFAULT AND DROPPING UNWANTED FIELDS */
@WIZRPL(DEFAULTTABLE=M@WIZGET(SOURCE)@WIZGET(BATCH));
@WIZRPL(BATCHTYPE=HQITEM);
@WIZRPL(HEADER_DCT[F913]=KINNEYDRUGS IMPORT);
@WIZRPL(DEFAULTFLD=@DBHOT(KINNEYDRUG.INI,[DEFAULT_@WIZGET(BATCHTYPE)]*));
@WIZRPL(DEFAULTJOB=ADDRPL);
@EXEC(SQI=KDLOC_ITEMIMPORT_DEFAULT);

/* CREATE OBJ */
@WIZRPL(BATCH_TMP=@DBGEN(F902,1));

@UPDATE_BATCH(JOB=ADD,TAR=HEADER_DCT,KEY=F902=:F902 AND F903=:F903,
SRC=SELECT 'HM' AS F901,'@WIZGET(BATCH_TMP)' AS F902,'@STORE@TER' AS F903,'KINNEYDRUGS IMPORT' AS F913,'' AS F914,
'ADDRPL' AS F912,CAST('@DSDF' AS DATETIME) AS F909,@FMT(CMP,@DBHOT(KINNEYDRUG.INI,[IMPORT]ITEMLOAD)=1,''KDLOC_ITEMIMPORT_LOADOBJ'',''OBJ_CHG'') AS F916,'LOGUPDATEBATCH=0' AS F922);
@WIZRPL(BATCH_TMP=@STORE@TER@WIZGET(BATCH_TMP));

@FMT(CMP,@DBHOT(FINDTABLE,M@WIZGET(BATCH_TMP))=,,'DROP TABLE M@WIZGET(BATCH_TMP)');
SELECT DISTINCT @DBCOL('FIELDS=@DBFLD(OBJ_TAB)',M@WIZGET(SOURCE)@WIZGET(BATCH),,,,'') 
INTO M@WIZGET(BATCH_TMP) 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH);
CREATE INDEX IDX_M@WIZGET(BATCH_TMP) ON M@WIZGET(BATCH_TMP) (F01)

/* CREATE POS */
@WIZRPL(BATCH_TMP=@DBGEN(F902,1));

@UPDATE_BATCH(JOB=ADD,TAR=HEADER_DCT,KEY=F902=:F902 AND F903=:F903,
SRC=SELECT 'HM' AS F901,'@WIZGET(BATCH_TMP)' AS F902,'@STORE@TER' AS F903,'KINNEYDRUGS IMPORT' AS F913,'' AS F914,
'ADDRPL' AS F912,CAST('@DSDF' AS DATETIME) AS F909,@FMT(CMP,@DBHOT(KINNEYDRUG.INI,[IMPORT]ITEMLOAD)=1,''KDLOC_ITEMIMPORT_LOADPOS'',''POS_CHG'') AS F916,'LOGUPDATEBATCH=0' AS F922);
@WIZRPL(BATCH_POS=@STORE@TER@WIZGET(BATCH_TMP));

/* INSERT PAL RECORD */
@FMT(CMP,@DBHOT(FINDTABLE,M@WIZGET(BATCH_POS))=,,'DROP TABLE M@WIZGET(BATCH_POS)');
SELECT 'PAL' AS F1000,F01,@DBCOL('FIELDS=@DBFLD(POS_TAB)',M@WIZGET(SOURCE)@WIZGET(BATCH),,,,'F01,F1000') 
INTO M@WIZGET(BATCH_POS) 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH)
WHERE F81=F1421 AND F96=F1422 AND F97=F1423 AND F98=F1424;
CREATE INDEX IDX_M@WIZGET(BATCH_POS) ON M@WIZGET(BATCH_POS) (F1000,F01)

/* INSERT ZNY RECORD */
INSERT INTO M@WIZGET(BATCH_POS) (F1000,F81,F96,@DBCOL('FIELDS=@DBFLD(POS_TAB)',M@WIZGET(SOURCE)@WIZGET(BATCH),,,,'F1000,F81,F96')) 
SELECT 'ZNY' AS F1000,F81,F96,@DBCOL('FIELDS=@DBFLD(POS_TAB)',M@WIZGET(SOURCE)@WIZGET(BATCH),,,,'F1000,F81,F96') 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH)
WHERE NOT(F81=F1421 AND F96=F1422 AND F97=F1423 AND F98=F1424);

/* INSERT ZVT RECORD */
INSERT INTO M@WIZGET(BATCH_POS) (F1000,F81,F96,F97,F98,@DBCOL('FIELDS=@DBFLD(POS_TAB)',M@WIZGET(SOURCE)@WIZGET(BATCH),,,,'F1000,F81,F96,F97,F98')) 
SELECT 'ZVT' AS F1000,F1421 AS F81,F1422 AS F96,F1423 AS F97,F1424 AS F98,@DBCOL('FIELDS=@DBFLD(POS_TAB)',M@WIZGET(SOURCE)@WIZGET(BATCH),,,,'F1000,F81,F96,F97,F98') 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH)
WHERE NOT(F81=F1421 AND F96=F1422 AND F97=F1423 AND F98=F1424);

UPDATE M@WIZGET(BATCH_POS) SET F171=18 WHERE (F04=411 OR F04=4111) AND F1000='ZNY';

/* FORCE PAL ON EXCEPTION TARGET NOT CREATED BY THE IMPORT ANYMORE- FORCE UPDATE ON EXISTING TARGET*/

INSERT INTO M@WIZGET(BATCH_POS) (F1000,@DBCOL('FIELDS=@DBFLD(POS_TAB)',M@WIZGET(BATCH_POS),,,,'F1000')) 
SELECT POS.F1000 AS F1000,@DBCOL('FIELDS=@DBFLD(POS_TAB)',M@WIZGET(BATCH_POS),BAT.,,,'F1000') 
FROM M@WIZGET(BATCH_POS) BAT
JOIN POS_TAB POS ON BAT.F01=POS.F01
WHERE BAT.F1000='PAL' AND (POS.F1000='ZVT' OR POS.F1000='ZNY')
AND POS.F1000 NOT IN (SELECT F1000 FROM M@WIZGET(BATCH_POS) WHERE F01=POS.F01);

/* UPDATE NOT IN NET BASED ON SUB-DEPARTMENT */
UPDATE POS SET F115=SDP.F115 FROM M@WIZGET(BATCH_POS) POS JOIN SDP_TAB SDP ON SDP.F04=POS.F04

@FMT(CMP,"@DBHOT(INI,KINNEYDRUG.INI,IMPORT,IncommPOR)=",,"UPDATE M@WIZGET(BATCH_POS) SET F1785='IncommPOR' WHERE F04 IN (@DBHOT(INI,KINNEYDRUG.INI,IMPORT,IncommPOR))");

@FMT(CMP,"@DBHOT(INI,KINNEYDRUG.INI,IMPORT,IncommReload)=",,"UPDATE M@WIZGET(BATCH_POS) SET F1785='IncommReload' WHERE F04 IN (@DBHOT(INI,KINNEYDRUG.INI,IMPORT,IncommReload))");

/* LOOK AT F1120 AND KEEP EZ (ENABLE ZERO) AND CO (CASHONLY) IF IT IS SET */
UPDATE M@WIZGET(BATCH_POS) SET F1120=ISNULL(BAT.F1120,'')+CASE WHEN POS.F1120 LIKE '%EZ%' THEN 'EZ' ELSE '' END + CASE WHEN POS.F1120 LIKE '%CO%' THEN 'CO' ELSE '' END 
FROM M@WIZGET(BATCH_POS) BAT
JOIN POS_TAB POS ON BAT.F01=POS.F01 AND BAT.F1000=POS.F1000
WHERE BAT.F902='@WIZGET(BATCH)' AND (POS.F1120 LIKE '%EZ%' OR POS.F1120 LIKE '%CO%');

/* CREATE PRI */
@WIZRPL(BATCH_TMP=@DBGEN(F902,1));

@UPDATE_BATCH(JOB=ADD,TAR=HEADER_DCT,KEY=F902=:F902 AND F903=:F903,
SRC=SELECT 'HM' AS F901,'@WIZGET(BATCH_TMP)' AS F902,'@STORE@TER' AS F903,'KINNEYDRUGS IMPORT' AS F913,'' AS F914,
'ADDRPL' AS F912,CAST('@DSDF' AS DATETIME) AS F909,@FMT(CMP,@DBHOT(KINNEYDRUG.INI,[IMPORT]ITEMLOAD)=1,''KDLOC_ITEMIMPORT_LOADPRICE'',''PRICE_CHG'') AS F916
,'LOGUPDATEBATCH=0' AS F922);
@WIZRPL(BATCH_TMP=@STORE@TER@WIZGET(BATCH_TMP));

/* LOOKUP ITEMS IN KINNEY_VND_STORE_ITEM */
SELECT KIN.F1056 AS F1000,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),PRICE_TAB,BAT.,,,'F1000') 
INTO M@WIZGET(BATCH_TMP) 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
JOIN KINNEY_VND_STORE_ITEM KIN ON KIN.F01=BAT.F01 AND KIN.F27=BAT.F27 JOIN STD_TAB STD ON STD.F1056=KIN.F1056;
CREATE INDEX IDX_M@WIZGET(BATCH_TMP) ON M@WIZGET(BATCH_TMP) (F1000,F01,F126)

/* LOOKUP WHAREHOUSE ITEMS AGAINST PAL */
INSERT INTO M@WIZGET(BATCH_TMP) (@DBFLD(M@WIZGET(BATCH_TMP)))
SELECT LNK.F1056 AS F1000,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),PRICE_TAB,BAT.,,,'F1000') 
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
JOIN LNK_TAB LNK ON LNK.F1000=BAT.F1000
WHERE BAT.F1303=1 AND BAT.F1000='PAL' AND LNK.F1057='901' AND NOT EXISTS
(SELECT 1 FROM M@WIZGET(BATCH_TMP) WHERE F1000=LNK.F1056 AND F01=BAT.F01 AND F126=BAT.F126);

/* CREATE SINGLE RECORD FOR CIGARETTE */
DELETE FROM M@WIZGET(BATCH_TMP) 
WHERE F01 IN (SELECT DISTINCT F01 FROM M@WIZGET(SOURCE)@WIZGET(BATCH) WHERE F142 IS NOT NULL) 
AND F142 IS NULL;

/* CREATING THE ALT CODE */
INSERT INTO ALT_TAB (F01,F1000,F154,F2660,F1874,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),ALT_TAB,,,,'F01,F1000,F126,F154,F2660'))
SELECT F01,F1000,F154,F2660,F1874,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),ALT_TAB,,,,'F01,F1000,F126,F154,F2660') FROM 
 (
  SELECT F01,'PAL' AS F1000,
   F154=CASE 
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR))<=6 THEN SUBSTRING(F154, PATINDEX('%[^0]%', F154), LEN(F154))
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR)) BETWEEN 7 AND 11 THEN RIGHT(F154,11)
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR))=12 THEN RIGHT(F154,12) END,
   F2660=CASE WHEN F142 IS NOT NULL THEN 'KD.TOBACCO='+CAST(CAST(F142 AS INT) AS VARCHAR) ELSE '' END,
   F1874=CASE WHEN F142 IS NOT NULL THEN 2 ELSE NULL END,
   @DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),ALT_TAB,,,,'F01,F1000,F126,F154,F2660'),
   ROW_NUMBER() OVER (PARTITION BY F154 ORDER BY F154) AS F1301
  FROM M@WIZGET(SOURCE)@WIZGET(BATCH)
  WHERE F154<>'0000000000000') TMP
WHERE F1301=1 AND
F154 NOT IN (SELECT F154 FROM ALT_TAB);

/* UPDATE WHEN ALTERNATE CODE IS ASSIGNED TO NEW UPC */
UPDATE ALT
SET ALT.F1874=BAT.F1874,
    ALT.F1898=BAT.F1898,
    ALT.F2660=BAT.F2660,
    ALT.F902=BAT.F902,
    ALT.F1001=BAT.F1001,
    ALT.F01=BAT.F01
FROM 
ALT_TAB ALT
JOIN 
 (SELECT F01,'PAL' AS F1000,
   F154=CASE 
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR))<=6 THEN SUBSTRING(F154, PATINDEX('%[^0]%', F154), LEN(F154))
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR)) BETWEEN 7 AND 11 THEN RIGHT(F154,11)
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR))=12 THEN RIGHT(F154,12) END,
   F2660=CASE WHEN F142 IS NOT NULL THEN 'KD.TOBACCO='+CAST(CAST(F142 AS INT) AS VARCHAR) ELSE '' END,
   F1874=CASE WHEN F142 IS NOT NULL THEN 2 ELSE NULL END,
   @DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),ALT_TAB,,,,'F01,F1000,F126,F154,F2660'),
   ROW_NUMBER() OVER (PARTITION BY F154 ORDER BY F154) AS F1301
  FROM M@WIZGET(SOURCE)@WIZGET(BATCH)
  WHERE F154<>'0000000000000') BAT ON 
BAT.F1000=ALT.F1000 AND
BAT.F154=ALT.F154
WHERE BAT.F1301=1 AND BAT.F01<>ALT.F01;

/* UPDATE CHANGES ON ALTERNATE CODES */
UPDATE ALT
SET ALT.F1874=BAT.F1874,
    ALT.F1898=BAT.F1898,
    ALT.F2660=BAT.F2660,
    ALT.F902=BAT.F902,
    ALT.F1001=1
FROM 
ALT_TAB ALT
JOIN 
 (SELECT F01,'PAL' AS F1000,
   F154=CASE 
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR))<=6 THEN SUBSTRING(F154, PATINDEX('%[^0]%', F154), LEN(F154))
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR)) BETWEEN 7 AND 11 THEN RIGHT(F154,11)
    WHEN LEN(CAST(CAST(F154 AS BIGINT) AS VARCHAR))=12 THEN RIGHT(F154,12) END,
   F2660=CASE WHEN F142 IS NOT NULL THEN 'KD.TOBACCO='+CAST(CAST(F142 AS INT) AS VARCHAR) ELSE '' END,
   F1874=CASE WHEN F142 IS NOT NULL THEN 2 ELSE NULL END,F1898,F902,
   ROW_NUMBER() OVER (PARTITION BY F154 ORDER BY F154) AS F1301
  FROM M@WIZGET(SOURCE)@WIZGET(BATCH)
  WHERE F154<>'0000000000000') BAT ON BAT.F1000=ALT.F1000 AND BAT.F154=ALT.F154 AND BAT.F01=ALT.F01
WHERE BAT.F1301=1 AND
(ALT.F1874<>BAT.F1874 OR ALT.F1898<>BAT.F1898 OR ALT.F2660<>BAT.F2660);

/* CREATE COST */
@WIZRPL(BATCH_TMP=@DBGEN(F902,1));

@UPDATE_BATCH(JOB=ADD,TAR=HEADER_DCT,KEY=F902=:F902 AND F903=:F903,
SRC=SELECT 'HM' AS F901,'@WIZGET(BATCH_TMP)' AS F902,'@STORE@TER' AS F903,'KINNEYDRUGS IMPORT' AS F913,'' AS F914,
'ADDRPL' AS F912,CAST('@DSDF' AS DATETIME) AS F909,@FMT(CMP,@DBHOT(KINNEYDRUG.INI,[IMPORT]ITEMLOAD)=1,''KDLOC_ITEMIMPORT_LOADCOST'',''COST_CHG'') AS F916
,'LOGUPDATEBATCH=0' AS F922);
@WIZRPL(BATCH_TMP=@STORE@TER@WIZGET(BATCH_TMP));


/* LOOKUP ITEMS IN KINNEY_VND_STORE_ITEM */
SELECT KIN.F1056 AS F1000,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),COST_TAB,BAT.,,,'F1000,F08') 
INTO M@WIZGET(BATCH_TMP) FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT 
JOIN KINNEY_VND_STORE_ITEM KIN ON KIN.F01=BAT.F01 AND KIN.F27=BAT.F27 JOIN STD_TAB STD ON STD.F1056=KIN.F1056;
CREATE INDEX IDX_M@WIZGET(BATCH_TMP) ON M@WIZGET(BATCH_TMP) (F1000,F01,F27,F1184)

/* LOOKUP WHAREHOUSE ITEMS AGAINST PAL */
INSERT INTO M@WIZGET(BATCH_TMP) (@DBFLD(M@WIZGET(BATCH_TMP))) 
SELECT LNK.F1056 AS F1000,@DBCOL(M@WIZGET(SOURCE)@WIZGET(BATCH),COST_TAB,BAT.,,,'F1000,F08')
FROM M@WIZGET(SOURCE)@WIZGET(BATCH) BAT
JOIN LNK_TAB LNK ON LNK.F1000=BAT.F1000
WHERE BAT.F1303=1 AND BAT.F1000='PAL' AND LNK.F1057='901' AND NOT EXISTS
(SELECT 1 FROM M@WIZGET(BATCH_TMP) WHERE F1000=LNK.F1056 AND F01=BAT.F01 AND F27=BAT.F27 AND F1184=BAT.F1184);

/*MARGIN COST*/

UPDATE BAT SET BAT.F1976=CASE WHEN (SDEP.F49 IS NULL) THEN '' ELSE '%COST=' + CAST((100-SDEP.F49) AS VARCHAR) END,
BAT.F1875=CASE WHEN (SDEP.F49 IS NULL) THEN '' ELSE 'C' END
FROM M@WIZGET(BATCH_TMP) BAT
JOIN M@WIZGET(BATCH_POS) POS ON BAT.F01=POS.F01
JOIN SDP_TAB SDEP ON POS.F04=SDEP.F04
WHERE 
POS.F1000=(SELECT TOP 1 SUB_POS.F1000 FROM M@WIZGET(BATCH_POS) SUB_POS 
      JOIN LNK_TAB SUB_LNK ON SUB_POS.F1000=SUB_LNK.F1000 
      JOIN LNK_TAB SUB_LNK2 ON SUB_LNK.F1056=SUB_LNK2.F1056 AND SUB_LNK.F1057=SUB_LNK2.F1057 AND SUB_LNK2.F1000=BAT.F1000 
      JOIN STO_TAB SUB_STO ON SUB_LNK.F1000=SUB_STO.F1000 WHERE SUB_POS.F01=BAT.F01 ORDER BY SUB_STO.F1937 DESC);

/* WE KEEP THE UPC/VENDOR/TARGET FROM THIS IMPORT AND MUST DELETE ALL THE OTHERS */
@WIZRPL(BATCH_TMPNO=@DBGEN(F902,1));
@WIZRPL(BATCH_TMPTAB=@STORE@TER@WIZGET(BATCH_TMPNO));

SELECT COS.* INTO M@WIZGET(BATCH_TMPTAB) 
FROM M@WIZGET(BATCH_TMP) TMP 
JOIN COST_TAB COS ON TMP.F01=COS.F01 AND TMP.F1000=COS.F1000 
WHERE TMP.F27<>COS.F27

IF EXISTS(SELECT * FROM M@WIZGET(BATCH_TMPTAB))
  INSERT INTO HEADER_DCT (F901,F902,F903,F913,F914,F912,F909,F916,F922) VALUES
  ('HM','@WIZGET(BATCH_TMPNO)','@STORE@TER','KINNEYDRUGS VENDORS CLEANUP','','REMOVE',CAST('@DSDF' AS DATETIME),
  'COST_CHG','LOGUPDATEBATCH=0')

/* CLEAN UP SOURCE BATCH */
DELETE FROM HEADER_DCT WHERE F903='@WIZGET(SOURCE)' AND F902='@WIZGET(BATCH)';
DROP TABLE M@WIZGET(SOURCE)@WIZGET(BATCH);

@ACTIVATE_HEADER(SELECT * FROM HEADER_DCT WHERE F913 LIKE 'KINNEY%' AND 0@DBHOT(INI,HOST_STORE.INI,ACTIVATE_ACCEPT,ITEM_CHG)=1);

@WIZCLR(DBASE_TIMEOUT);
