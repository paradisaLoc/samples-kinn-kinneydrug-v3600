F80=FLAGYN,0,29
F1744=NUM,0,30,,3;IF,1,10,0=
F81=FLAGYN,0,31;IF,1,1,=0
F96=FLAGYN,0,32;IF,1,1,=0
F97=FLAGYN,0,33;IF,1,1,=0
F98=FLAGYN,0,34;IF,1,1,=0
F1421=FLAGYN,0,36;IF,1,1,=0
F1422=FLAGYN,0,37;IF,1,1,=0
F1423=FLAGYN,0,38;IF,1,1,=0
F1424=FLAGYN,0,39;IF,1,1,=0
F79=FLAGYN,0,35
F170=FLAGYN,0,41
F86=FLAGYN,0,42
F1785=FLAGYN,0,43;IF,1,1,1=METHCHECK,ELSE=
F1898=FLAGYN,0,52;IF,1,1,=0
