INSERT INTO HEADER_DCT VALUES
('HM','000001','001','001','ERRORS.SIL','',@DJDD,0001,@DJDD,0001,,'ADDRPL','KINNEY HQ ITEMS',,,,,0,'1/1.0','VER1','F01','LOGUPDATEBATCH=0');

CREATE TABLE TEMP_DCT (@dbDCT(F1000,F01,F154,F27,F29,F155,F22,F23,F17,F08,F193,F1738,F02,F05,F164,F80,F1744,F1785,F81,F96,F97,F98,F1421,F1422,F1423,F1424,F79,F170,F86,F85,F1898,F122,F26,F255,F1964,F18,F04,F1184,F1401,F1402,F1403,F1404,F1517,F1120,F21,F107,F1236,F171,F142,F1303,F1301,F1302,F1304,F1305,F2660,F1875,F1976,F115,F90,F1119,F2931));

CREATE VIEW ITEM_CHG AS SELECT F1000,F01,F154,F27,F29,F155,F22,F23,F17,F08,F193,F1738,F02,F05,F164,F80,F1744,F1785,F81,F96,F97,F98,F1421,F1422,F1423,F1424,F79,F170,F86,F85,F1898,F122,F26,F255,F1964,F18,F04,F1184,F1401,F1402,F1403,F1404,F1517,F1120,F21,F107,F1236,F171,F142,F1303,F1301,F1302,F1304,F1305,F2660,F1875,F1976,F115,F90,F1119,F2931 FROM TEMP_DCT;

INSERT INTO ITEM_CHG VALUES

@MAP_DETAIL1
F1000=FIX,PAL
F01=CHAR,0,1
F154=CHAR,0,2
F27=CHAR,0,3
F29=CHAR,0,4
