CREATE TABLE TEMP_DCT (@dbDCT(F01,F154,F1056,F27,F1401,F1301,F1302));

CREATE VIEW TMP_@STORE@TER_VND_STOR AS SELECT F01,F154,F1056,F27,F1401,F1301,F1302 FROM TMP_TABLE;

INSERT INTO TMP_@STORE@TER_VND_STOR VALUES

@MAP_DETAIL1
F01=CHAR,0,1
F154=CHAR,0,2
F1056=NUM+1000,0,3;CHAR,2,3
F27=CHAR,0,4
F1401=CHAR,0,5
F1301=FIX,0
F1302=FLAGYN,0,6

@WIZRPL(DBASE_TIMEOUT=E);

/* STRIP CHECK DIGIT ON EAN13 */
UPDATE TMP_@STORE@TER_VND_STOR SET 
F154=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F154,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F154,13),12) ELSE RIGHT('0000000000000'+F154,13) END,
F01=CASE WHEN SUBSTRING(RIGHT('0000000000000'+F01,13),1,1)<>'0' THEN '0'+LEFT(RIGHT('0000000000000'+F01,13),12) ELSE RIGHT('0000000000000'+F01,13) END

/*IF ADSKU THEN USE F154 */
UPDATE TMP_@STORE@TER_VND_STOR SET F01=F154 WHERE F1302=1;

/* IF F01 IS EMPTY THEN USE F154 */
UPDATE TMP_@STORE@TER_VND_STOR SET F01=F154 WHERE F01='0000000000000'

/* DELETE WHERE UPC VALUE IS EMPTY */
DELETE FROM TMP_@STORE@TER_VND_STOR WHERE F01='0000000000000';

/* TAG NEW RECORDS FOR DEPLOY */
UPDATE TMP_@STORE@TER_VND_STOR SET F1301=1
FROM TMP_@STORE@TER_VND_STOR WHERE F1401<>'D' AND 
NOT EXISTS (SELECT F01 FROM KINNEY_VND_STORE_ITEM WHERE F01=TMP_@STORE@TER_VND_STOR.F01 AND F1056=TMP_@STORE@TER_VND_STOR.F1056 AND F27=TMP_@STORE@TER_VND_STOR.F27);

INSERT INTO KINNEY_VND_STORE_ITEM(F01,F1056,F27) 
SELECT DISTINCT F01,F1056,F27 
FROM TMP_@STORE@TER_VND_STOR WHERE F1301=1

DELETE FROM KINNEY_VND_STORE_ITEM
WHERE EXISTS (SELECT F01 FROM TMP_@STORE@TER_VND_STOR WHERE F1401='D' AND F01=KINNEY_VND_STORE_ITEM.F01 AND F1056=KINNEY_VND_STORE_ITEM.F1056 AND F27=KINNEY_VND_STORE_ITEM.F27);

/* DEPLOY NEW ITEM ONLY */
DELETE FROM TMP_@STORE@TER_VND_STOR WHERE F1301=0;
@WIZSET(KD.DEPLOY_TABLE=TMP_@STORE@TER_VND_STOR);
@EXEC(SQM=KDLOC_ItemImport_newcostdeploy.sqm);
@EXEC(SQM=KDLOC_ItemImport_newpricedeploy.sqm);
@EXEC(SQM=KDLOC_ItemImport_exec.sqm);

DROP TABLE TMP_@STORE@TER_VND_STOR;

@WIZCLR(DBASE_TIMEOUT);

