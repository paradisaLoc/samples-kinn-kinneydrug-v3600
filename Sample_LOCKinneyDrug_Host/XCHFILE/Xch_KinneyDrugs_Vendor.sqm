INSERT INTO HEADER_DCT VALUES
('HM','000001','001','001','ERRORS.SIL','',@DJDD,0001,@DJDD,0001,,'ADDRPL','KINNEY VENDORS',,,,,0,'1/1.0','VER1','F01','');

CREATE TABLE TEMP_DCT (@dbDCT(F1000,F1964,F27,F334,F336,F337,F338,F339,F340,F341,F342,F2603,F344,F1779,F1949));

CREATE VIEW VENDOR_CHG AS SELECT F1000,F1964,F27,F334,F336,F337,F338,F339,F340,F341,F342,F2603,F344,F1779,F1949 FROM TEMP_DCT;

INSERT INTO VENDOR_CHG VALUES

@MAP_DETAIL1
F1000=FIX,PAL
F1964=FIX,@STORE
F27=CHAR,0,1
F334=CHAR,0,2
F336=CHAR,0,3
F337=CHAR,0,4
F338=CHAR,0,5
F339=CHAR,0,6
F340=CHAR,0,8
F341=CHAR,0,9
F342=CHAR,0,10
F2603=CHAR,0,11
F344=CHAR,0,12
TXT1=CHAR,0,15
TXT2=CHAR,0,16
TXT3=CHAR,0,17
TXT4=CHAR,0,18
TXT5=CHAR,0,19
TXT6=CHAR,0,20
TXT7=CHAR,0,21
TXT8=CHAR,0,22
TXT10=FIX,' '
TXT11=GET(TXT1)+GET(TXT10)+GET(TXT2)+GET(TXT10)+GET(TXT3)+GET(TXT10)+GET(TXT4);CHAR,1,120
TXT12=GET(TXT5)+GET(TXT10)+GET(TXT6)+GET(TXT10)+GET(TXT7)+GET(TXT10)+GET(TXT8);CHAR,1,120
F1779=GET(TXT11)+GET(TXT12);CHAR,1,120
F1949=CHAR,0,28


/* IMPORT DEFAULT AND DROPPING UNWANTED FIELDS */
@WIZRPL(DEFAULTTABLE=M@WIZGET(SOURCE)@WIZGET(BATCH));
@WIZRPL(BATCHTYPE=VENDOR);
@WIZRPL(DEFAULTFLD=@DBHOT(KINNEYDRUG.INI,[DEFAULT_@WIZGET(BATCHTYPE)]*));
@WIZRPL(DEFAULTJOB=ADDRPL);
@EXEC(SQI=KDLOC_ItemImport_DEFAULT);


/* ACTIVATE AUTOMATICALLY */
@ACTIVATE_HEADER(SELECT * FROM HEADER_DCT WHERE F903='@WIZGET(SOURCE)' AND F902='@WIZGET(BATCH)' AND 0@DBHOT(INI,HOST_STORE.INI,ACTIVATE_ACCEPT,ITEM_CHG)=1);


