CREATE TABLE TEMP_DCT (@dbDCT(F1148,F1155,F1153,F1165,F65,F1160,F253));

CREATE VIEW TMP_KINNEY AS SELECT F1148,F1155,F1153,F1165,F65,F1160,F253 FROM TEMP_DCT;

INSERT INTO TMP_KINNEY VALUES

@MAP_DETAIL1
IF=LINE=0
F1148=CHAR,0,1
F1155=CHAR,0,2
F1153=NUM,0,3
F1165=NUM,0,4,2,2
F65=NUM,0,5,2,2
F1160=CHAR,0,6;IF,1,10,Y=1234
F253=DATENOW

@UPDATE_BATCH(JOB=ADDRPL,TAR=KINNEY_AR_ACC,KEY=F1148=:F1148,
SRC=SELECT TMP.F1148,TMP.F1155,TMP.F1153,7501 AS F1034,0 AS F64,TMP.F65,0 AS F67,TMP.F253,TMP.F1160,TMP.F1165 
FROM (SELECT F1148,MAX(F1155) AS F1155,MAX(F1153) AS F1153,MAX(F65) AS F65,MAX(F253) AS F253,MAX(F1160) AS F1160,MAX(F1165) AS F1165 FROM TMP_KINNEY GROUP BY F1148) TMP
LEFT OUTER JOIN KINNEY_AR_ACC KIN ON TMP.F1148=KIN.F1148
WHERE ISNULL(TMP.F65,0)<>ISNULL(KIN.F65,0) OR ISNULL(TMP.F1153,0)<>ISNULL(KIN.F1153,0) OR ISNULL(TMP.F1155,0)<>ISNULL(KIN.F1155,0) OR ISNULL(TMP.F1160,'')<>ISNULL(KIN.F1160,'') OR ISNULL(TMP.F1165,0)<>ISNULL(KIN.F1165,0) OR KIN.F1148 IS NULL);


