INSERT INTO HEADER_DCT VALUES
('HM','000001','001','001','ERRORS.SIL','',@DJDD,0001,@DJDD,0001,,'ADDRPL','KINNEY CATEGORY',,,,,0,'1/1.0','VER1','F01','');

CREATE TABLE TEMP_DCT (@dbDCT(F1000,F17,F1023,F1943,F1944,F1945,F1401,F1402,F1403));

CREATE VIEW CAT_CHG AS SELECT F1000,F17,F1023,F1943,F1944,F1945,F1401,F1402,F1403 FROM TEMP_DCT;

INSERT INTO CAT_CHG VALUES

@MAP_DETAIL1
F1000=FIX,PAL
F17=FIX,''
F1023=CHAR,0,7
F1943=CHAR,0,4
F1944=CHAR,0,5
F1945=CHAR,0,6
F1401=CHAR,0,1
F1402=CHAR,0,2
F1403=CHAR,0,3


UPDATE M@WIZGET(SOURCE)@WIZGET(BATCH) SET F17= 
CASE WHEN LEN(F1402)=2
THEN F1401+F1402+F1403
ELSE F1401+'0'+F1402+F1403
END;

/*Activate batch */
@ACTIVATE_HEADER(SELECT * FROM HEADER_DCT WHERE F913='KINNEY CATEGORY');



