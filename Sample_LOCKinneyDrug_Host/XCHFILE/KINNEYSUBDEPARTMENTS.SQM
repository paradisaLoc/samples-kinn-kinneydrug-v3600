CREATE TABLE TEMP_DCT (@dbDCT(F1000,F1964,F03,F04,F1022,F49,F1401,F1402,F1403,F1404));

CREATE VIEW SDP_CHG AS SELECT F1000,F1964,F03,F04,F1022,F49,F1401,F1402,F1403,F1404 FROM TEMP_DCT;

INSERT INTO SDP_CHG VALUES

@MAP_DETAIL1
F1000=FIX,PAL
F1964=FIX,@STORE
F03=CHAR,0,1
F04=FIX,1
F1022=FIX,1
F49=CHAR,0,19;IF,1,255,=,'ELSE=@NUM,1,255,2,2@'
F1401=CHAR,0,1
F1402=CHAR,0,2
F1403=CHAR,0,5
F1404=CHAR,0,6


