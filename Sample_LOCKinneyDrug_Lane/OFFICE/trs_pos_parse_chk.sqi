/* SHOW FORM */

@WIZRPL(STATE=MODAL);
@WIZRPL(FORM=CHECK);
@WIZRPL(TITLE=Check information);
@WIZCLR(FRAME);

@FMT(CMP,@WIZGET(CARDTYPE)<>,®EXEC(XCH=MICREJECT)®WIZRPL(HTT=TRS_POS_PARSE_CHK));
@FMT(CMP,@WIZGET(PAYCHECKACCOUNT)=,®EXEC(XCH=MICREJECT)®WIZRPL(HTT=TRS_POS_PARSE_CHK));
@EXEC();

@WIZCLR(FORM);
@WIZCLR(STATE);
@WIZCLR(TITLE);

/* CANCEL WAS PRESSED */

@FMT(CMP,@WIZGET(CLOSE)=Cancel,'®EXEC(FCT=30)®FMT(CHR,27)');

/* CHECK DECODING MUST WORK */

@FMT(CMP,@WIZGET(CARDTYPE)@WIZGET(PAYCHECKACCOUNT)=,"®WIZCLR(ENTRYNUMBER)®EXEC(MSG='!Check decoding error')®FMT(CHR,27)");

/* BUILD CHECK REFERENCES */

@WIZRPL(PAYTRACK=@WIZGET(ENTRYNUMBER));
@WIZRPL(ENTRYNUMBER=@WIZGET(PAYCHECKROUTING)-@WIZGET(PAYCHECKACCOUNT));

/* BUILD A MICR LINE IF CHECK ENTERED MANUALLY */

@FMT(CMP,@WIZGET(PAYTRACK)=,®WIZRPL(PAYTRACK=®WIZGET(ENTRYNUMBER)));

