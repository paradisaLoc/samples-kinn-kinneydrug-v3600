/* GET THE QUANTITY SOLD OF THE PET RX ITEMS WHERE PARTIAL FILL SEQUENCE IS NOT 1 OR 01 */
@wizRpl(MCK_REFILL_PET_CPN=@FMT(#,@dbSelect(SELECT SUM(F64) FROM SAL_REG WHERE F1032 = @fmt(#,@dbHot(SAL_HDR,F1032,#)) AND F1069 = '0' AND F01='@dbHot(INI,LINK_MCKESSON.INI,GENERAL,PETITEM)' AND (F1081 LIKE '%MCK_PARTIALFILLSEQ=[^1],%' OR F1081 LIKE '%MCK_PARTIALFILLSEQ=0[^1],%' OR F1081 LIKE '%MCK_PARTIALFILLSEQ=[1-9][0-9],%'))));

/* SET COUPON QTY BASED ON RX ITEMS NOT HAVING A PARTIAL FILL */
@WIZRPL(CPN_ZVTPETRX_QTY=@WIZGET(MCK_REFILL_PET_CPN));

