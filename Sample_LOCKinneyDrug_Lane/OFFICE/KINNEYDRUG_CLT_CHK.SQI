/* CHECK IF TRANSACTION IS STARTED */
@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)=2,,'®EXEC(MSG=!Transaction_not_started)®FMT(CHR,27)');

/* FIND DRIVER LICENCE # AND STATE FROM SAL_HDR */
@FMT(CMP,@WIZGET(PAYCHECKID)=,'®WIZRPL(PAYCHECKID=®FMT(COMA,DL.IdNumber,L,,®DBHOT(SAL_HDR,F1254,L)))');
@FMT(CMP,@WIZGET(PAYCHECKSTATECODE)=,'®WIZRPL(PAYCHECKSTATECODE=®FMT(COMA,DL.IdIssuingAgency,L,,®DBHOT(SAL_HDR,F1254,L)))');

/* GET ALPHA PARAMETERS */
@DBVIEW(Q1,SELECT F1081=dbo.KDLOC_REPLACE_F1081(122,102));

/* IF NO CUSTOMER - CALL CHECK TENDER AND QUIT */
@FMT(CMP,@DBHOT(SAL_HDR,F1148,L)=,'®EXEC(FCT=122,®DBROW(Q1,F1081,RAW))®FMT(CHR,26)');

/* IF HOME ACCOUNT - CALL CHECK TENDER AND QUIT */
@FMT(CMP,@DBHOT(SAL_HDR,F1148,L)=49999999999,'®EXEC(FCT=122,®DBROW(Q1,F1081,RAW))®FMT(CHR,26)');

/* FIND DRIVER LICENCE # FROM CUSTOMER ALTERNATE TABLE */
@WIZRPL(DB_PAYCHECKID=@DBSELECT(SELECT CASE WHEN CHARINDEX('|', F1577) > 0 THEN SUBSTRING(F1577, 0, CHARINDEX('|', F1577)) ELSE F1577 END AS F1577 FROM CLL_TAB WHERE F1148='@DBHOT(SAL_HDR,F1148,L)' AND F1578='DL'));

/* FIND STATE FROM CUSTOMER ALTERNATE TABLE */
@WIZRPL(DB_PAYCHECKSTATECODE=@DBSELECT(SELECT CASE WHEN CHARINDEX('|', F1577) > 0 THEN SUBSTRING(F1577, CHARINDEX('|', F1577)+1, LEN(F1577)) ELSE '' END AS F1577 FROM CLL_TAB WHERE F1148='@DBHOT(SAL_HDR,F1148,L)' AND F1578='DL'));

/* LICENCE NUMBER FROM SCAN HAS PRIORITY - ELSE USE CUSTOMER DATABASE */
@FMT(CMP,@WIZGET(PAYCHECKID)=,'®WIZRPL(PAYCHECKID=®WIZGET(DB_PAYCHECKID))');

/* STATE FROM SCAN HAS PRIORITY - ELSE USE CUSTOMER DATABASE */
@FMT(CMP,@WIZGET(PAYCHECKSTATECODE)=,'®WIZRPL(PAYCHECKSTATECODE=®WIZGET(DB_PAYCHECKSTATECODE))');

/* REPLACE CUSTOMER PAY VALUES FROM ACCOUNT */
@FMT(CMP,@DBHOT(SAL_HDR,F1172,L)=,,'®WIZRPL(PayPhone=®DBHOT(SAL_HDR,F1172,L))');
@FMT(CMP,@DBHOT(SAL_HDR,F1520,DADD)=,,'®WIZRPL(PayBirthday=®DBHOT(SAL_HDR,F1520,DADD))');
@FMT(CMP,@DBHOT(SAL_HDR,F1150,L)=,,'®WIZRPL(PayCheckLastName=®DBHOT(SAL_HDR,F1150,L))');

/* CALL FUNCTION CHECK 122 */
@EXEC(FCT=122,@DBROW(Q1,F1081,RAW));