/* PROHIBIT QUANTITY */
@FMT(CMP,@dbHot(HOT_MEM,CLTENTRYUNIT)=,,'®EXEC(MSG=!Quantity_prohibited)®FMT(CHR,27)');

/* REFUND KEY PROHIBIT */
@FMT(CMP,@dbHot(HOT_MEM,CLTRETURNKEY)>0,'®EXEC(MSG=!Refund_key_prohibited)®FMT(CHR,27)');

/* REFUND MODE PROHIBIT */
@FMT(CMP,@dbHot(HOT_MEM,CLTRETURNMODE)>0,'®EXEC(MSG=!Refund_mode_prohibited)®FMT(CHR,27)');

/* ALLOW PROMPT ENTRY */
@FMT(CMP,@WIZEXIST(MESSAGE)=1,,'®WIZSET(ITM=®FMT(S1:11,®WIZGET(LIVEENTRY)))®WIZSET(ENTRYNUMBER=®FMT(S12:30,®WIZGET(LIVEENTRY)))®WIZRPL(ENTRY=)');

@EXEC(MSG='#PLU=@WIZGET(ITM)');
/* ITEM CHECK VALIDITY */
@FMT(CMP,@FMT(LEN,@WIZGET(ITM))=11,,'®EXEC(MSG=!Incomplete_Code_@WIZGET(ITM))®FMT(CHR,27)');

/* CHECK DIGIT IN ITEM CODE */
@FMT(CMP,@FMT(LEN,@WIZGET(ENTRYNUMBER))=1,'®WIZCLR(ENTRYNUMBER)');


@FMT(CMP,@WIZGET(ENTRYNUMBER)=,"®EXEC(MSG='Please swipe card')®EXEC(XCH=MSRSWIPE)");
@FMT(CMP,@WIZGET(MSRSWIPE)=0,"®EXEC(MSG='!Swipe error')®FMT(CHR,27)");


@WIZRPL(PAYTRACK_PAN=@TOOLS(PARAM,=,1,@WIZGET(PAYTRACK)));
@FMT(CMP,@WIZGET(ENTRYNUMBER)@WIZGET(PAYTRACK_PAN)=,'®EXEC(MSG=!Invalid_card_number)®FMT(CHR,27)');
@FMT(CMP,@WIZGET(PAYTRACK_PAN)<>,'®WIZRPL(ENTRYNUMBER=®WIZGET(PAYTRACK_PAN))®WIZRPL(PAYTRACK=®WIZGET(PAYTRACK_PAN))');


/* CARD CHECK VALIDITY */

@EXEC(MSG='#Card=@WIZGET(ENTRYNUMBER)');
@FMT(CMP,@FMT(LEN,@WIZGET(ENTRYNUMBER))>=16,'®WIZRPL(PAYENTRYTYPE=B)','®WIZSET(MSG=!Invalid_card_code®WIZGET(ENTRYNUMBER))');
@FMT(CMP,@WIZGET(MSR)-@FMT(LEN,@WIZGET(ENTRYNUMBER))=1-0,'®WIZCLR(MSG)');
@FMT(CMP,@WIZEXIST(MSG)=1,'®EXEC()®FMT(CHR,27)');


@WIZSET(CardType=T);
@WIZRPL(ENTRY_ITEMCODE=@wizget(ITM));
@WIZSET(PayTranCode=208);
@WIZSET(ConfirmAmount=1);
@WIZSET(ScanSign=0);
@FMT(CMP,@WIZGET(DESACTIVATE)=1,®WIZRPL(PayTranMode=N)®WIZRPL(PayTranCode=205)®WIZRPL(SAL_REG[F160]=1));

@FMT(CMP,@DBHOT(HOT_WIZ,GET,PRESCAN)=1,'®DBHOT(HOT_WIZ,RPLT,PRESCAN,2)®POST(CN=@CNC,SQI=Kinney_ReturnOnGiftCard,ENTRY_ITEMCODE=®WIZGET(ENTRY_ITEMCODE),ENTRYNUMBER=®WIZGET(ENTRYNUMBER))®EXEC(FCT=30)®FMT(CHR,27)');
@FMT(CMP,@DBHOT(HOT_WIZ,GET,PRESCAN)=3,'®DBHOT(HOT_WIZ,CLR,PRESCAN)®WIZRPL(ENTRY=@WIZGET(PAYAMNT))');

/* @FMT(CMP,@WIZGET(DESACTIVATE)=1,®WIZRPL(PayTranCode=205)®EXEC(FCT=568),®EXEC(FCT=710)); */

@EXEC(FCT=710)