/* MAKE SURE TO EXECUTE ONLY ONCE */
@FMT(CMP,@DBHOT(HOT_WIZ,GET,PAIDOUTDONE)=1,'®DBHOT(HOT_WIZ,CLR,PAIDOUTDONE)®FMT(CHR,27)');

/* EXECUTE ENTER KEY TO SUBMIT FUNCTION */
@EXEC(FCT=9013);

/* QUIT ON ERROR */
@FMT(CMP,@WIZEXIST(MESSAGE)=1,'®FMT(CHR,27)');

/* SAVE PARAMS */
@DBHOT(HOT_WIZ,PARAMTOLINE,PARAMSAV_PAIDOUT);

/* ASK FOR SIGNATURE IF NEEDED */
@FMT(CMP,@DBHOT(FINDFIRST,DBT\SIG_@STORE@TER_@dbHot(SAL_HDR,F1032,!0:6).bmp)=,,®WIZRPL(SCAN_SIGN=0));
@FMT(CMP,@WIZGET(SCAN_SIGN)=1,'®EXEC(SQI=TRS_POS_SCAN_SIGN)');
@FMT(CMP,@WIZGET(SIGN_RETRY)=2,"®WIZCLR(SIGN_RETRY)®WIZRPL(RETRY=®TOOLS(MESSAGEDLG,!Signature is mandatory))");
@FMT(CMP,@WIZGET(SIGN_REJECT)=1,"®WIZCLR(SIGN_REJECT)®WIZRPL(RETRY=®TOOLS(MESSAGEDLG,!Signature is mandatory))");
@FMT(CMP,@WIZGET(RETRY)=1,"®WIZCLR(RETRY)®WIZCLR(MESSAGE)®EXEC(SQI=KDLOC_trs_pos_paidout)®FMT(CHR,27)");

/* RENAME THE SIGNATURE FILE */
@FMT(CMP,@WIZGET(SCAN_SIGN)=1,"®WIZRPL(SRC_PATH=DBT\ScanSign_®STORE®TER.bmp)®WIZRPL(TAR_PATH=DBT\SIG_®STORE®TER_®dbHot(SAL_HDR,F1032,!0:6).bmp)®EXEC(XCH=COPYFILE)");

/* INSERT DETAIL INTO SAL_DET */
@UPDATE_BATCH(JOB=ADD,TAR=SAL_DET,
KEY=F1032=:F1032 AND F1101=:F1101 AND F2770=:F2770,
SRC=SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,1 AS F2770,'PAYOUT' AS F2771,'@FMT(L10,First name):@FMT(2QUOT,@DBHOT(SAL_HDR,F1149))'  AS F1041,'SKU=First name;@FMT(2QUOT,@DBHOT(SAL_HDR,F1149))' AS F1081 WHERE '@FMT(2QUOT,@DBHOT(SAL_HDR,F1149))'!=''
UNION SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,2 AS F2770,'PAYOUT' AS F2771,'@FMT(L10,Last name):@FMT(2QUOT,@DBHOT(SAL_HDR,F1150))'  AS F1041,'SKU=Last name;@FMT(2QUOT,@DBHOT(SAL_HDR,F1150))' AS F1081 WHERE '@FMT(2QUOT,@DBHOT(SAL_HDR,F1150))'!=''
UNION SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,3 AS F2770,'PAYOUT' AS F2771,'@FMT(L10,Address):@FMT(2QUOT,@DBHOT(SAL_HDR,F1156))'  AS F1041,'SKU=Address;@FMT(2QUOT,@DBHOT(SAL_HDR,F1156))' AS F1081 WHERE '@FMT(2QUOT,@DBHOT(SAL_HDR,F1156))'!=''
UNION SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,4 AS F2770,'PAYOUT' AS F2771,'@FMT(L10,Phone):@FMT(2QUOT,@DBHOT(SAL_HDR,F1172))'  AS F1041,'SKU=Phone;@FMT(2QUOT,@DBHOT(SAL_HDR,F1172))' AS F1081 WHERE '@FMT(2QUOT,@DBHOT(SAL_HDR,F1172))'!=''
UNION SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,5 AS F2770,'PAYOUT' AS F2771,'@FMT(L10,Reason):'+F2773 AS F1041,'SKU=Reason;'+F2773 AS F1081 FROM REASON_TAB WHERE F1511=0@DBHOT(SAL_REG,F1063,#) AND F2772=0@WIZGET(REASON_CODE)
UNION SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,6 AS F2770,'PAYOUT' AS F2771,'@FMT(L10,Comment):@FMT(2QUOT,@WIZGET(KD.PAIDOUT.Comment))'  AS F1041,'SKU=COMMENTS;@FMT(2QUOT,@WIZGET(KD.PAIDOUT.Comment))' AS F1081 WHERE '@FMT(2QUOT,@WIZGET(KD.PAIDOUT.Comment))'!=''
UNION SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,7 AS F2770,'PAYOUT' AS F2771,'@FMT(L10,Cashier):@FMT(2QUOT,@DBHOT(SAL_HDR,F1127))'  AS F1041,'SKU=Cashier;@FMT(2QUOT,@DBHOT(SAL_HDR,F1127))' AS F1081
UNION SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,8 AS F2770,'PAYOUT' AS F2771,'@FMT(L11,Ok''d by):@FMT(2QUOT,@WIZGET(USERNAME))'  AS F1041,'SKU=Ok''d by;@FMT(2QUOT,@WIZGET(USERNAME))' AS F1081 WHERE '@FMT(2QUOT,@DBHOT(SAL_HDR,F1127))'!='@FMT(2QUOT,@WIZGET(USERNAME))'
UNION SELECT 0@DBHOT(HOT_IDX,F1032,#) AS F1032,0@DBHOT(HOT_IDX,F1101,#) AS F1101,9 AS F2770,'PAYOUT' AS F2771,'@FMT(L10,Employee#):@FMT(2QUOT,@WIZGET(EmpNumber))'  AS F1041,'SKU=Employee#;@FMT(2QUOT,@WIZGET(EmpNumber))' AS F1081 WHERE '@FMT(2QUOT,EmpNumber)'!='');

/* REPLACE COMA AND SEMI-COLON */
UPDATE SAL_DET SET F1081=REPLACE(F1081,',',''), F1041=REPLACE(REPLACE(F1041,';',''),',','') 
WHERE F1032=0@DBHOT(HOT_IDX,F1032,#) AND F1101=0@DBHOT(HOT_IDX,F1101,#) AND F2771='PAYOUT' AND (CHARINDEX(';',F1041)>0 OR CHARINDEX(',',F1041)>0);

/* PRINT STUB IF NEEDED */
@FMT(CMP,@WIZGET(KD.PAIDOUT.RCT)=1,'®WIZRPL(OUTPUT=DBT\TMP_®STORE@TER®FMT(R2,®DBHOT(REGGEN,TMPDB,1,30)).SQL)®EXEC(CGI=KDLOC_trs_pos_prn_paidout)');
@FMT(CMP,@WIZGET(KD.PAIDOUT.RCT)=1,'®WIZRPL(PAYOUTPUT=®WIZGET(OUTPUT))®WIZRPL(OUTPUT=RECEIPT)®EXEC(CGP=TRS_POS_PRN_STUB)');

/* RESTORE PARAMS */
@DBHOT(HOT_WIZ,LINETOPARAM,PARAMSAV_PAIDOUT);
@DBHOT(HOT_WIZ,CLR,PARAMSAV_PAIDOUT);

/* SET PARAM TO EXECUTE ONLY ONCE */
@DBHOT(HOT_WIZ,RPLT,PAIDOUTDONE,1)

