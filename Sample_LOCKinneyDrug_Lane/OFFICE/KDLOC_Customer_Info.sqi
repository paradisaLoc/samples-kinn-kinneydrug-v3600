@WIZINIT;
@WIZEDIT(F1148,Enter a client code);
@WIZDISPLAY;

@WIZRPL(F1148_CLL=@DBSELECT(SELECT F1148 FROM CLL_TAB WHERE F1578='PS' AND LEFT(F1577,2)='46' AND F1577='@WIZGET(F1148)'));
@FMT(CMP,@WIZGET(F1148_CLL)<>,"®WIZRPL(F1148=®WIZGET(F1148_CLL))");
@WIZCLR(F1148_CLL);

@WIZSET(WIDTH=400);
@WIZSET(HEIGHT=300);
@WIZRPL(STATE=STAYONTOP);
@WIZRPL(FORM=NEWFORM);
@WIZRPL(TITLE=Customer Information);
@WIZRPL(OPTIONS=BS1BI0);

@WIZRPL(HOT_IDX_F1148=@FMT(UPPER,@WIZGET(F1148)));

@EXEC(INFO=HTT=KDLOC_Customer_Info);
@EXEC(HTT=TRS_POS_EDIT_FRAME);