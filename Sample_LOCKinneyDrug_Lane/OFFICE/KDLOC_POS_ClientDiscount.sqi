
/* No DISCOUNT ON LEVEL 1 */
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=1,'®WIZRPL(KINNEY_DISC_CLIENT=0)®fmt(CHR,26)');

/* No DISCOUNT DEPARTMENT */
@fmt(CMP,@dbHot(SAL_REG,F1067)=ITEM,,'®WIZRPL(KINNEY_DISC_CLIENT=0)®fmt(CHR,26)');

/* CURRENT LEVEL DISCOUNT */
@dbHot(SAL_HDR,F1164,,=KDDV);

/* GET REG AMOUNT */
@rptTtl(@dbHot(HOT_MEM,CLTSAVEAMOUNT),,=KDDA);

/* CALCULATE DISCOUNT */
@WIZRPL(KINNEY_DISC_CLIENT=@rptTtl(KDDV/100*KDDA,#:2));

/* ITEMIZER APPLY ONLY TO LEVEL 2,3 and 5 */
@wizClr(F1152);
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=2,'®wizRpl(F1152=2)');
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=12,'®wizRpl(F1152=2)');
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=99,'®wizRpl(F1152=2)');
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=3,'®wizRpl(F1152=3)');
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=13,'®wizRpl(F1152=3)');
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=5,'®wizRpl(F1152=5)');
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=15,'®wizRpl(F1152=5)');
@fmt(CMP,@dbHot(SAL_HDR,F1152,#)=99,'®wizRpl(F1152=2)');

/* CURRENT LEVEL ITEMIZER FOUND */
@fmt(CMP,@fmt(POS,D@wizGet(F1152),@dbHot(SAL_REG,F1120))>0,'®fmt(CHR,26)');

/* IF NOT LEVEL 2,3,5 NO DISCOUNT */
@fmt(CMP,@wizGet(F1152)=,'®WIZRPL(KINNEY_DISC_CLIENT=0)®fmt(CHR,26)');

/* D2 ITEMIZER NOT FOUND, NO DISCOUNT */
@fmt(CMP,@fmt(POS,D2,@dbHot(SAL_REG,F1120))=0,'®WIZRPL(KINNEY_DISC_CLIENT=0)®fmt(CHR,26)');

/* GET DISCOUNT FOR LEVEL 2 */
@rptTtl(@dbSelect(SELECT F1164 FROM CLF_TAB WHERE F1152=2),,=KDDV);

/* CALCULATE DISCOUNT */
@WIZRPL(KINNEY_DISC_CLIENT=@rptTtl(KDDV/100*KDDA,#:2));
