/* SET ENTRY TO MAX AMOUNT ALLOWED IF OVER */
@dbHot(SAL_TTL_FIND,29999,F65,,=TTotal);
@rptttl(@DBHOT(INI,KinneyDrug.INI,RETURN,MaxAmount),,=TMax);
@FMT(CMP,@RPTTTL(TMax,#)=0,'®RPTTTL(500.00,,=TMax)');
@FMT(CMP,@RPTTTL(TTotal+TMax,#:2)>0.00,'®WIZRPL(PAYAMNT=@RPTTTL(-TTotal,#:2))®WIZRPL(SAL_REG[F1007]=@RPTTTL(-TTotal,#:2))','®WIZRPL(PAYAMNT=@RPTTTL(TMax,#:2))®WIZRPL(SAL_REG[F1007]=@RPTTTL(TMax,#:2))');

/* SAVE PARAMETERS */
@DBHOT(HOT_WIZ,PARAMTOLINE,ReturnOnGiftCard);

/* LAUNCH GIFTCARD PROCESS */
@FMT(CMP,@WIZEXIST(F01)@WIZEXIST(ENTRYNUMBER)=00,"®DBHOT(HOT_WIZ,RPLT,PRESCAN,1)®EXEC(set=hook,hook=sqi=Kinney_ReturnOnGiftCard,msg=Scan_a_new_giftcard)®FMT(CHR,27)");
@FMT(CMP,@WIZEXIST(ENTRYNUMBER)=0,"®WIZRPL(ENTRY=®DBSELECT(SELECT F154 FROM ALT_TAB WHERE F01='®WIZGET(F01)'))",'®WIZRPL(ITM=®WIZGET(ENTRY_ITEMCODE))®WIZRPL(ENTRY=®WIZGET(ENTRY_ITEMCODE)®WIZGET(ENTRYNUMBER))');

@WIZRPL(ENTRY=@WIZGET(SAL_REG[F1007]));
@FMT(CMP,@DBHOT(HOT_WIZ,GET,PRESCAN)=2,'®DBHOT(HOT_WIZ,RPLT,PRESCAN,3)®EXEC(FCT=8981)');

/* RESTORE PARAMETERS */
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,ReturnOnGiftCard);
@DBHOT(HOT_WIZ,CLR,ReturnOnGiftCard);
@DBHOT(HOT_WIZ,CLR,PRESCAN);

/* IF REMAINING BALANCE - RECALL SAME FUNCTION */
@WIZRPL(ENTRY=)
@FMT(CMP,@dbHot(SAL_TTL_FIND,29999,F65,#)=0,'®EXEC(FCT=385)®FMT(CHR,27)');

/* RE-SUBMIT SAME SCRIPT FOR BALANCE */
@WIZRESET;
@EXEC(SQI=Kinney_ReturnOnGiftCard);
