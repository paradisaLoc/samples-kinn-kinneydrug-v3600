@FMT(CMP,@DBHOT(HOT_WIZ,GET,PROMPTCUST)<>,"®WIZRPL(PROMPTCUST_HOT=1)®DBHOT(HOT_WIZ,CLR,PROMPTCUST)");

@WIZSET(NEW_ACCOUNT=0);
@WIZRPL(SETUP_CARD=0);
@WIZSET(NEW_THRIVECARD=0);
@WIZSET(NO_THRIVECARD=1);
@WIZSET(SCAN_MSG=Scan new Thrive card to begin process.);
@WIZSET(SCAN_MSG_PROACT=Scan new PROACT Thrive card to begin process.);
@WIZSET(SCAN_MSG2=Card is already active.  Please scan a different card.);
@WIZSET(SCAN_MSG3=Set up Thrive Card? 1=Yes/0=No);
@WIZSET(SCAN_MSG3_PROACT=Set up PROACT Thrive Card? 1=Yes/0=No);
@WIZSET(SCAN_MSG4=Invalid Thrive Card. Retry);
@WIZSET(SCAN_MSG4_PROACT=Invalid PROACT Thrive Card. Retry);
@WIZSET(FCT955_MSG=ENTER CUSTOMER);
@WIZSET(FCT908_MSG=Customer?);
@FMT(CMP,@DBHOT(HOT_MEM,LASTMSG)=@WIZGET(FCT908_MSG),"®WIZRPL(VALUECARD_LOOKUP=1)");
@FMT(CMP,@DBHOT(HOT_MEM,LASTMSG)=@WIZGET(SCAN_MSG),"®WIZRPL(NEW_THRIVECARD=1)");
@FMT(CMP,@DBHOT(HOT_MEM,LASTMSG)=@WIZGET(SCAN_MSG_PROACT),"®WIZRPL(NEW_THRIVECARD=1)");
@FMT(CMP,@DBHOT(HOT_MEM,LASTMSG)=@WIZGET(SCAN_MSG2),"®WIZRPL(NEW_THRIVECARD=1)");
@FMT(CMP,@DBHOT(HOT_MEM,LASTMSG)=@WIZGET(SCAN_MSG4),"®WIZRPL(NEW_THRIVECARD=1)");
@FMT(CMP,@DBHOT(HOT_MEM,LASTMSG)=@WIZGET(SCAN_MSG4_PROACT),"®WIZRPL(NEW_THRIVECARD=1)");
@FMT(CMP,@DBHOT(HOT_MEM,LASTMSG)=@WIZGET(FCT955_MSG),"®WIZRPL(ENTRY=®WIZGET(LIVEENTRY))®EXEC(FCT=307)®FMT(CHR,27)");
@FMT(CMP,"@FMT(S1:18,@DBHOT(HOT_MEM,LASTMSG))=@FMT(S1:18,@WIZGET(SCAN_MSG3))","®WIZRPL(NO_THRIVECARD=®WIZGET(LIVEENTRY))");
@FMT(CMP,"@FMT(S1:18,@DBHOT(HOT_MEM,LASTMSG))=@FMT(S1:18,@WIZGET(SCAN_MSG3_PROACT))","®WIZRPL(NO_THRIVECARD=®WIZGET(LIVEENTRY))");
@FMT(CMP,@WIZGET(NEW_THRIVECARD)=0,"®dbHot(HOT_WIZ,CLR,THRIVE_ORIG_F1148)");
@EXEC(MSG=_);

/* IF VALUECARD LOOKUP IS PRESSED AND THEN A CARD IS SCANNED, ENTER CARD NUMBER */
@FMT(CMP,@WIZEXIST(LIVEENTRY)-@WIZEXIST(PROMPTCUST)-@WIZGET(PROMPTCUST_HOT)-@WIZGET(VALUECARD_LOOKUP)=1-0-1-1,'®WIZRPL(ENTRY=®WIZGET(LIVEENTRY))®EXEC(FCT=9013)®FMT(CHR,26)');

/* FORCE DL INFORMATION IF IT IS A METHCHECK TRANSACTION WITH A DL PRESENT */
@FMT(CMP,@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)=2,1,0)@FMT(CMP,@FMT(COMA,DL.IdType,,,'@DBHOT(SAL_HDR,F1254)')=DL_ID,1,0)@WIZGET(NEW_ACCOUNT)=110,'
®DBHOT(HOT_WIZ,RPLT,PARASAV_KDLOCTHRIVE_DL,"
/SAL_HDR[F1520]='®DBHOT(SAL_HDR,F1520,DSDD)'
/SAL_HDR[F1149]='®DBHOT(SAL_HDR,F1149)' 
/SAL_HDR[F1150]='®DBHOT(SAL_HDR,F1150)' 
/SAL_HDR[F1156]='®DBHOT(SAL_HDR,F1156)' 
/SAL_HDR[F1157]='®DBHOT(SAL_HDR,F1157)' 
/SAL_HDR[F1158]='®DBHOT(SAL_HDR,F1158)' 
/SAL_HDR[F1170]='®DBHOT(SAL_HDR,F1170)' 
/SAL_HDR[F1159]='®DBHOT(SAL_HDR,F1159)'")');

/* IF CASHIER HAS TYPED 0 TO EXIT SCRIPT AFTER SCANNING A 49 CARD, ENTER CUSTOMER IN TRANSACTION AND QUIT */
@FMT(CMP,@WIZGET(NO_THRIVECARD)=0,"®WIZRPL(ENTRY=®WIZGET(CUSTOMER))®EXEC(FCT=307)®FMT(CHR,27)");

/* MAKE SURE THAT A CUSTOMER HAS BEEN SELECTED */
@FMT(CMP,@WIZGET(CUSTOMER)=,"®WIZRPL(CUSTOMER=®WIZGET(LIVEENTRY))");
@FMT(CMP,@WIZGET(CUSTOMER)=,"®WIZRPL(PROMPTCUST=1)®dbHot(HOT_WIZ,RPLT,PROMPTCUST,1)®EXEC(MSG='®WIZGET(FCT908_MSG)')®FMT(CHR,27)");

/* IF DOING A CUSTOMER LOOKUP, GO TO LOOKUP SCRIPT */
@FMT(CMP,"@dbHot(HOT_WIZ,GET,THRIVE_CUSTOMER_LOOKUP)=1","®dbHot(HOT_WIZ,CLR,THRIVE_CUSTOMER_LOOKUP)®WIZRPL(F1148=®WIZGET(CUSTOMER))®EXEC(SQI=KDLOC_Customer_Info)®FMT(CHR,27)");

/* IF SCRIPT IS ON 2ND PASS AND THIS IS A NEW ACCOUNT, CHECK TO SEE IF CUSTOMER WANTS TO SETUP NEW ACCOUNT */
@FMT(CMP,@WIZGET(NEW_ACCOUNT)@WIZGET(LIVEENTRY)=11,"®WIZRPL(SETUP_CARD=1)");
@FMT(CMP,"@FMT(S1:2,@WIZGET(CUSTOMER))@WIZGET(NEW_ACCOUNT)@WIZGET(SETUP_CARD)=4611","®dbHot(HOT_WIZ,RPLT,THRIVE_NEW_ACCOUNT,1)®dbHot(HOT_WIZ,RPLT,THRIVE_ORIG_F1148,®WIZGET(CUSTOMER))®WIZRPL(F1148=®WIZGET(CUSTOMER))®EXEC(SQI=TRS_POS_EDIT_CLT)®FMT(CHR,27)");
@FMT(CMP,"@FMT(S1:2,@WIZGET(CUSTOMER))@WIZGET(NEW_ACCOUNT)@WIZGET(SETUP_CARD)=4610","®FMT(CHR,27)");

/* GET CUSTOMER ACCOUNT INFORMATION FROM DATABASE */
@DBVIEW(Q1,SELECT TOP 1 CLT.F1148, CLT.F1152, ISNULL(CLT.F1521,'2000/01/01') AS F1521, CLT.F1150, CLT.F1149, CLT.F1573, CLT.F1172, CASE WHEN ISNULL(CLT.F1950,'') LIKE '%NA%' THEN 1 ELSE 0 END AS F1950
	FROM CLT_TAB CLT 
	LEFT JOIN CLL_TAB CLL ON CLL.F1148=CLT.F1148 AND CLL.F1000=CLT.F1000
	WHERE (CLL.F1577='@WIZGET(CUSTOMER)' AND CLL.F1578='PS') OR CLT.F1148='@WIZGET(CUSTOMER)');

/* IF CUSTOMER ACCOUNT IS NA, THEN ENTER CUSTOMER IN TRANSACTION AND DISPLAY THAT CUSTOMER IS INACTIVE */
@FMT(CMP,@DBROW(Q1,F1950,#)=1,"®WIZRPL(ENTRY=®WIZGET(CUSTOMER))®EXEC(FCT=307)®FMT(CHR,27)");

/* IF THIS IS A NEW CUSTOMER CARD AND THE SHOPPER LEVEL IS NOT PARTICIPATING IN THRIVE PROGRAM, GO TO CUSTOMER MAINTENANCE SCREEN */
@FMT(CMP,"@WIZGET(NEW_THRIVECARD)@DBROW(Q1,F1148)@FMT(S1:2,@WIZGET(CUSTOMER))@FMT(CMP,@DBSELECT(SELECT CHARINDEX(',@DBROW(Q1,F1152,#),',',@DBHOT(INI,KinneyDrug.ini,THRIVE,SHOPLEVEL),'))>0,0,1)=0491","®WIZRPL(F1148=®WIZGET(CUSTOMER))®EXEC(SQI=TRS_POS_EDIT_CLT)®FMT(CHR,27)");

/*  ERROR IF # NOT IN RANGE 46000000000-46099999999 */
@WIZSET(CUST_IN_RANGE=0);
@FMT(CMP,"@FMT(CMP,@FMT(!0:11,@WIZGET(CUSTOMER))>45999999999,1,0)@FMT(CMP,@FMT(!0:11,@WIZGET(CUSTOMER))<46100000000,1,0)=11","®WIZRPL(CUST_IN_RANGE=1)");
@FMT(CMP,"@WIZGET(CUST_IN_RANGE)@FMT(CMP,@DBROW(Q1,F1148)=,0,1)@FMT(CMP,@DBHOT(HOT_WIZ,GET,THRIVE_ORIG_F1148)=,0,1)=000","®EXEC(MSG='!®WIZGET(CUSTOMER) Card cannot be added')®FMT(CHR,27)");

/* IF THIS IS A NEW CUSTOMER CARD AND THE SHOPPER LEVEL IS NOT PARTICIPATING IN THRIVE PROGRAM, GO TO CUSTOMER MAINTENANCE SCREEN */
@FMT(CMP,"@WIZGET(NEW_THRIVECARD)@DBROW(Q1,F1148)@FMT(S1:2,@WIZGET(CUSTOMER))@FMT(CMP,@DBSELECT(SELECT CHARINDEX(',@DBROW(Q1,F1152,#),',',@DBHOT(INI,KinneyDrug.ini,THRIVE,SHOPLEVEL),'))>0,0,1)=0491","®WIZRPL(F1148=®WIZGET(CUSTOMER))®EXEC(SQI=TRS_POS_EDIT_CLT)®FMT(CHR,27)");

/* IF CUSTOMER DOES NOT EXIST AND COMING FROM VALUECARD LOOKUP BUTTON, DISPLAY ERROR MESSAGE */
@FMT(CMP,"@WIZGET(VALUECARD_LOOKUP)-@WIZGET(NEW_THRIVECARD)@DBROW(Q1,F1148)=1-0","®EXEC(MSG='!THRIVE CARD NOT ON FILE')®FMT(CHR,27)");

/* CHECK IF CUSTOMER EXISTS IN DB BEFORE CONTINUING WITH SCRIPT. PROMPT IF CUSTOMER WANTS TO SETUP NEW CARD.  */
@FMT(CMP,"@WIZGET(NEW_THRIVECARD)@DBROW(Q1,F1148)@FMT(S1:2,@WIZGET(CUSTOMER))=049","®WIZRPL(NEW_ACCOUNT=1)®EXEC(MSG='Card does not exist. Please scan a Thrive card')®FMT(CHR,27)");
@FMT(CMP,"@WIZGET(NEW_THRIVECARD)@DBROW(Q1,F1148)=0","®WIZRPL(NEW_ACCOUNT=1)®EXEC(MSG='?Card does not exist. Do you want to create it? 1=Yes/0=No')®FMT(CHR,27)");

/* SAVE ORIGINAL F1148 */
@FMT(CMP,"@WIZGET(NEW_THRIVECARD)=0","®WIZSET(THRIVE_ORIG_F1148=®DBROW(Q1,F1148,L))","®WIZSET(THRIVE_ORIG_F1148=®dbHot(HOT_WIZ,GET,THRIVE_ORIG_F1148))®dbHot(HOT_WIZ,CLR,THRIVE_ORIG_F1148)");

/* CHANGE MESSAGE TO INCLUDE 'PROACT' IF 3rd DIGIT OF CARD IS 1 (SHOPPER LEVEL IS 4 or 14) */
@FMT(CMP,"@FMT(S3:1,@WIZGET(CUSTOMER))=1","®WIZRPL(SCAN_MSG=®WIZGET(SCAN_MSG_PROACT))®WIZRPL(SCAN_MSG3=®WIZGET(SCAN_MSG3_PROACT))®WIZRPL(SCAN_MSG4=®WIZGET(SCAN_MSG4_PROACT))");

/* MAKE SURE CUSTOMER SHOPPER LEVEL IS PARTICIPATING IN PROGRAM */
@FMT(CMP,"@WIZGET(NEW_THRIVECARD)@FMT(CMP,@DBSELECT(SELECT CHARINDEX(',@DBROW(Q1,F1152,#),',',@DBHOT(INI,KinneyDrug.ini,THRIVE,SHOPLEVEL),'))>0,0,1)=01","®WIZRPL(ENTRY=®WIZGET(THRIVE_ORIG_F1148))®EXEC(FCT=307)®FMT(CHR,27)");

/* GET CUSTOMER MAIN THRIVE ACCOUNT NUMBER */
@WIZRPL(THRIVE_CUSTOMER=@DBSELECT(SELECT CASE 
	WHEN (SELECT TOP 1 F1577 FROM CLL_TAB WHERE F1148='@DBROW(Q1,F1148)' AND F1578='PS' AND LEFT(F1577,2)='46' AND ISNULL(F1898,'0')='1') IS NOT NULL 
		THEN (SELECT TOP 1 F1577 FROM CLL_TAB WHERE F1148='@DBROW(Q1,F1148)' AND F1578='PS' AND LEFT(F1577,2)='46' AND ISNULL(F1898,'0')='1') 
	WHEN (SELECT F1577 FROM CLL_TAB WHERE F1148='@DBROW(Q1,F1148)' AND F1577='@WIZGET(CUSTOMER)' AND F1578='PS' AND LEFT(F1577,2)='46' AND ISNULL(F1898,'0')!='1' AND @WIZGET(NEW_THRIVECARD)=0) IS NOT NULL 
		THEN 'UPDATE1'
	WHEN (SELECT TOP 1 F1577 FROM CLL_TAB WHERE F1148='@DBROW(Q1,F1148)' AND F1578='PS' AND LEFT(F1577,2)='46' AND ISNULL(F1898,'0')!='1' AND @WIZGET(NEW_THRIVECARD)=0 ORDER BY F253 DESC) IS NOT NULL 
		THEN 'UPDATE2'
	WHEN (SELECT TOP 1 F1148 FROM CLT_TAB WHERE F1148='@DBROW(Q1,F1148)' AND LEFT(F1148,2)='46') IS NOT NULL 
		THEN (SELECT TOP 1 F1148 FROM CLT_TAB WHERE F1148='@DBROW(Q1,F1148)' AND LEFT(F1148,2)='46')
	ELSE '' END AS F1401));

/* IF THIS IS NOT A NEW THRIVE CARD AND THE THRIVE CARD NUMBER EXISTS IN CLL_TAB BUT THE MAIN NUMBER IS NOT CHECKED, CHECK THE MAIN BOX. (UPDATE1)*/
@FMT(CMP,@WIZGET(THRIVE_CUSTOMER)=UPDATE1,"®WIZRPL(UPDATE_F1577=®DBSELECT(SELECT F1577 FROM CLL_TAB WHERE F1148='®DBROW(Q1,F1148)' AND F1577='®WIZGET(CUSTOMER)' AND F1578='PS' AND LEFT(F1577,2)='46' AND ISNULL(F1898,'0')!='1' AND ®WIZGET(NEW_THRIVECARD)=0))
®UPDATE_BATCH(JOB=ADDRPL,TAR=CLL_TAB,KEY=F1577=:F1577 AND F1578=:F1578,SRC=
SELECT '®WIZGET(UPDATE_F1577)' AS F1577,'PS' AS F1578, '1' AS F1898, '®WIZGET(THRIVE_ORIG_F1148)' AS F1148, 'PAL' AS F1000, 1 AS F1001, 'MANUAL' AS F902,'®STORE' AS F1964, GETDATE() AS F253)
®EXEC(SQM=cll_rsp_man)®WIZRPL(THRIVE_CUSTOMER=®WIZGET(UPDATE_F1577))");

/* IF THE CUSTOMER SWIPED A 49X CARD AND THERE IS A THRIVE ACCOUNT IN CLL_TAB BUT BUT NO MAIN BOX IS CHECKED, CHECK THE MAIN BOX FOR THE MOST RECENTLY ADDED THRIVE CARD (UPDATE2) */
@FMT(CMP,@WIZGET(THRIVE_CUSTOMER)=UPDATE2,"®WIZRPL(UPDATE_F1577=®DBSELECT(SELECT TOP 1 F1577 FROM CLL_TAB WHERE F1148='®DBROW(Q1,F1148)' AND F1578='PS' AND LEFT(F1577,2)='46' AND ISNULL(F1898,'0')!='1' AND ®WIZGET(NEW_THRIVECARD)=0 ORDER BY F253 DESC))
®UPDATE_BATCH(JOB=ADDRPL,TAR=CLL_TAB,KEY=F1577=:F1577 AND F1578=:F1578,
SRC=SELECT '®WIZGET(UPDATE_F1577)' AS F1577,'PS' AS F1578, '1' AS F1898, '®WIZGET(THRIVE_ORIG_F1148)' AS F1148, 'PAL' AS F1000, 1 AS F1001, 'MANUAL' AS F902,'®STORE' AS F1964, GETDATE() AS F253)
®EXEC(SQM=cll_rsp_man)®WIZRPL(THRIVE_CUSTOMER=®WIZGET(UPDATE_F1577))");

@WIZCLR(UPDATE_F1577);
@WIZCLR(CHECK_MAIN);

/* IF 49X CARD WAS SCANNED AND THRIVE CARD DOES NOT EXIST, ASK CASHIER IF THEY WANT TO SETUP A THRIVE CARD (IN CASE NO CARDS ARE AVAILABLE) */
@FMT(CMP,"@FMT(S1:2,@WIZGET(CUSTOMER))@WIZGET(TEMP_F1148)@WIZGET(THRIVE_CUSTOMER)=49","®WIZRPL(TEMP_F1148=®WIZGET(CUSTOMER))®EXEC(MSG='?®WIZGET(SCAN_MSG3)')®FMT(CHR,27)");

/* IF 49X CARD WAS SCANNED AND THRIVE CARD DOES NOT EXIST, PROMPT TO SCAN THRIVE CARD */
@FMT(CMP,"@FMT(S1:2,@WIZGET(CUSTOMER))=49","®WIZRPL(OLDCARDSCANNED=1)","®WIZRPL(OLDCARDSCANNED=0)");
@FMT(CMP,"@WIZGET(NEW_THRIVECARD)@WIZGET(OLDCARDSCANNED)@WIZGET(THRIVE_CUSTOMER)=01","®dbHot(HOT_WIZ,RPLT,THRIVE_ORIG_F1148,®WIZGET(THRIVE_ORIG_F1148))®EXEC(MSG='®WIZGET(SCAN_MSG)')®FMT(CHR,27)");
@FMT(CMP,"@FMT(S1:2,@WIZGET(CUSTOMER))@WIZGET(NEW_THRIVECARD)=491","®dbHot(HOT_WIZ,RPLT,THRIVE_ORIG_F1148,®WIZGET(THRIVE_ORIG_F1148))®EXEC(MSG='®WIZGET(SCAN_MSG)')®FMT(CHR,27)");

/* IF 46X CARD WAS SCANNED AND THIS IS A NEW CARD, AND THE CARD ALREADY EXISTS IN THE DB, ASK FOR ANOTHER CARD. */
@FMT(CMP,"@FMT(S1:2,@WIZGET(CUSTOMER))@WIZGET(NEW_THRIVECARD)@FMT(CMP,@DBROW(Q1,F1148)=,0,1)=4611","®dbHot(HOT_WIZ,RPLT,THRIVE_ORIG_F1148,®WIZGET(THRIVE_ORIG_F1148))®dbHot(HOT_WIZ,RPLT,THRIVE_NEW_CARD,1)®EXEC(MSG='®WIZGET(SCAN_MSG2)')®FMT(CHR,27)");

/* IF 46X CARD WAS SCANNED AND THIS IS A NEW CARD, AND THE CARD DOES NOT EXIST IN THE DB, VERIFY THAT THE 3RD DIGIT OF THE 46X CARD MATCHES THE 49X CARD. */
/* IF IT MATCHES, GO TO PINPAD, OTHERWISE, DISPLAY MESSAGE TO RETRY. */
@FMT(CMP,"@FMT(S1:2,@WIZGET(CUSTOMER))@WIZGET(NEW_THRIVECARD)@FMT(CMP,@DBROW(Q1,F1148)=,0,1)@FMT(CMP,@FMT(S3:1,@WIZGET(CUSTOMER))=@FMT(S3:1,@WIZGET(THRIVE_ORIG_F1148)),0,1)=46101","®dbHot(HOT_WIZ,RPLT,THRIVE_ORIG_F1148,®WIZGET(THRIVE_ORIG_F1148))®dbHot(HOT_WIZ,RPLT,THRIVE_NEW_CARD,1)®EXEC(MSG='®WIZGET(SCAN_MSG4)')®FMT(CHR,27)");
@FMT(CMP,"@FMT(S1:2,@WIZGET(CUSTOMER))@WIZGET(NEW_THRIVECARD)@FMT(CMP,@DBROW(Q1,F1148)=,0,1)@FMT(CMP,@FMT(S3:1,@WIZGET(CUSTOMER))=@FMT(S3:1,@WIZGET(THRIVE_ORIG_F1148)),0,1)=46100","®WIZRPL(ADD_TO_CLL=1)®EXEC(SQI=KDLOC_THRIVE_PINPAD)®FMT(CHR,27)");

/* ENTER CUSTOMER IN TRANSACTION  */
@WIZRPL(ENTRY=@WIZGET(THRIVE_ORIG_F1148));
@EXEC(FCT=307);

/* VERIFY IF CUSTOMER NEEDS TO BE UPDATED BASED ON LAST CUSTOMER UPDATE OR TRANSACTION COUNT */
@wizRpl(UPDATE_CUSTOMER=@dbSelect(SELECT CASE WHEN CAST('@DATE(@DSSF,DSD-@dbHot(Config,##THRIVE_DAYS:60))' AS DATE)>CAST(CASE WHEN ISDATE('@DBROW(Q1,F1521,DSDF)') = 1 THEN '@DBROW(Q1,F1521,DSDF)' ELSE '2000/01/01' END AS DATE) THEN 1 ELSE 0 END));
@FMT(CMP,"@DBHOT(SAL_TTL_FIND,7908,F64,!0:3)>@FMT(!0:3,@dbHot(Config,##THRIVE_TRSCOUNT:30))","®WIZRPL(UPDATE_CUSTOMER=1)");

/* IF CUSTOMER REQUIRES AN UPDATE, GO TO PINPAD. */
@FMT(CMP,@WIZGET(UPDATE_CUSTOMER)=1,"®dbHot(HOT_WIZ,RPLT,THRIVE_UPDATE_ACCOUNT,1)®EXEC(SQI=KDLOC_THRIVE_PINPAD)");
 
