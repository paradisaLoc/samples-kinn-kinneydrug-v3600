/* ONLY FOR CLL_TAB */
@FMT(CMP,@WIZGET(CREATE_TRIGGER_TABLE)=CLL_TAB,,'®FMT(CHR,27)');

/* TRIGGER TO FORCE HAVING ONLY 1 MAIN ALTERNATE THRIVE CUSTOMER CODE AND 1 MAIN TELEPHONE NUMBER */

IF OBJECT_ID('TRIG_CLL_TAB_F1898') IS NOT NULL
 DROP TRIGGER TRIG_CLL_TAB_F1898;

CREATE TRIGGER TRIG_CLL_TAB_F1898
ON CLL_TAB
AFTER insert,update 
AS
IF(UPDATE(F1898))
BEGIN
   DECLARE @F1577 varchar(32), @F1578 varchar(6), @F1898 varchar(1), @F1148 varchar(14)
   SELECT @F1577=INS.F1577, @F1578=INS.F1578, @F1898=INS.F1898, @F1148=INS.F1148 FROM INSERTED INS
   IF (@F1898='1' AND @F1578='PS' AND LEFT(@F1577,2)='46')
      UPDATE CLL_TAB SET CLL_TAB.F1898='0' WHERE CLL_TAB.F1148=@F1148 AND CLL_TAB.F1578='PS' AND CLL_TAB.F1577!=@F1577
   IF (@F1898='1' AND @F1578='TL' AND dbo.fn_VerifyPhoneNumber(@F1577)!='')
      UPDATE CLL_TAB SET CLL_TAB.F1898='0' WHERE CLL_TAB.F1148=@F1148 AND CLL_TAB.F1578='TL' AND CLL_TAB.F1577!=@F1577
END
