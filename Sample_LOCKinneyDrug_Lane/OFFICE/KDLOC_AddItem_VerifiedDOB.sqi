@wizSet(AGE_VERIFIED=0);

/* GET THE CURRENT VERIFIED BIRTHDATE */
@wizRpl(DATE_VERIFIED=@fmt(COMA,DATE_VERIFIED,,,@dbHot(SAL_HDR,F1254)));

/* VALIDATE CUSTOMERS AGE IS VALID FOR ITEM */
@fmt(CMP,@DBSELECT(SELECT dbo.KDLOC_VALIDATE_AGE('@wizGet(DATE_VERIFIED)', @wizGet(AGE_REQUIRED)))=0,"®EXEC(MSG='!Insufficient customer age ®date(®wizGet(DATE_VERIFIED),DPDF)')®fmt(CHR,27)");

/* ENTER ITEM AND IF THERE IS AN BIRTHDATE PROMPT ENTER THE BIRTHDATE */
@exec(FCT=710);
@fmt(CMP,@fmt(POS,?,@DBHOT(HOT_MEM,LASTMSG))=0,,'®post(ENTRY=®date(®wizGet(DATE_VERIFIED),DPDF),FCT=9013,CN=@CNC,TN=@TER)');