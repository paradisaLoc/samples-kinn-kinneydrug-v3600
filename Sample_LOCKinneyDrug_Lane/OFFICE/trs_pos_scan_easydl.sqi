/* Only 2D scanner with EASY_DL will work with this script. */
/* You need to program the scanner with $ delimiter         */
/* The order of extraction is very important and should be: */
/*   $ birth date $ first name $ last name   $ adress 1     */
/*   $ adress 2   $ city       $ state       $ zip code     */
/*   $ ID Number  $ Expiration $ Middle Name $ Name suffix  */
/*   $ Full name                                            */
/* If you are not extracting the information, it will still */
/* work and not overwrite the information in the transac.   */

@DBVIEW(Q1,SELECT 
  F1301=LEN('@FMT(2QUOT,@WIZGET(LIVEENTRY))')-LEN(REPLACE('@FMT(2QUOT,@WIZGET(LIVEENTRY))','$',''))+1,
  F1302=ISDATE('@TOOLS(PARAM,$,2,@FMT(2QUOT,@WIZGET(LIVEENTRY)))'),
  F1401='@FMT(2QUOT,@WIZGET(LIVEENTRY))',
  F1411=CASE WHEN ISDATE('@TOOLS(PARAM,$,2,@FMT(2QUOT,@WIZGET(LIVEENTRY)))')=1 THEN CAST('@TOOLS(PARAM,$,2,@FMT(2QUOT,@WIZGET(LIVEENTRY)))' AS DATETIME) END,
  F1412=CASE WHEN ISDATE('@TOOLS(PARAM,$,11,@FMT(2QUOT,@WIZGET(LIVEENTRY)))')=1 THEN CAST('@TOOLS(PARAM,$,11,@FMT(2QUOT,@WIZGET(LIVEENTRY)))' AS DATETIME) END)

/* VALIDATE BIRTHDATE */
@FMT(CMP,@DBROW(Q1,F1302,#)=0,'®EXEC(MSG='!Wrong date: @TOOLS(PARAM,$,2,@DBROW(Q1,F1401))')®FMT(CHR,27)');

/* SAVE PARAMETERS */
@DBHOT(HOT_WIZ,PARAMTOLINE,PARAMSAV_EASYLD);

/* DIRECT FIELDS IN TRANSACTION HEADER */
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<002,,"®wizrpl(SAL_HDR[F1520]=®DBROW(Q1,F1411,DWDF))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<003,,"®wizrpl(SAL_HDR[F1149]=®FMT(QUOT2,®TOOLS(PARAM,$,3,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<004,,"®wizrpl(SAL_HDR[F1150]=®FMT(QUOT2,®TOOLS(PARAM,$,4,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<005,,"®wizrpl(SAL_HDR[F1156]=®FMT(QUOT2,®TOOLS(PARAM,$,5,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<006,,"®wizrpl(SAL_HDR[F1157]=®FMT(QUOT2,®TOOLS(PARAM,$,6,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<007,,"®wizrpl(SAL_HDR[F1158]=®FMT(QUOT2,®TOOLS(PARAM,$,7,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<008,,"®wizrpl(SAL_HDR[F1170]=®FMT(QUOT2,®TOOLS(PARAM,$,8,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<009,,"®wizrpl(SAL_HDR[F1159]=®FMT(QUOT2,®TOOLS(PARAM,$,9,®DBROW(Q1,F1401))))");


/* OTHER FIELDS IN TRANSACTION NOTE */
@WIZRPL(ADDRPLTOF1254=DL.IdType=DL_ID);
/* IdIssuingAgency set to be used for MethCheck interface */
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<008,,"®WIZRPL(ADDRPLTOF1254=®WIZGET(ADDRPLTOF1254),DL.IdIssuingAgency=®FMT(QUOT2,®TOOLS(PARAM,$,8,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<010,,"®WIZRPL(ADDRPLTOF1254=®WIZGET(ADDRPLTOF1254),DL.IdNumber=®FMT(QUOT2,®TOOLS(PARAM,$,10,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<011,,"®WIZRPL(ADDRPLTOF1254=®WIZGET(ADDRPLTOF1254),DL.IdExpDate=®DBROW(Q1,F1412,DWDF))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<012,,"®WIZRPL(ADDRPLTOF1254=®WIZGET(ADDRPLTOF1254),DL.IdMiddleName=®FMT(QUOT2,®TOOLS(PARAM,$,12,®DBROW(Q1,F1401))))");
@FMT(CMP,@DBROW(Q1,F1301,!0:3)<013,,"®WIZRPL(ADDRPLTOF1254=®WIZGET(ADDRPLTOF1254),DL.IdSuffix=®FMT(QUOT2,®TOOLS(PARAM,$,13,®DBROW(Q1,F1401))))");

/* ADD PARAMETERS FOR VERIFIED BIRTHDATE TO TRANSACTION NOTE 1 = VERIFIED, 2 = DL EXPIRED */
@wizRpl(ADDRPLTOF1254=@wizGet(ADDRPLTOF1254),@fmt(CMP,'@fmt(!0:6:0,@date(@dbRow(Q1,F1412,DSDF),DAYS,@DSDF))<=@fmt(!0:6:0,@dbHot(CONFIG,##VERIFIED_AGE_EXP_DL_GRACEPERIOD:0))','AGE_VERIFIED=1','AGE_VERIFIED=2'),DATE_VERIFIED=@dbRow(Q1,F1411,DWDF));

/* IF PROMPT FOR DATE - SEND ENTER KEY */
@FMT(CMP,@FMT(POS,?,@DBHOT(HOT_MEM,LASTMSG))=0,,'®WIZRPL(ENTRY=®DBROW(Q1,F1411,DPDF))®EXEC(FCT=9013)');

/* IF TRS STARTED BUT WITH NO REGISTRATION */
@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)-@DBHOT(SAL_HDR,F1101,#)=2-0,'®DBVIEW(Q2,SELECT F1254=dbo.Sms_tools_comaparamdeletebyWildcard(dbo.Sms_tools_comaparamdeletebyWildcard(F1254,'DL.%'),'%_VERIFIED%') FROM SAL_HDR WHERE F1032=®FMT(#,®DBHOT(HOT_IDX,F1032,#)))®WIZRPL(TABLE=SAL_HDR)®WIZRPL(FIELD=F1254)®WIZRPL(ENTRY=®DBROW(Q2,F1254,RAW),®WIZGET(ADDRPLTOF1254))®EXEC(FCT=760)');

/* IF TRS STARTED WITH REGISTRATION */
@FMT(CMP,@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)=2,1,0)-@DBHOT(SAL_HDR,F1101,#)>1-0,'®WIZRPL(ENTRY=)®EXEC(FCT=695)');

/* OPEN TRS IF NOT OPEN */
@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)=2,,'®WIZRPL(ENTRY=)®EXEC(FCT=305)');

@dbHot(SAL_HDR,SET,SAL_HDR[*);
@EXEC(MSG=Thank_you_for_scanning_the_driver_license);

/* REFRESH HEADER */
@FMT(CMP,@DBHOT(FINDWINDOW,FHdrSale)=,,'®EXEC(FCT=10710)');

/* RESTORE PARAMETERS */
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,PARAMSAV_EASYLD);
@DBHOT(HOT_WIZ,CLR,PARAMSAV_EASYLD);
