/* EXIT WHEN REUND EXECUTED FROM PLUGIN POS REFUND */
@FMT(CMP,"@FMT(POS,PLUGIN.REFUND,@WIZGET(ADDTOF1081))=0",,'®FMT(CHR,26)');

/* SALE ITEM ON PROMPT RESPONSE=1 ELSE CANCEL */
@FMT(CMP,@WIZGET(PROMPTMEM)=1,'®WIZRPL(PromptResponse=®FMT(CMP,®WIZGET(LIVEENTRY)=1,1,0))®WIZCLR(PROMPTMEM)');
@FMT(CMP,@WIZGET(PROMPTRESPONSE)=0,'®EXEC(MSG=!Cancelled)®WIZCLR(PROMPTRESPONSE)®FMT(CHR,27)');
@FMT(CMP,@WIZGET(PROMPTRESPONSE)=1,'®WIZRPL(ENTRY=®WIZGET(OLD_ENTRY))®WIZRPL(AgeVerified=1)®WIZCLR(PROMPTRESPONSE)');

/* CHECK IF VERIFICATION ALREADY OCCURED IN CURRENT TRANSACTION */
@FMT(CMP,'@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%AgeVerified=1%' AND F1069<>1,F1101,#)>0,1,0)@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)=2,1,0)=11',®WIZRPL(AgeVerified=1));

/* CHECK IF BIRTHDATE IS PRESENT IN SAL_HDR */
@FMT(CMP,@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)=2,1,0)@FMT(CMP,@DBHOT(SAL_HDR,F1520,DPDD)=,0,1)=11,'®WIZRPL(AgeVerified=1)');

/* CHECK IF BIRTHDATE IS PRESENT IN SAL_REG */
@FMT(CMP,'@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%CLTAGE=%' AND F1069<>1,F1101,#)>0,1,0)@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)=2,1,0)=11',®WIZRPL(AgeVerified=1));

/* SHOW PROMPT TO CASHIER */
@FMT(CMP,@WIZGET(AgeVerified)=1,,"®WIZRPL(PROMPTMEM=1)®WIZRPL(OLD_ENTRY=®WIZGET(ENTRY))®EXEC(MSG='Verify age ®WIZSET(KD.AGE=18)®WIZGET(KD.AGE)(1=continue,0=cancel sale)?')®FMT(CHR,27)");

/* ADDTOF1081 TO KEEP TRACK OF VALIDATION */
@WIZRPL(ADDTOF1081=@WIZGET(ADDTOF1081),SKU=AgeVerified=1);