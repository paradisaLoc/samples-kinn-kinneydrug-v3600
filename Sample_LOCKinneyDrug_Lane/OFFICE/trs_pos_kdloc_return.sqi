/* QUIT IF ALREADY DONE */
@FMT(CMP,@WIZGET(KDLOC_RETURN)=DONE,'®FMT(CHR,27)');

@WIZRPL(CREDIT=);
@WIZRPL(BEHAVIOR=);

/* FORCE SUBTOTAL */
@DBHOT(HOT_WIZ,PARAMTOLINE,PARAMSAV_KDTENDER);
@FMT(CMP,@DBHOT(INI,SYSTEM.INI,CLIENT,MUSTSUBTOTAL)=1,"®WIZRPL(HOOKSKIP=ALL)®EXEC(FCT_ONLY=720)");
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,PARAMSAV_KDTENDER);

/* FAST = 1 WITH NO ENTRY AMOUNT */
@FMT(CMP,@WIZGET(FAST)=1,"®WIZRPL(LIVEENTRY=)®WIZRPL(ENTRY=)®EXEC(®TOOLS(PARAMTOCOMA))®FMT(CHR,27)");

/* GET REMAINIG BALANCE */
@DBHOT(SAL_TTL_FIND,29999,F65,,=KDLOC_TT);

/* USE ENTRY AMOUNT IF BALANCE IS POSITIVE */
@FMT(CMP,@RPTTTL(KDLOC_TT,#)<0,,"®WIZRPL(ENTRY=®WIZGET(LIVEENTRY))®EXEC(®TOOLS(PARAMTOCOMA))®FMT(CHR,27)");

/* CHECK FOR DECIMAL */
@FMT(CMP,@FMT(POS,.,@WIZGET(LIVEENTRY))=0,'®RPTTTL(-1*®WIZGET(LIVEENTRY)/100,,=ENTRY)','®RPTTTL(-1*®WIZGET(LIVEENTRY),,=ENTRY)');

/* MAKE SURE ENTRY AMOUNT IS NOT HIGHER THAN BALANCE */
@FMT(CMP,@RPTTTL(ENTRY,!0:6:2)>@RPTTTL(KDLOC_TT,!0:6:2),'®EXEC(MSG=!Over_tender_not_allowed)®FMT(CHR,27)');

@WIZRPL(ENTRY=@RPTTTL(ENTRY,#:2));
@WIZRPL(ALLOWMINUS=1);
@WIZRPL(KDLOC_RETURN=DONE);
