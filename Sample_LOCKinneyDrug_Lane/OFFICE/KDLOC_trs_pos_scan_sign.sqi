/* DELETE PREVIOUS TEMP FILE */
@WIZRPL(SRC_PATH=@OFFICEDBT\ScanSign_@STORE@TER.BMP);
@EXEC(XCH=DEL);

/* CAPTURE SIGNATURE ON SCANNER */
@WIZCLR(SIGN_RETRY);
@exec(msg=~Waiting_for_signature_capture_on_scanner);
@wizRpl(scanCaptureFile=@OFFICEDBT\ScanSign_@STORE@TER.BMP);
@wizRpl(ScanCaptureTimeout=20);
@wizRpl(ScanCaptureXch=CAPCODE);
@exec(XCH=ScanCapture);

@EXEC(MSG=' ');

/* SIGNATURE NOT FOUND */
@FMT(CMP,@WIZGET(DN)@DBHOT(FINDFIRST,DBT\ScanSign_@STORE@TER.bmp)=,"®WIZRPL(SIGN_RETRY=®TOOLS(MESSAGEDLG,'Signature file missing',0,RETRY@FMT(CMP,@dbHot(UserLevel)>=@WIZGET(SIGN_ABORT),',ABORT')))");

/* RETRY SIGNATURE */
@FMT(CMP,@WIZGET(SIGN_RETRY)=1,'®EXEC(SQI=KDLOC_TRS_POS_SCAN_SIGN)®FMT(CHR,27)');
@FMT(CMP,@WIZGET(SIGN_RETRY)=2,'®FMT(CHR,27)');

/* DISPLAY CHECK */
@WIZRPL(TITLE=Signature Preview);
@WIZRPL(WIDTH=450);
@WIZRPL(HEIGHT=200);
@WIZRPL(FORM=DocScan);
@WIZRPL(STATE=MODAL);
@FMT(CMP,@WIZGET(DN)=,"®EXEC(HTT=TRS_POS_SCAN_SIGN)");
@WIZCLR(STATE);
@WIZCLR(FORM);
@WIZCLR(WIDTH);
@WIZCLR(HEIGHT);
@WIZCLR(TITLE);

/* REJECT SIGNATURE */
@FMT(CMP,@WIZGET(SIGN_REJECT)=1,'®WIZRPL(MESSAGE=SIGNATURE REJECTED)®FMT(CHR,27)');

/* RETRY SIGNATURE */
@FMT(CMP,@WIZGET(SIGN_RETRY)=1,'®EXEC(SQI=KDLOC_TRS_POS_SCAN_SIGN)®FMT(CHR,27)');

/* RENAME THE FILE LOCALLY FOR FUTURE USED */
@WIZRPL(SRC_PATH=DBT\ScanSign_@STORE@TER.bmp);
@WIZRPL(TAR_PATH=DBT\SIG_@STORE@TER_@dbHot(SAL_HDR,F1032,!0:6).bmp);
@EXEC(XCH=COPYFILE);

/* SEND TO BACKEND */
@WIZCLR(TARGET);
@WIZRPL(TAR_PATH=@dbHot(INI,STARTUP,REDIRMAIL));
@WIZRPL(FILE=XF@WIZGET(TAR_PATH)\MS@dbHot(SAL_HDR,F1032,!0:4)@FMT(!0:3,@dbHot(SAL_REG,F1101,#))@STORE.@TER);
@WIZRPL(SRC_PATH=DBT\ScanSign_@STORE@TER.bmp);
@WIZRPL(TAR_PATH=ZS@WIZGET(TAR_PATH)\);
@WIZRPL(TAR_FILE=SIG_@STORE@TER_@dbHot(SAL_HDR,F1032,!0:6)_@FMT(!0:3,@dbHot(SAL_REG,F1101,#)).bmp);
@WIZRPL(SUBJECT=MSG_TRANSFER);

@EXEC(SQT=NIL);

@WIZCLR(FILE);
@WIZCLR(SRC_PATH);
@WIZCLR(TAR_PATH);
@WIZCLR(TAR_FILE);
@WIZCLR(SUBJECT);

