/* SET PARAMETERS */
@FMT(CMP,"@dbHot(HOT_WIZ,GET,THRIVE_ORIG_F1148)<>","®WIZSET(THRIVE_ORIG_F1148=®dbHot(HOT_WIZ,GET,THRIVE_ORIG_F1148))®dbHot(HOT_WIZ,CLR,THRIVE_ORIG_F1148)");
@FMT(CMP,"@dbHot(HOT_WIZ,GET,THRIVE_CUSTOMER)<>","®WIZSET(CUSTOMER=®dbHot(HOT_WIZ,GET,THRIVE_CUSTOMER))®dbHot(HOT_WIZ,CLR,THRIVE_CUSTOMER)");
@FMT(CMP,"@dbHot(HOT_WIZ,GET,THRIVE_NEW_ACCOUNT)<>","®WIZSET(NEW_ACCOUNT=®dbHot(HOT_WIZ,GET,THRIVE_NEW_ACCOUNT))®dbHot(HOT_WIZ,CLR,THRIVE_NEW_ACCOUNT)");
@FMT(CMP,"@dbHot(HOT_WIZ,GET,THRIVE_NEW_CARD)<>","®WIZSET(NEW_THRIVECARD=®dbHot(HOT_WIZ,GET,THRIVE_NEW_CARD))®dbHot(HOT_WIZ,CLR,THRIVE_NEW_CARD)");
@FMT(CMP,"@dbHot(HOT_WIZ,GET,THRIVE_ADD_TO_CLL)<>","®WIZSET(ADD_TO_CLL=®dbHot(HOT_WIZ,GET,THRIVE_ADD_TO_CLL))®dbHot(HOT_WIZ,CLR,THRIVE_ADD_TO_CLL)");
@FMT(CMP,"@dbHot(HOT_WIZ,GET,THRIVE_UPDATE_ACCOUNT)<>","®dbHot(HOT_WIZ,CLR,THRIVE_UPDATE_ACCOUNT)");

/* EXIT IF MISSING 'THRIVE_ORIG_F1148' PARAMETER */
@FMT(CMP,@WIZGET(THRIVE_ORIG_F1148)=,"®FMT(CHR,27)");

/* DISPLAY IF THRIVE CARD WAS NOT ADDED (NEW ACCOUNT ONLY) */
@DBVIEW(Q1,SELECT F1148,F1152 FROM CLT_TAB WHERE F1148='@WIZGET(THRIVE_ORIG_F1148)');
@FMT(CMP,@WIZGET(NEW_ACCOUNT)@DBROW(Q1,F1148,L)=1,"®EXEC(MSG='!Card not added. Keep card.')®FMT(CHR,27)");

/* IF NEW THRIVE CARD ADDED TO EXISTING ACCOUNT, ADD TO CLL_TAB */
@FMT(CMP,@WIZGET(NEW_THRIVECARD)@WIZGET(ADD_TO_CLL)=11,"®UPDATE_BATCH(JOB=ADDRPL,TAR=CLL_TAB,KEY=F1577=:F1577 AND F1578=:F1578,
SRC=SELECT '®WIZGET(CUSTOMER)' AS F1577,'PS' AS F1578, '1' AS F1898, '®WIZGET(THRIVE_ORIG_F1148)' AS F1148, 'PAL' AS F1000, 1 AS F1001, 'MANUAL' AS F902,'®STORE' AS F1964, GETDATE() AS F253)
®EXEC(SQM=cll_rsp_man)");

/* DISPLAY IF THRIVE CARD WAS NOT ADDED (EXISTING ACCOUNT ONLY) */
@DBVIEW(Q2,SELECT F1577 FROM CLL_TAB WHERE F1148='@WIZGET(THRIVE_ORIG_F1148)' AND F1577='@WIZGET(CUSTOMER)' AND F1578='PS' AND ISNULL(F1898,'0')='1')
@FMT(CMP,@WIZGET(NEW_THRIVECARD)@WIZGET(ADD_TO_CLL)@DBROW(Q2,F1577,L)=11,"®EXEC(MSG='!Card not added. Keep card.')®FMT(CHR,27)");

/* UPDATE MEMBERSHIP DATE IN CLT_TAB */
@UPDATE_BATCH(JOB=ADDRPL,TAR=CLT_TAB,KEY=F1148=:F1148,
SRC=SELECT F1148, 1 AS F1001, 'MANUAL' AS F902, '@STORE' AS F1964, '@DSDD' AS F1521 FROM CLT_TAB WHERE F1148='@WIZGET(THRIVE_ORIG_F1148)');
@EXEC(SQM=clt_rsp_man);

/* CHECK IF CUSTOMER IS AN EMPLOYEE (SHOPPER LEVEL 3 OR 13) */
@WIZSET(CUST_EMPLOYEE=0);
@FMT(CMP,@DBROW(Q1,F1152,#)=3,"®WIZRPL(CUST_EMPLOYEE=1)");
@FMT(CMP,@DBROW(Q1,F1152,#)=13,"®WIZRPL(CUST_EMPLOYEE=1)");

/* CHECK CLL_TAB TO MAKE SURE THAT OTHER CUSTOMERS DO NOT HAVE SAME PHONE NUMBER AS CURRENT CUSTOMER */
@WIZRPL(CUST_PHONENO=@DBSELECT(SELECT dbo.fn_VerifyPhoneNumber(F1172) FROM CLT_TAB WHERE F1148='@WIZGET(THRIVE_ORIG_F1148)' AND F1172!=''));
@FMT(CMP,"@FMT(CMP,@WIZGET(CUST_PHONENO)=,0,1)@WIZGET(CUST_EMPLOYEE)=00","®WIZRPL(PHONE_DUPLICATE=0)®WIZRPL(CUST_PHONE_MSG=Customer phone number is invalid or missing and was not added.)",);
@FMT(CMP,"@FMT(CMP,@WIZGET(CUST_PHONENO)=,0,1)@WIZGET(CUST_EMPLOYEE)=10","®WIZRPL(CUST_PHONE_MSG=Phone number for customer is a duplicate and was not added.)®EXEC(MSG='~Checking for a duplicate phone number')
®WIZRPL(PHONE_DUPLICATE=®DBSELECT(SELECT COUNT(F1148) FROM CLL_TAB WHERE dbo.fn_VerifyPhoneNumber(F1577)='®WIZGET(CUST_PHONENO)' AND F1148!='®WIZGET(THRIVE_ORIG_F1148)'))®EXEC(MSG=_)",);

/* ALERT CASHIER IF PHONE NUMBER IS DUPLICATE OR IS INVALID */
@FMT(CMP,@WIZGET(PHONE_DUPLICATE)>0,"®WIZRPL(ALERT_PHONE_MESSAGE=®TOOLS(MESSAGEDLG,®WIZGET(CUST_PHONE_MSG)))");
@FMT(CMP,"@FMT(CMP,@WIZGET(CUST_PHONENO)=,0,1)@WIZSET(CUST_EMPLOYEE)=00","®WIZRPL(ALERT_PHONE_MESSAGE=®TOOLS(MESSAGEDLG,®WIZGET(CUST_PHONE_MSG)))");

/* SEND A MESSAGE TO THE SERVER IF PHONE NUMBER IS DUPLICATE */
@FMT(CMP,@WIZGET(PHONE_DUPLICATE)>0,"®WIZRPL(SUBJECT=DUPLICATE PHONE NUMBER IN DB)®WIZRPL(TARGET=901)®WIZRPL(X-PRIORITY=1)®WIZRPL(MESSAGE=Phone number for customer @WIZGET(THRIVE_ORIG_F1148) is a duplicate and was not added.)®EXEC(SQT=NIL)");

/* UPDATE PHONE NUMBER IN CLL_TAB IF NUMBER IS NOT A DUPLICATE, IS VALID, AND CUSTOMER IS NOT AN EMPLOYEE */
@FMT(CMP,@FMT(CMP,@WIZGET(CUST_PHONENO)=,0,1)@WIZGET(PHONE_DUPLICATE)@WIZGET(CUST_EMPLOYEE)=100,"®UPDATE_BATCH(JOB=ADDRPL,TAR=CLL_TAB,KEY=F1577=:F1577 AND F1578=:F1578,
SRC=SELECT DISTINCT dbo.fn_VerifyPhoneNumber(CLT.F1172) AS F1577,'TL' AS F1578, 'MANUAL' AS F902, CLT.F1000 AS F1000, 1 AS F1001, CLT.F1148 AS F1148, GETDATE() AS F253, '1' AS F1898, '@STORE' AS F1964
FROM CLT_TAB CLT
LEFT OUTER JOIN CLL_TAB CLL ON CLL.F1148=CLT.F1148
WHERE CLT.F1172 != '' AND CLT.F1148='®WIZGET(THRIVE_ORIG_F1148)' AND CLT.F1152 NOT IN (3,13))
®EXEC(SQM=cll_rsp_man)");

/* ENTER CUSTOMER IN TRANSACTION */
@DBHOT(HOT_WIZ,PARAMTOLINE,PARASAV_KDLOCTHRIVE);
@DBHOT(HOT_WIZ,RPLT,THRIVECUST,@WIZGET(THRIVE_ORIG_F1148));
@EXEC(FCT=30);

@WIZRPL(ENTRY=@DBHOT(HOT_WIZ,GET,THRIVECUST));
@EXEC(FCT=307,RECALCULATE=1);

@WIZRESET;
@DBHOT(HOT_WIZ,CLR,THRIVECUST)
@DBHOT(HOT_WIZ,LINETOPARAM,PARASAV_KDLOCTHRIVE);
@DBHOT(HOT_WIZ,CLR,PARASAV_KDLOCTHRIVE);

/* ADD INFO IN SAL_DET WHEN 'UPDATE LATER' WAS PRESSED ON CUSTOMER MAINTENANCE SCREEN */
@FMT(CMP,@WIZGET(UPDATE_LATER)=1,"®UPDATE_BATCH(JOB=ADDRPL,TAR=SAL_DET,KEY=F1032=:F1032 AND F1101=:F1101 AND F2770=:F2770,
SRC=SELECT 0®DBHOT(HOT_IDX,F1032,#) AS F1032,0 AS F1101,0 AS F2770,'F1148: '+CAST(®WIZGET(THRIVE_ORIG_F1148) AS VARCHAR(15)) AS F1041,'Update Later' AS F1081)");

/* DISPLAY IF THRIVE CARD WAS ADDED */
@FMT(CMP,@WIZGET(NEW_THRIVECARD)=1,"®EXEC(MSG='Card successfully added. Give to customer.')");
@FMT(CMP,@WIZGET(NEW_ACCOUNT)=1,"®EXEC(MSG='Card successfully added. Give to customer.')");
