@FMT(CMP,@WIZGET(THRIVE_ORIG_F1148)=,"®EXEC(MSG='NO_THRIVE_CARD')®FMT(CHR,27)");

/* GET CUSTOMER INFORMATION */
@DBVIEW(Q2,SELECT F1148, F1149, F1150, F1172, F1573 FROM CLT_TAB WHERE F1148='@WIZGET(THRIVE_ORIG_F1148)');
@FMT(CMP,"@DBROW(Q2,F1148,L)=","®EXEC(MSG='CUSTOMER NOT FOUND IN DB')®FMT(CHR,27)");

/* PINPAD DISPLAY */
@WIZRPL(DSPMSG=Customer must verify info on pin pad.)
@WIZRPL(Title=Thrive reward profile:);
@WIZRPL(Line1=First Name: @DBROW(Q2,F1149,L));
@WIZRPL(Line2=Last Name:  @DBROW(Q2,F1150,L));
@WIZRPL(Line3=Phone #:    @DBROW(Q2,F1172,L));
@WIZRPL(Line4=Email:      @DBROW(Q2,F1573,L));
@WIZRPL(Line5=);
@WIZRPL(Prompt=Is this information correct?);
@WIZRPL(Button2=Yes);
@WIZRPL(Button4=No);
@WIZRPL(DSPFORM=40);
@WIZCLR(KbdKEY);

/* PROMPT ON PINPAD */
@FMT(CMP,@WIZGET(PROMPTPINPAD)=1,"®WINWAIT(1)®EXEC(XCH=PADENTER)®WIZRPL(PINPAD_RESPONSE=®WIZGET(KbdKEY))®TOOLS(PADDISPLAY,9,,)®WINWAIT(1)®EXEC(MSG=_)®FMT(CHR,27)");
@FMT(CMP,@WIZEXIST(PINPAD_RESPONSE)=0,"®WIZRPL(PROMPTPINPAD=1)®EXEC(SQI=KDLOC_THRIVE_PINPAD)");

/* IF TIMEOUT OR CANCEL, PROMPT ON PINPAD AGAIN */
@FMT(CMP,@WIZGET(PINPAD_RESPONSE)=,"®EXEC(SQI=KDLOC_THRIVE_PINPAD)®FMT(CHR,27)");

/* SAVE INFORMATION */
@FMT(CMP,@WIZGET(THRIVE_ORIG_F1148)<>,"®dbHot(HOT_WIZ,RPLT,THRIVE_ORIG_F1148,®WIZGET(THRIVE_ORIG_F1148))");
@FMT(CMP,@WIZGET(CUSTOMER)<>,"®dbHot(HOT_WIZ,RPLT,THRIVE_CUSTOMER,®WIZGET(CUSTOMER))");
@FMT(CMP,@WIZGET(NEW_ACCOUNT)=1,"®dbHot(HOT_WIZ,RPLT,THRIVE_NEW_ACCOUNT,1)");
@FMT(CMP,@WIZGET(ADD_TO_CLL)=1,"®dbHot(HOT_WIZ,RPLT,THRIVE_ADD_TO_CLL,1)");
@FMT(CMP,@WIZGET(NEW_THRIVECARD)=1,"®dbHot(HOT_WIZ,RPLT,THRIVE_NEW_CARD,1)"); 

/* CUSTOMER REQUIRES AN UPDATE OR IS COMING FROM CUSTOMER MAINTENANCE SCREEN */
@FMT(CMP,@WIZGET(KbdKEY)=2,"®EXEC(SQI=KDLOC_THRIVE_UPDATE)");
@FMT(CMP,@WIZGET(KbdKEY)=4,"®WIZRPL(F1148=®WIZGET(THRIVE_ORIG_F1148))®WIZCLR(FRAME)®EXEC(SQI=TRS_POS_EDIT_CLT)");
