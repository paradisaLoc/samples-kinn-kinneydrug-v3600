@FMT(CMP,@WIZGET(SCANDOC)<>,®WIZSET(VALID_SCRIPT=TRS_POS_VAL_SCAN));

/* VERIFY IF FLIP OF THE CHECK IS SUPPORTED, FLIP_SCRIPT MIGHT BE USED IN ALPHA */
@FMT(CMP,@DBHOT(PERIPHERAL,PRINTER,DOCUMENT,FlipChk)=1,®WIZSET(FLIP_SCRIPT=TRS_POS_VAL_FLIP),'®WIZSET(FLIP_SCRIPT=TRS_POS_VAL_END;TRS_POS_VAL_CHK)');

@WIZINIT;
@WIZMENU(VALID_SCRIPT=Select validation type,
Print check and endorsement=@WIZGET(FLIP_SCRIPT),
Print endorsement=TRS_POS_VAL_END);
@WIZDISPLAY

@WIZCLR(VAL_MSG);

@EXEC(CGI=@TOOLS(PARAM,,1,@WIZGET(VALID_SCRIPT)));
@FMT(CMP,@TOOLS(PARAM,,2,@WIZGET(VALID_SCRIPT))=,,'®EXEC(CGI=®TOOLS(PARAM,,2,®WIZGET(VALID_SCRIPT)))');