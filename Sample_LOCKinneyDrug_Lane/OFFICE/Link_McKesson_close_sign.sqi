/* HIPAASigCapture */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNHIPAA=1%' AND F1069<>1 AND F1070='0',F64,#)>0,"®TOOLS(PADDISPLAY,9,,)®WINWAIT(1)®WIZRPL(PADMSG=®DBHOT(INI,LINK_MCKESSON.INI,SigCaptureInfo,HIPAASigCapture))®WIZRPL(DSPFORM=2)®EXEC(XCH=PADENTER)®WIZRPL(HIPAASigCaptureResult=®WIZGET(PADENTRY))®WIZRPL(HIPAASIG=1)","®WIZRPL(HIPAASIG=0)");
@FMT(CMP,@WIZGET(HIPAASigCaptureResult)=0,"®DBEXEC(UPDATE SAL_REG SET F1081=REPLACE(F1081,'MCK_SIGNHIPAA=1','MCK_SIGNHIPAA=0') WHERE F1032=@DBHOT(SAL_HDR,F1032,#))");

/* RxAckSigCapture */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNRXACK=1%' AND F1069<>1 AND F1070='0',F64,#)>0,"®TOOLS(PADDISPLAY,9,,)®WINWAIT(1)®WIZRPL(PADMSG=®DBHOT(INI,LINK_MCKESSON.INI,SigCaptureInfo,RxAckSigCapture))®WIZRPL(DSPFORM=2)®EXEC(XCH=PADENTER)®WIZRPL(RxAckSigCaptureResult=®WIZGET(PADENTRY))®WIZRPL(RXACKSIG=1)","®WIZRPL(RXACKSIG=0)");
@FMT(CMP,@WIZGET(RxAckSigCaptureResult)=0,"®EXEC(MSG=!Signature_is_mandatory)®FMT(CHR,27)");

/* EasyCapSigCapture */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNEASYCAP=1%' AND F1069<>1 AND F1070='0',F64,#)>0,"®TOOLS(PADDISPLAY,9,,)®WINWAIT(1)®WIZRPL(PADMSG=®DBHOT(INI,LINK_MCKESSON.INI,SigCaptureInfo,EasyCapSigCapture))®WIZRPL(DSPFORM=2)®EXEC(XCH=PADENTER)®WIZRPL(EasyCapSigCaptureResult=®WIZGET(PADENTRY))®WIZRPL(EZCAPSIG=1)","®WIZRPL(EZCAPSIG=0)");
@FMT(CMP,@WIZGET(EasyCapSigCaptureResult)=0,"®DBEXEC(UPDATE SAL_REG SET F1081=REPLACE(F1081,'MCK_SIGNEASYCAP=1','MCK_SIGNEASYCAP=0') WHERE F1032=@DBHOT(SAL_HDR,F1032,#))®WIZRPL(EZCAPSIG=0)")

/* CounselingAccepted */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_COUNSELING=1%' AND F1069<>1 AND F1070='0',F64,#)>0,"®TOOLS(PADDISPLAY,9,,)®WINWAIT(1)®WIZRPL(PADMSG=®DBHOT(INI,LINK_MCKESSON.INI,SigCaptureInfo,CounselingAccepted))®WIZRPL(DSPFORM=2)®EXEC(XCH=PADENTER)®WIZRPL(CounselingAcceptedResult=®WIZGET(PADENTRY))");
@FMT(CMP,@WIZGET(CounselingAcceptedResult)=0,"®DBEXEC(UPDATE SAL_REG SET F1081=REPLACE(F1081,'MCK_COUNSELING=1','MCK_COUNSELING=0') WHERE F1032=@DBHOT(SAL_HDR,F1032,#))");

/* Signature process */
@FMT(CMP,@WIZGET(HIPAASIG)@WIZGET(RXACKSIG)=00,,'®WIZRPL(SigMissing=®FMT(CMP,@DBHOT(FINDFIRST,DBT\SIG_@STORE@TER_@dbHot(SAL_HDR,F1032,!0:6).bmp)=,1))');
@FMT(CMP,@WIZGET(SigMissing)=1,'®EXEC(SQI=TRS_POS_SCAN_SIGN)');
@FMT(CMP,@WIZGET(SIGN_REJECT)=1,'®WIZRPL(SRC_PATH=DBT\ScanSign_®STORE®TER.bmp)®EXEC(XCH=DEL)');
@FMT(CMP,@WIZGET(SigMissing)=1,'®WIZRPL(SRC_PATH=DBT\ScanSign_®STORE®TER.bmp)®WIZRPL(TAR_PATH=DBT\SIG_®STORE®TER_®dbHot(SAL_HDR,F1032,!0:6).bmp)®EXEC(XCH=COPYFILE)');
@FMT(CMP,@WIZGET(SigMissing)=1,'®WIZRPL(SigMissing=®FMT(CMP,@DBHOT(FINDFIRST,DBT\SIG_@STORE@TER_@dbHot(SAL_HDR,F1032,!0:6).bmp)=,1))');
@WIZCLR(PromptTimeOut);
@EXEC(MSG=' ');

