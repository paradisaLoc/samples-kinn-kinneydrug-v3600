/* SAVE PARAMETERS */
@DBHOT(HOT_WIZ,PARAMTOLINE,MC_EDITID);

/* START NEW TRANSACTION IF NOT OPEN AND KEEP OVER LIMIT IF APPLICABLE */
@FMT(CMP,@DBHOT(HOT_MEM,TRSSTATE)=0,'®DBHOT(HOT_WIZ,RPL,TRSINFO,®FMT(CMP,®FMT(#,®DBHOT(HOT_MEM,CLTOVERLIMIT))=0,0,1)®FMT(CMP,®FMT(#,®DBHOT(HOT_MEM,CLTRETURNKEY))=0,0,1)®FMT(CMP,®FMT(#,®DBHOT(HOT_MEM,CLTRETURNMODE))=0,0,1))®EXEC(FCT=305)');
@FMT(CMP,@FMT(S2:1,@DBHOT(HOT_WIZ,GET,TRSINFO))=1,'®WIZRPL(REASON=)®EXEC(FCT=650)');
@FMT(CMP,@FMT(S1:1,@DBHOT(HOT_WIZ,GET,TRSINFO))=1,'®EXEC(FCT=37)');
@DBHOT(HOT_WIZ,CLR,TRSINFO);

/* POPUP ENTRY FORM */
@WIZRPL(HEIGHT=530);
@WIZRPL(WIDTH=350);
@WIZRPL(FORM=IDENTRY);
@WIZRPL(STYLE=HTM);
@WIZRPL(STATE=MODAL);
@WIZRPL(OPTIONS=BS1BI0);
@WIZRPL(TITLE=ID);
@EXEC(HTT=Link_MethCheck_edit_id);
@FMT(CMP,@WIZGET(BTNSUBMIT)=CANCEL,'®EXEC(MSG=_)®FMT(CHR,27)');

/* CLEAR POPUP VARIABLES */
@WIZCLR(HEIGHT);
@WIZCLR(WIDTH);
@WIZCLR(FORM);
@WIZCLR(STYLE);
@WIZCLR(STATE);
@WIZCLR(OPTIONS);
@WIZCLR(TITLE);

/* SAVE INFORMATION TO SAL_HDR */
@WIZRPL(ADDRPLTOF1254=@WIZGET(ADDRPLTOF1254),DL.IdType=@WIZGET(DL.IdType));
@WIZRPL(ADDRPLTOF1254=@WIZGET(ADDRPLTOF1254),DL.IdIssuingAgency=@WIZGET(DL.IdIssuingAgency));
@WIZRPL(ADDRPLTOF1254=@WIZGET(ADDRPLTOF1254),DL.IdNumber=@WIZGET(DL.IdNumber));
@WIZRPL(ADDRPLTOF1254=@WIZGET(ADDRPLTOF1254),DL.IdExpDate=@WIZGET(DL.IdExpDate));
@WIZRPL(ADDRPLTOF1254=@WIZGET(ADDRPLTOF1254),DL.IdMiddleName=@WIZGET(DL.IdMiddleName));
@WIZRPL(ADDRPLTOF1254=@WIZGET(ADDRPLTOF1254),DL.IdSuffix=@WIZGET(DL.IdSuffix));

/* IF EXPIRATION DATE LEFT BLANK SET TO AN EXPIRED DATE FOR VERIFIED AGE */
@fmt(CMP,@wizIsBlank(DL.IdExpDate)=1,'®wizRpl(DL.IdExpDate=01/01/1900)');

/* ADD PARAMETERS FOR VERIFIED BIRTHDATE TO TRANSACTION NOTE 1 = VERIFIED, 2 = DL EXPIRED */
@wizRpl(ADDRPLTOF1254=@wizGet(ADDRPLTOF1254),@fmt(CMP,'@fmt(!0:6:0,@date(@wizGet(DL.IdExpDate),DAYS,@DSDF))<=@fmt(!0:6:0,@dbHot(CONFIG,##VERIFIED_AGE_EXP_DL_GRACEPERIOD:0))','AGE_VERIFIED=1','AGE_VERIFIED=2'),DATE_VERIFIED=@date(@wizGet(SAL_HDR[F1520]),DWDF));

/* DELETE EXISTING PARAMETERS FROM F1254 */
@DBVIEW(Q2,SELECT F1254=dbo.Sms_tools_comaparamdeletebyWildcard(dbo.Sms_tools_comaparamdeletebyWildcard(F1254,'DL.%'),'%_VERIFIED%') FROM SAL_HDR WHERE F1032=@FMT(#,@DBHOT(HOT_IDX,F1032,#)));

@WIZRPL(TABLE=SAL_HDR);
@WIZRPL(FIELD=F1254);
@WIZRPL(ENTRY=@DBROW(Q2,F1254,RAW),@WIZGET(ADDRPLTOF1254));
@dbHot(SAL_HDR,SET,SAL_HDR[*);
@EXEC(FCT=760);

/* CONFIRMATION TO USER */
@EXEC(MSG=Done)

/* RESTORE PARAMETERS */
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,MC_EDITID);
@DBHOT(HOT_WIZ,CLR,MC_EDITID);
