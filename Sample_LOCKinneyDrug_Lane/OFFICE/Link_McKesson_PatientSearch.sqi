/* ASK FOR OVER LIMIT IF WEBSERVICE ID OFFLINE */
@FMT(CMP,@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OFFLINE)=1,1,0)@FMT(CMP,@DBHOT(HOT_MEM,CLTOVERLIMIT)<>1,0,1)=10,"®EXEC(MSG='McKesson webservice is offline, use over limit function to retry')®FMT(CHR,26)");
@FMT(CMP,@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OFFLINE)=1,1,0)@FMT(CMP,@DBHOT(HOT_MEM,CLTOVERLIMIT)<>1,0,1)=11,"@DBHOT(HOT_WIZ,CLR,MCK_OFFLINE)");

/* SHOW WINDOW TO ENTER SEARCH CRITERIA */
/* IF MANDATORY FIELDS ARE MISSING - POPUP MODAL WINDOWS TO FILL MANUALLY */
@WIZRPL(FRAME=);
@WIZRPL(HEIGHT=475);
@WIZRPL(WIDTH=350);
@WIZRPL(FORM=PatientSearch);
@WIZRPL(STYLE=HTM);
@WIZRPL(STATE=MODAL);
@WIZRPL(OPTIONS=BS1BI0);
@WIZRPL(TITLE=McKesson Patient Search);
@EXEC(HTT=Link_McKesson_PatientSearch);

/* CLEAR POPUP VARIABLES */
@WIZCLR(HEIGHT);
@WIZCLR(WIDTH);
@WIZCLR(FORM);
@WIZCLR(STYLE);
@WIZCLR(STATE);
@WIZCLR(OPTIONS);
@WIZCLR(TITLE);

/* CLEAR EMPTY VARIABLE TO SIMPLIFY SCRIPTS */
@FMT(CMP,"@WIZGET(PhoneNumber)=",®WIZCLR(PhoneNumber)®WIZCLR(AreaCode),"®WIZRPL(AreaCode=®FMT(S1:3,®WIZGET(PhoneNumber)))®WIZRPL(PhoneNumber=®FMT(S4:7,®WIZGET(PhoneNumber)))");
@FMT(CMP,"@WIZGET(LastName)=",®WIZCLR(LastName));
@FMT(CMP,"@WIZGET(FirstName)=",®WIZCLR(FirstName));
@FMT(CMP,"@WIZGET(DateOfBirth)=",®WIZCLR(DateOfBirth),"®WIZRPL(FormatDateOfBirth=®FMT(S1:2,®WIZGET(DateOfBirth))/®FMT(S3:2,®WIZGET(DateOfBirth))/®FMT(S5:4,®WIZGET(DateOfBirth)))®WIZRPL(DateOfBirth=®FMT(DWDF,®WIZGET(FormatDateOfBirth)))");
@FMT(CMP,"@WIZGET(TState)=",®WIZCLR(TState));
@FMT(CMP,"@WIZGET(Zip)=",®WIZCLR(Zip));

/* IF RESPONSE FROM FORM IS CANCEL THEN QUIT */
@FMT(CMP,@WIZGET(BTNSUBMIT)=CANCEL,'®EXEC(MSG=Cancelled)®FMT(CHR,27)');

/* Set Export FileName */
@WIZRPL(SOAPREQUEST=@OFFICEDBT\MK@TER@DBHOT(CNCURRENT)_PatientSearchReq.XML);
@WIZRPL(SOAPRESPONSE=@OFFICEDBT\MK@TER@DBHOT(CNCURRENT)_PatientSearchRsp.XML);
@WIZRPL(SRC_PATH=@OFFICEDBT\MK@TER@DBHOT(CNCURRENT)_PatientSearch*.XML);
@EXEC(XCH=DEL);

/* Build Soap Message */
@WIZSET(OUTPUT=@WIZGET(SOAPREQUEST));
@EXEC(CGI=Link_McKesson_PatientSearchReq.xml);

@EXEC(MSG=~ONLINE_VERIFICATION_WAITING);

/* Send Request */
@WIZRPL(HttpUrl=@DBHOT(INI,LINK_MCKESSON.INI,GENERAL,URLPATIENT));
@WIZRPL(HttpTimeout=@DBHOT(INI,LINK_MCKESSON.INI,GENERAL,URLTIMEOUT));
@WIZRPL(HttpContent=text/xml;);
@WIZRPL(HttpPost=@WIZGET(SOAPREQUEST));
@WIZRPL(HttpOutput=@WIZGET(SOAPRESPONSE));
@EXEC(XCH=HTTP);

@EXEC(MSG=_);

/* VALIDATE RESPONSE CONTENT */
@WIZCLR(DIR);
@WIZRPL(FILE=@WIZGET(SOAPRESPONSE));
@FMT(CMP,@msgFILE(FINDINFILE,xml)=,"®WIZSET(HTTPERROR=COMMUNICATION ERROR)");

/* LOG HTTP COMMUNICATION */
@WIZRPL(LogHTTPFile=PatientSearch);
@EXEC(SQI=Link_McKesson_LogHTTP);

/* QUIT ON HTTP ERROR */
@FMT(CMP,@WIZEXIST(HTTPERROR)=1,"®DBHOT(HOT_WIZ,RPLT,MCK_OFFLINE,1)®EXEC(MSG='!®WIZGET(HTTPERROR)')®FMT(CHR,27)");

/* load Data/Error from XML file */
@WIZRPL(OLD_FORM=@WIZGET(FORM));
@FMT(CMP,@WIZEXIST(HTTPERROR)=0,'®DBHOT(HOT_WIZ,RPLT,MCK_PatientLup,1)®WIZRPL(FORM=BUTTON)®EXEC(LstPage=Link_McKesson_PatientSearchRsp,HTT=Link_McKesson_scr_look_frame)');
@WIZRPL(FORM=@WIZGET(OLD_FORM));



