/* QUIT ON VOIDED TRANSACTION */
@FMT(CMP,@DBHOT(SAL_HDR,F1068,L)=VOIDED,'®FMT(CHR,26)');

/* QUIT IF NO MANUAL RETURNED ITEM IN TRANSACTION */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 NOT LIKE '%SKU=PLUGIN.REFUND%' AND F1069<>'1' AND F1070<>'0',F1101,#)=0,'®FMT(CHR,26)');

/* SAVE PARAMS */
@DBHOT(HOT_WIZ,PARAMTOLINE,PARAMSAV_KDLOCRETURN);

/* ASK FOR SIGNATURE */
@EXEC(SQI=TRS_POS_SCAN_SIGN);
@FMT(CMP,@WIZGET(SIGN_RETRY)=2,"®EXEC(MSG=!Signature_is_mandatory)®FMT(CHR,27)");

/* PRINT STUB IF NEEDED */
@wizRpl(STUB=1);
@WIZRPL(OUTPUT=DBT\TMP_@STORE@TER@FMT(R2,@DBHOT(REGGEN,TMPDB,1,30)).SQL);
@EXEC(CGI=KDLOC_trs_pos_prn_return);

@WIZRPL(PAYOUTPUT=@WIZGET(OUTPUT))
@WIZRPL(OUTPUT=RECEIPT);
@EXEC(CGP=TRS_POS_PRN_STUB);

@wizClr(STUB);

/* RESTORE PARAMS */
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,PARAMSAV_KDLOCRETURN);
@DBHOT(HOT_WIZ,CLR,PARAMSAV_KDLOCRETURN);
