/* ENTER PHONE NUMBER ON PINPAD */
@FMT(CMP,@WIZEXIST(F1577)=0,'®EXEC(SQI=KDLOC_trs_pos_pinpad_phone_xch)');
@EXEC(MSG=[PADDSP]Thank_You);

@FMT(CMP,@WIZGET(F1577)=,'®EXEC(MSG=Cancelled)®FMT(CHR,27)');

@FMT(CMP,@FMT(!0:2,@FMT(LEN,@WIZGET(F1577)))<07,"®WIZRPL(CUSTOMER=®DBSELECT(SELECT TOP 1 F1148 FROM CLT_TAB WHERE ISNULL(F1643,'')='®WIZGET(F1577)' AND ISNULL(F1152,'') IN (3,13) AND ISNULL(F1950,'') NOT LIKE '%NA%' ORDER BY F253 DESC))®WIZSET(ERRORMSG=Employee not found)",
"®WIZRPL(CUSTOMER=®DBSELECT(SELECT F1148 FROM CLL_TAB WHERE ISNULL(F1577,'')='®WIZGET(F1577)' AND ((ISNULL(F1578,'')='TL') OR (ISNULL(F1578,'')='ZIP'))))®WIZSET(ERRORMSG=Customer not found)");
@FMT(CMP,@WIZGET(CUSTOMER)=,"®EXEC(MSG='!®WIZGET(ERRORMSG)')®FMT(CHR,27)");

@EXEC(SQI=KDLOC_THRIVE_SCAN);
