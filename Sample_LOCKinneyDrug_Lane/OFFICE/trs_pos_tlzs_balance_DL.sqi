/* VERIFY IF DL INFO EXISTS */
@FMT(CMP,@DBHOT(HOT_WIZ,GET,PARASAV_KDLOCTHRIVE_DL)=,"®FMT(CHR,27)");

/* SAVE PARAMS */
@DBHOT(HOT_WIZ,PARAMTOLINE,PARAMSAV_BEFOREDL);

/* BRING BACK DL INFO */
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,PARASAV_KDLOCTHRIVE_DL);
@DBHOT(SAL_HDR,SET,SAL_HDR[*);

/* REFRESH HEADER */
@FMT(CMP,@DBHOT(FINDWINDOW,FHdrSale)=,,'®EXEC(FCT=10710)');

/* RESTORE PARAMS */
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,PARAMSAV_BEFOREDL);
@DBHOT(HOT_WIZ,CLR,PARAMSAV_BEFOREDL);