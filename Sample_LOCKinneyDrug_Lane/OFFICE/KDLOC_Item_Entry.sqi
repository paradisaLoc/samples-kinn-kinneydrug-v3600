/* EXECUTE FUNCTION 710 IF REFUND ITEM, REFUND MODE, OR PRICE INFO */
@fmt(CMP,@dbHot(HOT_MEM,CLTRETURNKEY)=0,,'®exec(FCT=710)®fmt(CHR,27)');
@fmt(CMP,@dbHot(HOT_MEM,CLTRETURNMODE)=0,,'®exec(FCT=710)®fmt(CHR,27)');
@fmt(CMP,'@dbHot(HOT_MEM,LASTMSG)=PRICE INFO','®exec(FCT=710)@fmt(CHR,27)');

@TOOLS(AUTO_START);

/* HANDLE PLU FROM FLIP CHART */
@fmt(CMP,@wizExist(ITM)=1,'®wizRpl(LIVEENTRY=@wizGet(ITM))®wizClr(ITM)');

/* Prompt for PLU */
@FMT(CMP,@WIZGET(PROMPTMEM)=1,"®WIZRPL(ENTRY=®WIZGET(LIVEENTRY))®WIZCLR(PROMPTMEM)");
@FMT(CMP,@WIZGET(PROMPTMEM)@WIZGET(LIVEENTRY)=,"®WIZRPL(PROMPTMEM=1)®EXEC(MSG='Plu code?')®FMT(CHR,27)","®WIZRPL(ENTRY=®WIZGET(LIVEENTRY))");

@WIZRPL(UPC=@WIZGET(ENTRY));

/* Lookup item and find age verification and if a verified age is required */
@DBVIEW(Q1,SELECT POS.F01
	, CASE
		WHEN POS.F106 = 1 THEN ISNULL(SDP.F171,0)
		ELSE ISNULL(POS.F171,0)
	END AS F171
	, CASE
		WHEN SDP.F03 IN (@DBHOT(CONFIG,##VERIFIED_AGE_DEPT:0)) THEN 1
		ELSE 0
	END AS VerifiedRequired
FROM POS_TAB POS
JOIN PRICE_TAB PRI ON POS.F01 = PRI.F01 AND POS.F1000 = PRI.F1000 AND PRI.F126 = @DBHOT(HOT_MEM,PRICELEVELBASE)
JOIN SDP_TAB SDP ON POS.F04 = SDP.F04 
LEFT OUTER JOIN ALT_TAB ALT ON POS.F01=ALT.F01 
WHERE (POS.F01='@FMT(UPC,@WIZGET(UPC))' or ALT.F154='@WIZGET(UPC)') AND POS.F1000='@DBHOT(INI,SYSTEM.INI,SMS,TARGETBASE)' AND (POS.F86 IS NULL OR POS.F86 = '0'));

/* If item not found continue */
@FMT(CMP,'@DBROW(Q1,F01,L)=N/A','®WIZRPL(ENTRY=®WIZGET(UPC))®EXEC(FCT=710)®FMT(CHR,27)');

/* Continue if no age restriction */
@FMT(CMP,'@DBROW(Q1,F171,#)=0','®WIZRPL(ENTRY=®WIZGET(UPC))®EXEC(FCT=710)®FMT(CHR,27)');

/* If a verified age is in the transaction skip age verification and enter item */
@FMT(CMP,'@FMT(COMA,AGE_VERIFIED,#,,@DBHOT(SAL_HDR,F1254))=1','®WIZRPL(AGE_REQUIRED=®DBROW(Q1,F171,#))®WIZRPL(ENTRY=®WIZGET(UPC))®EXEC(SQI=KDLOC_AddItem_VerifiedDOB)®FMT(CHR,27)');

/* Continue if there is already a birthdate in the transaction and verified age is not required */
@FMT(CMP,'@FMT(CMP,@DBROW(Q1,F171,#)=,0,1)-@DBROW(Q1,VerifiedRequired,#)-@FMT(CMP,@DBHOT(SAL_HDR,F1520,L)=,0,1)=1-0-1','®WIZRPL(ENTRY=®WIZGET(UPC))®EXEC(FCT=710)®FMT(CHR,27)');

/* Prompt for birthdate if age restriction, but verification is not required  */
@FMT(CMP,'@FMT(CMP,@DBROW(Q1,F171,#)=,0,1)-@DBROW(Q1,VerifiedRequired,#)=1-0','®WIZRPL(ENTRY=®WIZGET(UPC))®EXEC(FCT=710)®FMT(CHR,27)');

/* IF ID SCAN IS EXPIRED AND NOT MANAGER OVERRIDE DISPLAY MESSAGE */
@fmt(CMP,'@fmt(COMA,AGE_VERIFIED,#,,@dbHot(SAL_HDR,F1254))-@fmt(CMP,@dbHot(USERLEVEL)>=@dbHot(INI,SYSTEM.INI,LIMITTLZ,USERLEVEL),1,0)=2-0',"®exec(MSG='!®dbHot(CONFIG,##VERIFIED_AGE_EXP_DL_MESSAGE:EXPIRED_DL_-_MANAGER_OVERRIDE_BIRTHDATE)')®fmt(CHR,27)");

/* If manager override prompt for birthdate else display message */
@FMT(CMP,@FMT(CMP,@DBHOT(USERLEVEL)>=@DBHOT(INI,SYSTEM.INI,LIMITTLZ,USERLEVEL),1,0)=1,'®WIZCLR(ENTRY)®dbHot(HOT_WIZ,RPLT,AGE_REQUIRED,@DBROW(Q1,F171,#))®DBHOT(HOT_WIZ,RPLT,DOB_PLU,®WIZGET(UPC))®WIZRPL(VERIFIED_AGE_REQUIRED=1)®EXEC(FCT=31345)®FMT(CHR,27)',"®EXEC(MSG='!®DBHOT(CONFIG,##VERIFIED_AGE_MESSAGE:SCAN_DL_OR_MANAGER_OVERRIDE_BIRTHDATE)')®FMT(CHR,27)");

