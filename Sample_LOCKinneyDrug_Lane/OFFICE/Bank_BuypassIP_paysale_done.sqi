/* STORE TOKEN */

@fmt(CMP,@wizExist(PayToken)@dbHot(INI,SETUP,PAYMENT,SavePayToken)=11,'®dbExec(UPDATE CLT_TAB SET F1574="®wizGet(PayToken)",F1582="®wizGet(PayFunction)",F1001=1,F902="MANUAL",F253="@DSSF" where F1148="®dbHot(SAL_HDR,F1148)")®exec(SQM=CLT_RSP_MAN)');

/* PROMPT FOR DEPOSIT FOR REGULAR CHECKS */

@WIZCLR(TCHECK);
@FMT(CMP,@WIZGET(CARDTYPE)=K,'®WIZRPL(TCHECK=1)');
@FMT(CMP,@WIZGET(CARDTYPE)=Y,'®WIZRPL(TCHECK=1)');
@FMT(CMP,@WIZGET(PAYFUNCTION)=,'®WIZCLR(TCHECK)');
@FMT(CMP,@WIZGET(PaySubType)<>TCK,'®WIZCLR(TCHECK)');
@FMT(CMP,@WIZGET(PaySubType)=ECA,'®WIZRPL(PAYFUNCTION=138)');
@FMT(CMP,@WIZGET(PayRcode)<>00,'®WIZCLR(TCHECK)');
@FMT(CMP,@dbSelect(SELECT F1063 FROM FCT_TAB WHERE F1063=0@WIZGET(PAYFUNCTION) AND F1081 LIKE '%PaySubType=ECA%')=,'®WIZCLR(TCHECK)');
@WIZRPL(PICKUP=@DBSELECT(SELECT dbo.Sms_tools_comaparambyname(REPLACE(F1081,' ',','),'PICKUP') FROM FCT_TAB WHERE F1063=0@WIZGET(PAYFUNCTION)));
@FMT(CMP,@WIZGET(PICKUP)<>,'®wizAppend(ADDTOF1081=,PUP=®WIZGET(PICKUP))');
@FMT(CMP,@WIZGET(TCHECK)=,'®FMT(CHR,26)');

@EXEC(MSG='#THE CHECK MUST BE KEPT FOR DEPOSIT');
@WIZRPL(TCHECK=@TOOLS(MESSAGEDLG,'THE CHECK MUST BE KEPT FOR DEPOSIT',,OK));
@WIZCLR(TCHECK);
