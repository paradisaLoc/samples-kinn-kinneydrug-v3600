/* THE SCRIPT DOES NOT APPLY TO CUSTOMERS WITH SHOPPER LEVEL 1 */
@FMT(CMP,@dbHot(SAL_HDR,F1152,#)=1,"®FMT(CHR,27)");

/* UPGRADE SHOPPER LEVEL TO PLATINUM IF: 1) E-COUPON EXISTS 2) POINTS HAVE BEEN REDEEMED 3) SHOPPER LEVEL HAS NOT BEEN UPGRADED 4) TRS=SALE */
@FMT(CMP,"@DBSELECT(SELECT COUNT(*) FROM SAL_REG WHERE F1032='@DBHOT(SAL_HDR,F1032,#)' AND F1069=0 AND F2660 LIKE '%PLATINUM_UPGRADE%')>0","®WIZSET(E-COUPON_EXISTS=1)","®WIZSET(E-COUPON_EXISTS=0)");
@FMT(CMP,"@DBHOT(SAL_TTL_FIND,7801,F64,!0:10)>0000000999","®WIZSET(POINTS1_REDEEMED=1)","®WIZSET(POINTS1_REDEEMED=0)");
@FMT(CMP,"@FMT(!0:2,@dbHot(SAL_HDR,F1152,#))<10","®WIZSET(CUST_F1152=1)","®WIZSET(CUST_F1152=0)");
@FMT(CMP,@DBHOT(SAL_HDR,F1068,L)=SALE,"®WIZRPL(PLATINUM_UPGRADE=1)","®WIZRPL(PLATINUM_UPGRADE=0)");
@FMT(CMP,@WIZGET(E-COUPON_EXISTS)@WIZGET(POINTS1_REDEEMED)@WIZGET(CUST_F1152)@WIZGET(PLATINUM_UPGRADE)=1111,"®UPDATE_BATCH(JOB=ADDRPL,TAR=CLT_TAB,KEY=F1148=:F1148,
SRC=SELECT F1148, 1 AS F1001, 'MANUAL' AS F902, '®STORE' AS F1964, '1®dbHot(SAL_HDR,F1152,#)' AS F1152 FROM CLT_TAB WHERE F1148='®dbHot(SAL_HDR,F1148,#)')
®EXEC(SQM=clt_rsp_man)");

/* UPDATE TRANSACTION COUNT USING POINT PROGRAM #8 FOR THRIVE CUSTOMERS ONLY */
@FMT(CMP,"@DBSELECT(SELECT CHARINDEX(',@dbHot(SAL_HDR,F1152,#),',',@DBHOT(INI,KinneyDrug.ini,THRIVE,SHOPLEVEL),'))>0",,"®FMT(CHR,27)");

@FMT(CMP,"@DBHOT(SAL_TTL_FIND,7908,F64,!0:3,=THRIVECNT)>@FMT(!0:3,@dbHot(Config,##THRIVE_TRSCOUNT:30))","®WIZRPL(PAYPOINT8_REDEEM=®RPTTTL(THRIVECNT-1,#))","®WIZRPL(PAYPOINT8_GIVEN=1)");
