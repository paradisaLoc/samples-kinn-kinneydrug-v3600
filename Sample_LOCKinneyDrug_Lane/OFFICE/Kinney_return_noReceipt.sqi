/* ALLOW RETURN ON KINNEY GIFT CARD ONLY WHEN NO MANAGER OVERRIDE */
@DBTABLE(Q1,DECLARE FCT CURSOR FOR 
SELECT F1063 FROM FCT_TAB WHERE F1063 BETWEEN 100 AND 200 AND F1063!=@FMT(#,@DBHOT(INI,KINNEYDRUG.INI,RETURN,AllowedTender))
OPEN FCT 
DECLARE @F1401 VARCHAR(max), 
 @F1063 INTEGER, 
 @LOOP INTEGER 
SET @F1401=''
FETCH NEXT FROM FCT INTO @F1063
SET @LOOP=@@FETCH_STATUS
WHILE @LOOP = 0 
BEGIN
 SET @F1401=@F1401+'HOT_RPLT_REFUND:'+cast(@F1063 as varchar)+'=0&' 
 FETCH NEXT FROM FCT INTO @F1063
 SET @LOOP=@@FETCH_STATUS
END 
CLOSE FCT 
DEALLOCATE FCT
SELECT @F1401 AS F1401);
@EXEC(@DBROW(Q1,F1401,RAW));

/* CALL RETURN FUNCTION */
@EXEC(FCT=650);