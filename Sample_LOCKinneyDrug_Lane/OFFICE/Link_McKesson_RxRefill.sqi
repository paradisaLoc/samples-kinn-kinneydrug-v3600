@WIZSET(RX_LIST=0);
@WIZSET(RX_TABLE=0);
@WIZSET(SKIP_PROMPT=0);
@WIZSET(SKIP_RETURN=0);
@WIZSET(SAVED_FCT=@WIZGET(FUNCTION));

@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_RXDISPLAYED)=,,"®FMT(CHR,27)");

/* MAKE SURE THAT SCANNED Rx EXISTS */
@FMT(CMP,@WIZGET(MCK_ScannedBC)=,"®EXEC(MSG='!Please scan a RX script.')®FMT(CHR,27)");
@WIZSET(RxDOB=@FMT(R4,@WIZGET(MCK_ScannedBC)));
@WIZSET(RxNumber=@FMT(R8,@FMT(L9,@WIZGET(MCK_ScannedBC))));
@WIZSET(RefillNumber=@FMT(R2,@FMT(L11,@WIZGET(MCK_ScannedBC))));
@WIZSET(PartialFillNumber=@FMT(R2,@FMT(L13,@WIZGET(MCK_ScannedBC))));

/* MAKE SURE RX IS NOT ALREADY IN THE TRANSACTION */
@WIZRPL(MCK_ITEM=@WIZGET(MCK_ScannedBC));
@RPTCLR(MCK_LN);
@FMT(CMP,@DBHOT(HOT_MEM,TRSSTEP)=2,"®DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_RXNO=®FMT(TRIMZERO,®FMT(S®DBHOT(INI,Link_McKesson.ini,DECODE,RXNO),®WIZGET(MCK_ITEM)))%' AND F1081 LIKE '%MCK_REFILLNO=®FMT(TRIMZERO,®FMT(S®DBHOT(INI,Link_McKesson.ini,DECODE,REFILLNO),®WIZGET(MCK_ITEM)))%' AND F1069='0',F1101,,=MCK_LN)");
@FMT(CMP,"@RPTTTL(MCK_LN,#:0)=0",,"®EXEC(MSG=!RX_already_in_transaction_on_line_®RPTTTL(MCK_LN,#:0))®FMT(CHR,27)");
@RPTCLR(MCK_LN);

/* DO NOT DISPLAY DOB PROMPT IF REFUND KEY PRESSED */
@FMT(CMP,@dbHot(HOT_MEM,CLTRETURNKEY)>0,'®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,5)');

/* DO NOT DISPLAY DOB PROMPT IF IN REFUND MODE */
@FMT(CMP,@dbHot(HOT_MEM,CLTRETURNMODE)>0,'®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,5)');

/* CHECK IF PINPAD PROMPT REQUIRED */
@FMT(CMP,@WIZGET(PINPAD_PROMPT_DOB)=1,"®EXEC(SQI=Link_McKesson_RXRefillPrompt_Pinpad.sqi)");
@FMT(CMP,@WIZGET(PINPAD_PROMPT_DOB)=1,"®DBHOT(HOT_WIZ,RPLT,MCK_FORM_DOB,®WIZGET(MCK_FORM_DOB_PP))®EXEC(MSG=_)®EXEC(MSG=[PADDSP]Thank_You)");

/* IF PINPAD PROMPT, MAKE SURE DOB MATCHES. IF NOTHING ENTERED IN PINPAD, CALL PROMPT SCREEN AGAIN, OTHERWISE PROMPT FOR OVERRIDE */
@FMT(CMP,@WIZGET(PINPAD_PROMPT_DOB)-@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_FORM_DOB)=@WIZGET(RxDOB),1,0)=1-1,"®WIZRPL(SKIP_PROMPT=1)");
@FMT(CMP,@WIZGET(PINPAD_PROMPT_DOB)-@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_FORM_DOB)=@WIZGET(RxDOB),1,0)-@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_FORM_DOB)=,0,1)=1-0-1,"®WIZRPL(SKIP_FIRST_PROMPT=1)");

/* CHECK FOR OVERRIDE */
@WIZSET(OVERRIDE_MSG=Operator number?);
@FMT(CMP,@DBHOT(HOT_MEM,LASTMSG)@DBHOT(HOT_WIZ,GET,MCK_OVERRIDE)=@WIZGET(OVERRIDE_MSG)3,"®DBHOT(HOT_WIZ,RPLT,MCK_FORM_DOB,®WIZGET(RxDOB))®WIZRPL(DEL_OVERRIDE_F1126=®WIZGET(LIVEENTRY))®WIZRPL(LIVEENTRY=)®WIZRPL(ENTRY=)");
@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OVERRIDE)>2,"®WIZRPL(SKIP_PROMPT=1)");
@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OVERRIDE)=5,"®WIZRPL(SKIP_RETURN=1)","®DBHOT(HOT_WIZ,CLR,MCK_OVERRIDE)");
@EXEC(MSG=_);

/* MAKE SURE DELIVERY OVERRIDE NUMBER MATCHES CASHIER THAT IS LOGGED IN */
/* @FMT(CMP,@FMT(CMP,@WIZGET(DEL_OVERRIDE_F1126)=,0,1)@FMT(CMP,@WIZGET(DEL_OVERRIDE_F1126)=@USER,0,1)=11,"®EXEC(MSG='!Operator number does not match')®FMT(CHR,27)");  */

/* CHECK IF PATIENT ID EXISTS */
@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_RxPatientID)=,"®DBHOT(HOT_WIZ,RPLT,MCK_RxPatientLup,1)","®WIZRPL(RX_LIST=1)®DBHOT(HOT_WIZ,CLR,MCK_RxPatientLup)");

/* CHECK IF SCRIPT IS IN PATIENT RX LIST */
@FMT(CMP,@DBHOT(FINDTABLE,TMP_MCKRX@MACSHORT(STORE)@MACSHORT(TER)S@DBHOT(CNCURRENT)_Rx)=,,"®WIZRPL(RX_TABLE=1)");
@FMT(CMP,@WIZGET(RX_LIST)@WIZGET(RX_TABLE)=11,"®WIZRPL(F1401_RX=®DBSELECT(SELECT F1401 FROM TMP_MCKRX®MACSHORT(STORE)®MACSHORT(TER)S®DBHOT(CNCURRENT)_Rx WHERE F1401='®FMT(TRIMZERO,@WIZGET(RxNumber))' AND F1431='@WIZGET(RefillNumber)'))");
@FMT(CMP,@WIZGET(RX_LIST)@WIZGET(F1401_RX)=1,"®WIZRPL(RX_LIST=0)®DBHOT(HOT_WIZ,RPLT,MCK_RxPatientLup,1)®DBHOT(HOT_WIZ,CLR,MCK_RxPatientID)");

/* CHECK IF FORM DOB MATCHES SCANNED DOB.  IF OVERRIDE WAS SELECTED, COMPARES SAVED DOB WITH CURRENTLY SCANNED DOB */
@FMT(CMP,@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_FORM_DOB)=@WIZGET(RxDOB),1,0)@WIZGET(SKIP_RETURN)=00,"®WIZRPL(RX_LIST=0)®WIZRPL(SKIP_PROMPT=0)®DBHOT(HOT_WIZ,RPLT,MCK_RxPatientLup,1)®DBHOT(HOT_WIZ,CLR,MCK_RxPatientID)®DBHOT(HOT_WIZ,CLR,MCK_FORM_DOB)");

/* IF SCRIPT IS IN RX LIST AND DOB MATCHES, SELL SCRIPT AND DISPLAY RX LIST */
@FMT(CMP,@WIZGET(RX_LIST)=1,"®EXEC(SQI=Link_McKesson_trs_pos_scan)®DBHOT(HOT_WIZ,RPLT,MCK_RXDISPLAYED,1)®WIZRPL(FORM=BUTTON)®EXEC(LstPage=Link_McKesson_RxRefillRsp,HTT=Link_McKesson_RxRefill_scr_look_frame)®FMT(CHR,27)");

/* PROMPT FOR DOB (UNLESS OVERRIDE WAS SELECTED) */
@FMT(CMP,@WIZGET(SKIP_PROMPT)=1,,"®EXEC(SQI=Link_McKesson_RxRefillPrompt)");
@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OVERRIDE)=0,"®DBHOT(HOT_WIZ,CLR,MCK_OVERRIDE)®WIZRPL(ENTRY=®WIZGET(MCK_ScannedBC))®EXEC(FCT=®WIZGET(SAVED_FCT))®FMT(CHR,27)");
@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OVERRIDE)=2,"®DBHOT(HOT_WIZ,CLR,MCK_OVERRIDE)®FMT(CHR,27)");
@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OVERRIDE)=3,"®EXEC(MSG='?@WIZGET(OVERRIDE_MSG)')®FMT(CHR,27)");

/* SAVE PARAMETERS */
@DBHOT(HOT_WIZ,PARAMTOLINE,MC_SELLRX);

/* SELL SCRIPT */
@EXEC(SQI=Link_McKesson_trs_pos_scan);

/* IF RETURN, DO NOT GET RX LIST */
@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OVERRIDE)=5,"®DBHOT(HOT_WIZ,CLR,MCK_OVERRIDE)®FMT(CHR,27)");

@DBHOT(HOT_WIZ,RPLT,MCK_RXDISPLAYED,1);

/* RESTORE PARAMETERS */
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,MC_SELLRX);
@DBHOT(HOT_WIZ,CLR,MC_SELLRX);

/* IF WEBSERVICE ID OFFLINE, QUIT */
@FMT(CMP,@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OFFLINE)=1,1,0)=1,"®DBHOT(HOT_WIZ,CLR,MCK_RXDISPLAYED)®FMT(CHR,27)");

/* REQUEST RX LIST */

/* Set Export FileName */
@WIZRPL(SOAPREQUEST=@OFFICEDBT\MK@TER@DBHOT(CNCURRENT)_RxRefillReq.XML);
@WIZRPL(SOAPRESPONSE=@OFFICEDBT\MK@TER@DBHOT(CNCURRENT)_RxRefillRsp.XML);
@WIZRPL(SRC_PATH=@OFFICEDBT\MK@TER@DBHOT(CNCURRENT)_RxRefill*.XML);
@EXEC(XCH=DEL);

/* Build Soap Message */
@WIZSET(OUTPUT=@WIZGET(SOAPREQUEST));
@EXEC(CGI=Link_McKesson_RxRefillReq.xml);

@EXEC(MSG=~ONLINE_VERIFICATION_WAITING);

/* Send Request */
@WIZRPL(HttpUrl=@DBHOT(INI,LINK_MCKESSON.INI,GENERAL,URLRXREFILL));
@WIZRPL(HttpTimeout=@DBHOT(INI,LINK_MCKESSON.INI,GENERAL,URLTIMEOUT));
@WIZRPL(HttpContent=text/xml;);
@WIZRPL(HttpPost=@WIZGET(SOAPREQUEST));
@WIZRPL(HttpOutput=@WIZGET(SOAPRESPONSE));
@EXEC(XCH=HTTP);

@EXEC(MSG=_);

/* VALIDATE RESPONSE CONTENT */
@WIZCLR(DIR);
@WIZRPL(FILE=@WIZGET(SOAPRESPONSE));
@FMT(CMP,@msgFILE(FINDINFILE,xml)=,"®WIZSET(HTTPERROR=COMMUNICATION ERROR)");

/* LOG HTTP COMMUNICATION */
@WIZRPL(LogHTTPFile=RxRefill);
@EXEC(SQI=Link_McKesson_LogHTTP);

/* QUIT ON HTTP ERROR */
@FMT(CMP,@WIZEXIST(HTTPERROR)=1,"®DBHOT(HOT_WIZ,CLR,MCK_RXDISPLAYED)®DBHOT(HOT_WIZ,RPLT,MCK_OFFLINE,1)®EXEC(MSG='!®WIZGET(HTTPERROR)')®FMT(CHR,27)");

/* load Data/Error from XML file */
@WIZRPL(OLD_FORM=@WIZGET(FORM));
@FMT(CMP,@WIZEXIST(HTTPERROR)=0,'®WIZRPL(FORM=BUTTON)®EXEC(LstPage=Link_McKesson_RxRefillRsp,HTT=Link_McKesson_RxRefill_scr_look_frame)');
@WIZRPL(FORM=@WIZGET(OLD_FORM));
