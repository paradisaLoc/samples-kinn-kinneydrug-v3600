/* SHOW FORM */
@WIZRPL(STATE=MODAL);
@WIZRPL(FORM=CHECK);
@WIZRPL(TITLE=Bank Entry Form);
@wizRpl(OPTIONS=BS1BI0);
@WIZCLR(FRAME);

@FMT(CMP,@WIZGET(CARDTYPE)<>,'®WIZRPL(HTT=Bank_BuypassIP_PARSE_CHK)');
@FMT(CMP,@WIZGET(PAYCHECKACCOUNT)=,'®WIZRPL(HTT=Bank_BuypassIP_PARSE_CHK)');
@EXEC(); 

@WIZCLR(FORM);
@WIZCLR(STATE);
@WIZCLR(TITLE);
@WIZCLR(OPTIONS);
@WIZRPL(BEHAVIOR=);

/* CANCEL WAS PRESSED */
@FMT(CMP,@WIZGET(CLOSE)=Cancel,'®EXEC(FCT=30)®FMT(CHR,27)');

/* CHECK DECODING MUST WORK */
@FMT(CMP,@WIZGET(PAYCHECKACCOUNT)=,"®WIZCLR(ENTRYNUMBER)®EXEC(MSG='!Check decoding error')®FMT(CHR,27)");

/* BUILD CHECK REFERENCES */
@WIZRPL(PAYTRACK=@WIZGET(ENTRYNUMBER));
@WIZRPL(ENTRYNUMBER=@WIZGET(PAYCHECKROUTING)-@WIZGET(PAYCHECKACCOUNT));
@WIZRPL(SAL_REG[F1079]=@WIZGET(PAYCHECKSERIAL));

/* BUILD A MICR LINE IF CHECK ENTERED MANUALLY */
@FMT(CMP,@WIZGET(PAYTRACK)=,'®WIZRPL(PAYTRACK=®WIZGET(PAYCHECKROUTING)®WIZGET(PAYCHECKACCOUNT)®WIZGET(PayCheckSerial))');

@WIZCLR(PICKUP);

/* QUIT IF NO CUSTOMER IN THE TRANSACTION */
@FMT(CMP,@DBHOT(SAL_HDR,F1148,L)=,'®FMT(CHR,26)');

/* QUIT IF HOME ACCOUNT */
@FMT(CMP,@DBHOT(SAL_HDR,F1148,L)=49999999999,'®FMT(CHR,26)');

/* QUIT WITH NO ERROR IF DRIVER ID DATA IS IDENTICAL TO THE DATABASE */
@FMT(CMP,@WIZGET(PAYCHECKID)@WIZGET(PAYCHECKSTATECODE)=@WIZGET(DB_PAYCHECKID)@WIZGET(DB_PAYCHECKSTATECODE),'®FMT(CHR,26)');

/* ADD NEW DRIVER LICENCE TO DATABASE AND DEPLOY TO SERVER */
@UPDATE_BATCH(JOB=ADDRPL,TAR=CLL_TAB,
KEY=F1577=:F1577 AND F1578=:F1578,
SRC=SELECT '@WIZGET(PAYCHECKID)|@WIZGET(PAYCHECKSTATECODE)' AS F1577,'DL' AS F1578, '@DBHOT(SAL_HDR,F1148,L)' AS F1148, 'PAL' AS F1000, 1 AS F1001, 'MANUAL' AS F902,'@STORE' AS F1964, GETDATE() AS F253);
@EXEC(SQM=cll_rsp_man);

/* DELETE OLD DRIVER LICENCE IF IT EXISTED */
@FMT(CMP,@WIZGET(DB_PAYCHECKID)=,'®FMT(CHR,26)');
@UPDATE_BATCH(JOB=REMOVE,TAR=CLL_TAB,
KEY=F1577=:F1577 AND F1578=:F1578,
SRC=SELECT CASE WHEN '@WIZGET(DB_PAYCHECKSTATECODE)'<>'' THEN '@WIZGET(DB_PAYCHECKID)|@WIZGET(DB_PAYCHECKSTATECODE)' ELSE '@WIZGET(DB_PAYCHECKID)' END AS F1577,'DL' AS F1578, '@DBHOT(SAL_HDR,F1148,L)' AS F1148, 'PAL' AS F1000, 1 AS F1001, 'MANUAL' AS F902,'@STORE' AS F1964, GETDATE() AS F253);

@EXEC(SQM=cll_rsp_del);
