@WIZCLR(FORM_CLICKED);
@WIZCLR(PINPAD_PROMPT_DOB);

/* PROMPT POPUP FOR DOB */
@WIZRPL(FRAME=);
@WIZRPL(HEIGHT=175);
@WIZRPL(WIDTH=565);
@WIZRPL(FORM=RxRefill);
@WIZRPL(STYLE=HTM);
@WIZRPL(STATE=MODAL);
@WIZRPL(OPTIONS=BS1BI0);
@WIZRPL(TITLE=McKesson RxRefill DOB);
@FMT(CMP,@WIZGET(SKIP_FIRST_PROMPT)=1,"®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,1)","®EXEC(HTT=Link_McKesson_RxRefill_Prompt)");

/* IF DOB ENTERED ON FORM, COMPARE FORM DOB WITH BARCODE DOB. */
@FMT(CMP,@WIZGET(FORM_CLICKED)@WIZGET(FORM_DOB)=DOB@WIZGET(RxDOB),"®DBHOT(HOT_WIZ,RPLT,MCK_FORM_DOB,®WIZGET(FORM_DOB))","®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,1)");

/* IF PROMPT ON PINPAD BUTTON PRESSED, CALL PINPAD AND THEN EXIT SCRIPT */
@FMT(CMP,@WIZGET(FORM_CLICKED)=PINPAD_PROMPT,"®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,0)®WIZRPL(PINPAD_PROMPT_DOB=1)");

/* IF CANCEL BUTTON PRESSED, EXIT SCRIPT */
@FMT(CMP,@WIZGET(FORM_CLICKED)=CANCEL,"®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,2)");

/* IF OVERRIDE SELECTED, MAKE SURE NOT TO SHOW PROMPT AGAIN */
@FMT(CMP,@WIZGET(FORM_CLICKED)=DEL_OVERRIDE,"®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,3)");
@FMT(CMP,@WIZGET(FORM_CLICKED)=MGR_OVERRIDE,"®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,4)®DBHOT(HOT_WIZ,RPLT,MCK_FORM_DOB,®WIZGET(RxDOB))");

/* IF DOB DOES NOT MATCH, PROMPT FOR OVERRIDE */
@FMT(CMP,@DBHOT(HOT_WIZ,GET,MCK_OVERRIDE)=1,"®WIZRPL(HEIGHT=140)®WIZRPL(WIDTH=400)®WIZRPL(TITLE=McKesson RxRefill)®EXEC(HTT=Link_McKesson_RxRefill_Prompt)®DBHOT(HOT_WIZ,CLR,MCK_OVERRIDE)");

/* CLEAR POPUP VARIABLES */
@WIZCLR(HEIGHT);
@WIZCLR(WIDTH);
@WIZCLR(FORM);
@WIZCLR(STYLE);
@WIZCLR(STATE);
@WIZCLR(OPTIONS);
@WIZCLR(TITLE);

/* IF CANCEL BUTTON PRESSED, EXIT SCRIPT */
@FMT(CMP,@WIZGET(FORM_CLICKED)=CANCEL,"®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,2)");

/* IF DELIVERY OVERRIDE WAS SELECTED, PROMPT FOR OPERATOR NUMBER */
@FMT(CMP,@WIZGET(FORM_CLICKED)=DEL_OVERRIDE,"®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,3)");

/* IF MANAGER OVERRIDE WAS SELECTED, SAVE OPERATOR NUMBER */
@FMT(CMP,@WIZGET(FORM_CLICKED)=MGR_OVERRIDE,"®DBHOT(HOT_WIZ,RPLT,MCK_OVERRIDE,4)®DBHOT(HOT_WIZ,RPLT,MCK_FORM_DOB,®WIZGET(RxDOB))®WIZRPL(MGR_OVERRIDE_F1126=@USER)");
