/*InComm Reload Gift Card*/
@TOOLS(AUTO_START);
@fmt(CMP,@wizExist(MESSAGE)=1,'®fmt(CHR,27)');
@WIZRpl(PayTranCode=200);
@FMT(CMP,@WIZEXIST(PAYTRACK)@dbHot(HOT_MEM,TRSPROMPT)=00,"®EXEC(MSG='~Waiting for card swipe')®EXEC(XCH=MSRSWIPE)");
@FMT(CMP,@WIZGET(MSRSWIPE)=0,"®EXEC(MSG='!Swipe error')®FMT(CHR,27)");
@WizRpl(FCT_LIKE=565);
@WIZRpl(CardType=T);
@WizRpl(PaySubType=INC);
@WizRpl(PayFunction=123);
@WIZRPL(ENTRY_ITEMCODE=@dbSelect(SELECT TOP 1 F154 FROM ALT_TAB WHERE F01='@DBHOT(POS_TAB,F01)' ORDER BY ISNULL(F1898,'0') DESC));
@FMT(CMP,@WIZGET(ENTRY_ITEMCODE)=,"®WIZRPL(ENTRY_ITEMCODE=®DBHOT(POS_TAB,F01))");
@WIZRPL(ENTRY_ITEMNAME=@DBHOT(POS_TAB,F02));
@WizRpl(SCANSIGN=0);
