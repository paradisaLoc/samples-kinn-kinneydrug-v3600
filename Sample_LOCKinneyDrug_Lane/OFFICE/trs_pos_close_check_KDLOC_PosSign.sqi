/* QUIT IF ERROR MESSAGE */
@FMT(CMP,@WIZEXIST(MESSAGE)=1,'®FMT(CHR,27)');

/* Kinney drug drive-thu one time signature capture process */
@FMT(CMP,@DBHOT(HOT_WIZ,GET,DRIVETHRU)<>1,'®FMT(CHR,26)');

/* No Drive-thru for debit card */
@FMT(CMP,@WIZGET(PAYFUNCTION)=103,"®EXEC(MSG='!DEBIT CARD NOT ALLOWED IN DRIVE-THU TRANSACTION')®FMT(CHR,27)");

/* Quit if signature is already captured */
@FMT(CMP,@DBHOT(HOT_WIZ,GET,KD.SIGNDONE)=1,'®FMT(CHR,26)');

/* Save parameters */
@DBHOT(HOT_WIZ,PARAMTOLINE,PARAMSAV_KDCLOSE);

/* Check if transaction requires signature or prompts for McKesson */
@WIZSET(KD.SignMcKesson=0);
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNHIPAA=1%' AND F1069<>1,F64,#)>0,®WIZRPL(KD.SIGNHIPAA=1)®WIZRPL(KD.SignMcKesson=1),®WIZRPL(KD.SIGNHIPAA=0));
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNRXACK=1%' AND F1069<>1,F64,#)>0,®WIZRPL(KD.SIGNRXACK=1)®WIZRPL(KD.SignMcKesson=1),®WIZRPL(KD.SIGNRXACK=0));
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNEASYCAP=1%' AND F1069<>1,F64,#)>0,®WIZRPL(KD.SIGNEASYCAP=1),®WIZRPL(KD.SIGNEASYCAP=0));
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_COUNSELING=1%' AND F1069<>1,F64,#)>0,®WIZRPL(KD.COUNSELING=1),®WIZRPL(KD.COUNSELING=0));
@FMT(CMP,@DBHOT(SAL_HDR,F1068)=SALE,,"®WIZRPL(KD.SignMcKesson=0)®WIZRPL(KD.SIGNHIPAA=0)®WIZRPL(KD.SIGNRXACK=0)®WIZRPL(KD.SIGNEASYCAP=0)®WIZRPL(KD.COUNSELING=0)");

/* Check if transaction requires signature for Methcheck */
@FMT(CMP,@DBHOT(SAL_HDR,F1068)@FMT(CMP,@DBHOT(SAL_REG_FIND,F1785 LIKE '%METHCHECK%' AND F1069<>1 AND F1070=0,F1101,#)>0,1,0)=SALE1,®WIZRPL(KD.SignMethcheck=1),®WIZRPL(KD.SignMethcheck=0));

/* Check if transaction requires signature for Credit card */
@FMT(CMP,@WIZEXIST(CARDTYPE)@WIZGET(ScanSign)=11,®WIZRPL(KD.SIGNCREDIT=1),®WIZRPL(KD.SIGNCREDIT=0));

/* Print stub to let the customer answer and sign */
@FMT(CMP,@WIZGET(KD.SignMcKesson)@WIZGET(KD.SIGNHIPAA)@WIZGET(KD.SIGNRXACK)@WIZGET(KD.SIGNEASYCAP)@WIZGET(KD.COUNSELING)@WIZGET(KD.SignMethcheck)@WIZGET(KD.SIGNCREDIT)=0000000,,'®WIZRPL(OUTPUT=DBT\SIGN_STUB@STORE@TER@DBHOT(CNCURRENT).TXT)®EXEC(CGI=KDLOC_TRS_POS_SIGN_STUB)');
@FMT(CMP,@DBHOT(FINDFIRST,@WIZGET(OUTPUT))=,,'®WIZRPL(KD.STUB=@WIZGET(OUTPUT))®dbhot(SAL_TTL)®WIZRPL(OUTPUT=RECEIPT)®EXEC(CGP=TRS_POS_RCT_GROSS)');
@WIZCLR(KD.STUB);
@WIZCLR(OUTPUT);

/* Scan signature */
@FMT(CMP,@WIZGET(KD.SignMcKesson)@WIZGET(KD.SignMethcheck)@WIZGET(KD.SIGNCREDIT)=000,®WIZRPL(KD.SIGNNEEDED=0),®WIZRPL(KD.SIGNNEEDED=1));
@FMT(CMP,@WIZGET(KD.SIGNNEEDED)=1,®EXEC(SQI=KDLOC_TRS_POS_SCAN_SIGN));

/* Error is signature is requested but not present */
@FMT(CMP,@DBHOT(FINDFIRST,DBT\SIG_@STORE@TER_@dbHot(SAL_HDR,F1032,!0:6).BMP)=,®WIZRPL(KD.SIGNCAP=0),®WIZRPL(KD.SIGNCAP=1));
@FMT(CMP,@WIZGET(KD.SIGNCAP)@WIZGET(KD.SIGNNEEDED)=01,"®EXEC(MSG='!Signature is mandatory')®FMT(CHR,27)");

/* Set paramater to avoid running this process again if signature is already captured */
@FMT(CMP,@WIZGET(KD.SIGNCAP)@WIZGET(KD.SIGNNEEDED)=11,"®DBHOT(HOT_WIZ,RPLT,KD.SIGNDONE,1)");

/* Restore parameters */
@WIZRESET;
@DBHOT(HOT_WIZ,LINETOPARAM,PARAMSAV_KDCLOSE);
@DBHOT(HOT_WIZ,CLR,PARAMSAV_KDCLOSE);
