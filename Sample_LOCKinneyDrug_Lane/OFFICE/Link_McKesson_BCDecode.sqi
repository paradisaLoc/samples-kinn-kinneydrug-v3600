/* EXECUTE A FUNCTION OR SCRIPT DEPENDING ON THE LENGTH OF THE BARCODE */

/* InComm Activation*/
@FMT(CMP,@FMT(LEN,@WIZGET(LIVEENTRY))=30,"®EXEC(FCT=8981)®FMT(CHR,27)");

/* Item Scan */
@FMT(CMP,@FMT(LEN,@WIZGET(LIVEENTRY))=31,"®EXEC(SQI=Link_McKesson_trs_pos_scan)®FMT(CHR,27)");

/* New patient Lookup (RxRefill) */
@FMT(CMP,@FMT(LEN,@WIZGET(LIVEENTRY))=35,"®WIZSET(MCK_ScannedBC=®WIZGET(LIVEENTRY))®EXEC(FCT=29999)®FMT(CHR,27)");
 
/* IF BARCODE INCORRECT LENGTH SHOW MESSAGE */
@EXEC(MSG='!Barcode incorrect length.');

