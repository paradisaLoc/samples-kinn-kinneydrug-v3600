/* PROMPT TO USE EXPIRED ID */
@fmt(CMP,'@fmt(COMA,AGE_VERIFIED,#,,@dbHot(SAL_HDR,F1254))-@wizExist(UseExpiredId)=2-0','®wizRpl(UseExpiredID=®tools(MESSAGEDLG,®dbHot(CONFIG,##VERIFIED_AGE_USE_EXP_DL_MESSAGE:EXPIRED DL - STILl ACCEPT DL),0,YES,NO))');
@fmt(CMP,@wizGet(UseExpiredId)=1,'®wizRpl(ENTRY=@date(@fmt(COMA,DATE_VERIFIED,,,@dbHot(SAL_HDR,F1254)),DPDF))');

/* PROMPT FOR CUSTOMER BIRTH DATE */
@FMT(CMP,@WIZGET(PROMPTMEM)=1,"®WIZRPL(ENTRY=®WIZGET(LIVEENTRY))®WIZCLR(PROMPTMEM)");
@FMT(CMP,@WIZGET(ENTRY)=,"®WIZRPL(PROMPTMEM=1)®EXEC(MSG='Enter customer birthday (MMDDYYYY)?')®FMT(CHR,27)");

/* CHECK IF MANAGER OVERRIDE REQUIRED */
@FMT(CMP,@WIZGET(VERIFIED_AGE_REQUIRED)-@FMT(CMP,@DBHOT(USERLEVEL)>=@DBHOT(INI,SYSTEM.INI,LIMITTLZ,USERLEVEL),1,0)=1-0,"®EXEC(MSG='!Please login with the right access level')®FMT(CHR,27)");

/* CONVERT ENTRY INTO SQL DATE FORMAT */
@WIZRPL(ENTRY_DATE=@FMT(DPDF,@WIZGET(ENTRY)));

/* CHECK TO SEE IF YEAR ENTERED IS TOO OLD */
@FMT(CMP,@RPTTTL(@DYDF-@DATE(@WIZGET(ENTRY_DATE),DYDF),!0:5:0)>@FMT(!0:5:0,@DBHOT(CONFIG,##VERIFIED_AGE_MAX:110)),"®EXEC(MSG='!DATE TOO OLD')®DBHOT(HOT_WIZ,CLR,DOB_PLU)®FMT(CHR,27)");

/* VALIDATE CUSTOMERS AGE IS VALID FOR ITEM */
@fmt(CMP,@DBSELECT(SELECT dbo.KDLOC_VALIDATE_AGE('@wizGet(ENTRY_DATE)', @dbHot(HOT_WIZ,GET,AGE_REQUIRED)))=0,"®dbHot(HOT_WIZ,CLR,AGE_REQUIRED)®EXEC(MSG='!Insufficient customer age ®date(®wizGet(ENTRY_DATE),DPDF)')®fmt(CHR,27)",'®dbHot(HOT_WIZ,CLR,AGE_REQUIRED)');

/* ADD BIRTHDATE TO TRANSACTION AS VERIFIED */
@fmt(CMP,@wizGet(VERIFIED_AGE_REQUIRED)=1,'®wizRpl(ADDRPLTOF1254=AGE_VERIFIED=1,DATE_VERIFIED=®wizGet(ENTRY_DATE))®wizRpl(SAL_HDR[F1520]=®date(®wizGet(ENTRY_DATE),DWDF))');
@wizRpl(ADDTOF1081=@fmt(CMP,@wizExist(ADDTOF1081)=1,'®wizGet(ADDTOF1081),')CLTAGE=@date(@wizGet(ENTRY_DATE),DPDF));

/* ADD ITEM TO TRANSACTION IF PROMPTED FROM ITEM ENTRY */
@FMT(CMP,@DBHOT(HOT_WIZ,GET,DOB_PLU)=,'®WIZRPL(ENTRY=®DATE(@WIZGET(ENTRY_DATE),DPDF))®EXEC(FCT=695)','®WIZRPL(ENTRY=®DBHOT(HOT_WIZ,GET,DOB_PLU))®DBHOT(HOT_WIZ,CLR,DOB_PLU)®EXEC(FCT=710)');
@FMT(CMP,@FMT(POS,?,@DBHOT(HOT_MEM,LASTMSG))=0,,'®POST(ENTRY=®DATE(@WIZGET(ENTRY_DATE),DPDF),FCT=9013,CN=@CNC,TN=@TER)');

/* REMOVE MANAGER OVERRIDE */
@FMT(CMP,@USER<>@DBHOT(CLK,CODE),"®WIZRPL(ENTRY=0)®EXEC(FCT=10011)");
