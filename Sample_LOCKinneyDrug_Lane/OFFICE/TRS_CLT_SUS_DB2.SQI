/* SUSPEND TRANSACTION TO SERVER */
/* F1032 is set by SMS when the document is open */

@WIZSET(HDRSALF1068=SALE);
@WIZSET(HDRSALF1067=OPEN);

@WIZINIT;
@WIZFIL(F1032,,SELECT F1032,F1148 FROM SAL_HDR ORDER BY F1032 DESC);
@WIZFIL(FRM,label=SELECT A TRANSACTION,field=F1032,default=1);
@WIZDISPLAY;

@EXEC(MSG='TRANSFER TO SERVER...');

@FMT(CMP,@WIZGET(HDRSALF1068)=ORDER,'UPDATE SAL_REG SET F1078=F64 WHERE F1032=@WIZGET(F1032) and F1067="ITEM"');

@WIZRPL(N1763=@dbSelect(SELECT F1763 FROM SAL_HDR WHERE F1032=@WIZGET(F1032)));

@WIZRPL(N1068=@dbSelect(SELECT F1068 FROM SAL_HDR WHERE F1032=@WIZGET(F1032)));
@FMT(CMP,@WIZGET(N1068)=TRAIN,®WIZRPL(HDRSALF1068=TRAIN));
@FMT(CMP,@WIZGET(N1068)=REFUND,®WIZRPL(HDRSALF1068=REFUND));
@FMT(CMP,@WIZGET(N1068)=LAYAWA,®WIZRPL(SCANPREFIX=994));

@WIZRPL(REMOTE_DBALIAS=2);
@WIZRPL(N1032=@dbGen(F1032,1));
@FMT(CMP,@WIZGET(N1763)=,'®WIZRPL(N1763=®dbGen(F1763,1))');
@WIZCLR(REMOTE_DBALIAS);

@DBHOT(SAL_HDR,SET,F1763,N1763)
@WIZSET(SCANPREFIX=992);
@WIZSET(SUSPENDED_CODE=@WIZGET(SCANPREFIX)901@FMT(!0:6,@WIZGET(N1032)));

@UPDATE_BATCH(JOB=ADD,TAR=SAL_HDR,TDB=2,
KEY=F1032=:F1032,
SRC=SELECT @WIZGET(N1032) as F1032,'@WIZGET(N1763)' as F1763,'@WIZGET(HDRSALF1068)' as F1068,'@WIZGET(HDRSALF1067)' as F1067,
CASE WHEN NULLIF(F1254,'') IS NULL THEN 'SUSPEND=@WIZGET(SUSPENDED_CODE)' WHEN F1254 LIKE '%SUSPEND=%' THEN F1254 ELSE F1254+',SUSPEND=@WIZGET(SUSPENDED_CODE)' END as F1254,
@dbFld(SAL_HDR,HDR.,F1032;F1763;F1068;F1067;F1254)
FROM SAL_HDR HDR WHERE HDR.F1032=@WIZGET(F1032));

@UPDATE_BATCH(JOB=ADD,TAR=SAL_REG,TDB=2,
KEY=F1032=:F1032 and F1101=:F1101,
SRC=SELECT @WIZGET(N1032) as F1032,@dbFld(SAL_REG,REG.,F1032)
FROM SAL_REG REG WHERE REG.F1032=@WIZGET(F1032));

@UPDATE_BATCH(JOB=ADD,TAR=SAL_DET,TDB=2,
KEY=F1032=:F1032 and F1101=:F1101 and F2770=:F2770,
SRC=SELECT @WIZGET(N1032) as F1032,@dbFld(SAL_DET,DET.,F1032)
FROM SAL_DET DET WHERE DET.F1032=@WIZGET(F1032));

@UPDATE_BATCH(JOB=ADD,TAR=SAL_TTL,TDB=2,
KEY=F1032=:F1032 and F1034=:F1034,
SRC=SELECT @WIZGET(N1032) as F1032,@dbFld(SAL_TTL,TTL.,F1032)
FROM SAL_TTL TTL WHERE TTL.F1032=@WIZGET(F1032));

@EXEC(MSG='TRANSFER COMPLETED');

