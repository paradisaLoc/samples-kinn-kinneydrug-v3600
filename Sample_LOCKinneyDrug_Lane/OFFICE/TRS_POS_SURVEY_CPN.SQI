/* PROMPT FOR VALIDATION CODE */
@FMT(CMP,@WIZGET(PROMPTMEM)=1,®WIZRPL(VALIDATION=@WIZGET(LIVEENTRY))®WIZCLR(PROMPTMEM));
@FMT(CMP,@WIZGET(VALIDATION)=,"®WIZRPL(PROMPTMEM=1)®EXEC(MSG='Please enter validation code?')®FMT(CHR,27)");

/* DEFAULT IS ACCEPTED */
@WIZSET(CPN_OK=1)

/* VALIDATE IF 4 DIGITS */
@FMT(CMP,@FMT(LEN,@WIZGET(VALIDATION))=4,,®WIZRPL(CPN_OK=0));

/* VALIDATION RULE SUM OF SECOND AND THIRD DIGIT EQUALS 9 */
@FMT(CMP,@RPTTTL(@FMT(S2:1,@WIZGET(VALIDATION))+@FMT(S3:1,@WIZGET(VALIDATION)),#)=9,,®WIZRPL(CPN_OK=0));

/* OVERRIDE VALIDATION IF CODE IS 0000 */
@FMT(CMP,@WIZGET(VALIDATION)=0000,®WIZRPL(CPN_OK=1));

/* IF VALIDATION IS CORRECT CONTINUE, ELSE SHOW ERROR MESSAGE */
@FMT(CMP,@WIZGET(CPN_OK)=1,,"®EXEC(MSG=!Invalid_code)®FMT(CHR,27)");

/* SAVE VALIDATION CODE IN EJ FOR LATER USE */
@WIZRPL(ADDTOF1081=@fmt(CMP,@wizExist(ADDTOF1081)=1,'®wizGet(ADDTOF1081),')SKU=Code;@WIZGET(VALIDATION));

