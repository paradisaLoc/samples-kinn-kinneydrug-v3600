/* HIPAASigCapture */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNHIPAA=1%' AND F1069<>1 AND F1070='0',F64,#)>0,"®WIZRPL(HIPAASigCaptureResult=®TOOLS(MESSAGEDLG,'®DBHOT(INI,LINK_MCKESSON.INI,SigCaptureInfo,HIPAASigCapture)',30,YES,NO))®WIZRPL(HIPAASIG=1)","®WIZRPL(HIPAASIG=0)");
@FMT(CMP,@WIZGET(HIPAASigCaptureResult)=2,"®DBEXEC(UPDATE SAL_REG SET F1081=REPLACE(F1081,'MCK_SIGNHIPAA=1','MCK_SIGNHIPAA=0') WHERE F1032=@DBHOT(SAL_HDR,F1032,#))");

/* RxAckSigCapture */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNRXACK=1%' AND F1069<>1 AND F1070='0',F64,#)>0,"®WIZRPL(RxAckSigCaptureResult=®TOOLS(MESSAGEDLG,'®DBHOT(INI,LINK_MCKESSON.INI,SigCaptureInfo,RxAckSigCapture)',30,YES,NO))®WIZRPL(RXACKSIG=1)","®WIZRPL(RXACKSIG=0)");
@FMT(CMP,@WIZGET(RxAckSigCaptureResult)=2,"®EXEC(MSG=!Signature_is_mandatory)®FMT(CHR,27)");

/* EasyCapSigCapture */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_SIGNEASYCAP=1%' AND F1069<>1 AND F1070='0',F64,#)>0,"®WIZRPL(EasyCapSigCaptureResult=®TOOLS(MESSAGEDLG,'®DBHOT(INI,LINK_MCKESSON.INI,SigCaptureInfo,EasyCapSigCapture)',30,YES,NO))®WIZRPL(EZCAPSIG=1)","®WIZRPL(EZCAPSIG=0)");
@FMT(CMP,@WIZGET(EasyCapSigCaptureResult)=2,"®DBEXEC(UPDATE SAL_REG SET F1081=REPLACE(F1081,'MCK_SIGNEASYCAP=1','MCK_SIGNEASYCAP=0') WHERE F1032=@DBHOT(SAL_HDR,F1032,#))®WIZRPL(EZCAPSIG=0)");

/* CounselingAccepted */
@FMT(CMP,@DBHOT(SAL_REG_FIND,F1081 LIKE '%MCK_COUNSELING=1%' AND F1069<>1 AND F1070='0',F64,#)>0,"®WIZRPL(CounselingAcceptedResult=®TOOLS(MESSAGEDLG,'®DBHOT(INI,LINK_MCKESSON.INI,SigCaptureInfo,CounselingAccepted)',30,YES,NO))");
@FMT(CMP,@WIZGET(CounselingAcceptedResult)=2,"®DBEXEC(UPDATE SAL_REG SET F1081=REPLACE(F1081,'MCK_COUNSELING=1','MCK_COUNSELING=0') WHERE F1032=@DBHOT(SAL_HDR,F1032,#))");

/* Signature process */
@WIZRPL(OLD_OUTPUT=@WIZGET(OUTPUT));
@WIZRPL(OUTPUT=RECEIPT);
@FMT(CMP,@WIZGET(HIPAASIG)@WIZGET(RXACKSIG)=00,,'®WIZRPL(SigMissing=®FMT(CMP,@DBHOT(FINDFIRST,DBT\SIG_@STORE@TER_@dbHot(SAL_HDR,F1032,!0:6).bmp)=,1))');
@FMT(CMP,@WIZGET(SigMissing)=1,'®EXEC(CGP=Link_McKesson_sign_stub)');
@WIZCLR(OUTPUT);
@FMT(CMP,@WIZGET(SigMissing)=1,'®EXEC(SQI=Link_McKesson_xch_sign_POS)');
@FMT(CMP,@WIZGET(SIGN_REJECT)=1,'®WIZRPL(SRC_PATH=DBT\ScanSign_®STORE®TER.bmp)®EXEC(XCH=DEL)');
@FMT(CMP,@WIZGET(SigMissing)=1,'®WIZRPL(SRC_PATH=DBT\ScanSign_®STORE®TER.bmp)®WIZRPL(TAR_PATH=DBT\SIG_®STORE®TER_®dbHot(SAL_HDR,F1032,!0:6).bmp)®EXEC(XCH=COPYFILE)');
@FMT(CMP,@WIZGET(SigMissing)=1,'®WIZRPL(SigMissing=®FMT(CMP,@DBHOT(FINDFIRST,DBT\SIG_@STORE@TER_@dbHot(SAL_HDR,F1032,!0:6).bmp)=,1))');
@WIZCLR(PromptTimeOut);
@WIZRPL(OUTPUT=@WIZGET(OLD_OUTPUT));
@EXEC(MSG=' ');

