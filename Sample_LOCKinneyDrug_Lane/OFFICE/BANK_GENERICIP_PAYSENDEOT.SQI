
@fmt(CMP,@wizGet(PAYSENDEOT)=TENDERS,,'®fmt(CHR,26)');

@WIZRPL(OUTPUT_SAVE=@WIZGET(OUTPUT));
@WIZRPL(OUTPUT=@OFFICEDBT\FLEET@STORE@TER@dbHot(CNCurrent).XML);

@EXEC(CGI=Bank_GenericIP_PaySendEot.xml);
@dbHot(PAYMENT,SETXML,@wizGet(PAYMENT),@wizGet(OUTPUT));

@FMT(CMP,@WIZGET(OUTPUT_SAVE)=,'®WIZCLR(OUTPUT)','®WIZRPL(OUTPUT=@WIZGET(OUTPUT_SAVE))');
@WIZCLR(OUTPUT_SAVE);

/* DO NOT GENERATE RECEIPT ON SECOND PASS */
@WIZCLR(PAYOUTPUT);
